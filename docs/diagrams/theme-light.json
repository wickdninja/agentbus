{
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Inter, 'Helvetica Neue', Helvetica, Arial, sans-serif",
    "fontSize": "18px",
    "background": "#ffffff",
    "primaryColor": "#FFF4CC",
    "primaryBorderColor": "#F5B800",
    "primaryTextColor": "#1f2328",
    "secondaryColor": "#FFFBEA",
    "secondaryBorderColor": "#F5B800",
    "secondaryTextColor": "#1f2328",
    "tertiaryColor": "#ffffff",
    "tertiaryBorderColor": "#d0d7de",
    "tertiaryTextColor": "#1f2328",
    "lineColor": "#1f2328",
    "textColor": "#1f2328",
    "mainBkg": "#FFF4CC",
    "nodeBorder": "#F5B800",
    "clusterBkg": "#FFFBEA",
    "clusterBorder": "#F5B800",
    "edgeLabelBackground": "#ffffff",
    "actorBkg": "#F5B800",
    "actorBorder": "#1f2328",
    "actorTextColor": "#1f2328",
    "actorLineColor": "#c9ced4",
    "signalColor": "#1f2328",
    "signalTextColor": "#1f2328",
    "labelBoxBkgColor": "#FFF4CC",
    "labelBoxBorderColor": "#F5B800",
    "labelTextColor": "#1f2328",
    "loopTextColor": "#1f2328",
    "noteBkgColor": "#FFF4CC",
    "noteBorderColor": "#F5B800",
    "noteTextColor": "#1f2328",
    "activationBkgColor": "#FFF4CC",
    "activationBorderColor": "#F5B800",
    "sequenceNumberColor": "#ffffff",
    "stateBkg": "#FFF4CC",
    "stateLabelColor": "#1f2328",
    "labelColor": "#1f2328",
    "transitionColor": "#1f2328",
    "transitionLabelColor": "#1f2328",
    "specialStateColor": "#1f2328",
    "altBackground": "#FFFBEA",
    "compositeBackground": "#FFFBEA",
    "compositeBorder": "#F5B800"
  },
  "themeCSS": ".node rect, .node polygon, .node path { rx: 12px; ry: 12px; stroke-width: 2px; } rect.actor { rx: 12px; ry: 12px; stroke-width: 2px; } .note { rx: 8px; ry: 8px; } .edgeLabel { font-size: 16px; } .sequenceNumber { font-size: 13px; font-weight: 700; } .flowchart-link { stroke-width: 2px; } path.transition { stroke-width: 2px; } .messageLine0, .messageLine1 { stroke-width: 2px; } .edgeLabel, .edgeLabel p, .edgeLabel span { background-color: #ffffff !important; }",
  "flowchart": {
    "curve": "basis",
    "padding": 18,
    "nodeSpacing": 50,
    "rankSpacing": 60,
    "htmlLabels": true
  },
  "sequence": {
    "diagramMarginX": 30,
    "diagramMarginY": 30,
    "actorMargin": 50,
    "width": 200,
    "height": 56,
    "boxMargin": 12,
    "boxTextMargin": 8,
    "noteMargin": 14,
    "messageMargin": 46,
    "mirrorActors": true,
    "useMaxWidth": false,
    "wrap": false,
    "actorFontSize": 17,
    "messageFontSize": 17,
    "noteFontSize": 16,
    "actorFontWeight": 600
  },
  "state": {
    "padding": 14,
    "nodeSpacing": 60,
    "rankSpacing": 70
  }
}
