def cmd_skill(a):
    """Print the bundled skill (or the AGENTS.md block) exactly as embedded: not wrapped, not
    indented, so the output is byte-equal to skills/agentbus/SKILL.md."""
    text = AGENTS_SNIPPET if a.agents_md else SKILL_TEXT
    if a.json:
        print_json({"text": text})
        return
    write_out(text)


def register_skill(sub):
    s = sub("skill", help="Print the bundled skill (the agent protocol); --agents-md prints the Codex AGENTS.md block")
    s.add_argument("--agents-md", action="store_true", help="Print the block for an AGENTS.md file instead")


