    cl.add_argument("--purpose", metavar="TEXT", help="Why you hold it; shown to anyone who runs into the claim.")
    request_id_arg(cl)
    cl.add_argument("--ttl-min", type=integer, default=120, metavar="MIN", help=f"Claim lifetime in minutes: 1-{MAX_TTL_MIN}; default 120. Claim again to renew.")


