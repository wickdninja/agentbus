SCHEMA = """
CREATE TABLE IF NOT EXISTS agents (
  name TEXT PRIMARY KEY, tool TEXT, model TEXT, cwd TEXT, branch TEXT, role TEXT,
  joined_at TEXT NOT NULL, last_seen TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS messages (
  id INTEGER PRIMARY KEY AUTOINCREMENT, ts TEXT NOT NULL, sender TEXT NOT NULL,
  recipient TEXT NOT NULL DEFAULT '*', kind TEXT NOT NULL DEFAULT 'note',
  topic TEXT, body TEXT NOT NULL, reply_to INTEGER REFERENCES messages(id), request_id TEXT);
CREATE TABLE IF NOT EXISTS cursors (
  agent TEXT PRIMARY KEY, last_read_id INTEGER NOT NULL DEFAULT 0,
  bcast_from INTEGER NOT NULL DEFAULT 0);
CREATE TABLE IF NOT EXISTS context (
  key TEXT PRIMARY KEY, value TEXT NOT NULL, updated_by TEXT NOT NULL, updated_at TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS context_history (
  id INTEGER PRIMARY KEY AUTOINCREMENT, key TEXT NOT NULL, value TEXT, updated_by TEXT NOT NULL,
  updated_at TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS claims (
  resource TEXT PRIMARY KEY, agent TEXT NOT NULL, purpose TEXT,
  claimed_at TEXT NOT NULL, expires_at TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS log (
  id INTEGER PRIMARY KEY AUTOINCREMENT, ts TEXT NOT NULL, agent TEXT NOT NULL,
  action TEXT NOT NULL, detail TEXT);
CREATE INDEX IF NOT EXISTS idx_messages_recipient ON messages(recipient, id);
CREATE UNIQUE INDEX IF NOT EXISTS idx_messages_request ON messages(sender, request_id) WHERE request_id IS NOT NULL;
CREATE INDEX IF NOT EXISTS idx_log_ts ON log(ts);
"""
# The fixed table names whose shapes every open validates.
TABLES = ("agents", "messages", "cursors", "context", "context_history", "claims", "log")
# The bus schema version, kept in PRAGMA user_version (its only store). 1 is exactly the shape SCHEMA
# creates, which is also v0.1.0's shape: a v0.1.0 bus (that shape, user_version 0) is adopted by
# stamping 1, with no other write.
SCHEMA_VERSION = 1
# A user_version above this, or below 0, is not one any release wrote (versions go up by one per
# schema change): it is reported as damage (schema_corrupt), not as a newer agentbus.
MAX_SCHEMA_VERSION = 10000
# The version-1 shape, which every v0.1.0 bus has with user_version 0. While SCHEMA is version 1 this is
# SCHEMA itself; the release that changes SCHEMA keeps today's text here (tests/test_schema.sh compares
# it with v0.1.0's SCHEMA), so a v0.1.0 bus is still recognised and migrated from version 1.
SCHEMA_V1 = SCHEMA
# Shapes found on real buses made before user_version existed (user_version 0), each with the
# statements that bring it to version 1: [{"name", "schema": its CREATE statements as captured,
# "steps": [SQL, ...]}]. Only shapes captured from a real file (tests/fixtures/schema/PROVENANCE.md)
# go here; a bus matches one only when every table's shape equals the captured one.
HISTORY = []
# MIGRATIONS[n]: the statements that take a version-n bus to n + 1, run in order after a backup.
MIGRATIONS = {}
KINDS = ("note", "question", "answer", "handoff", "decision", "alert", "done")
MESSAGE_COLUMNS = "id, ts, sender, recipient, kind, topic, body, reply_to"
_JSON_ERRORS = False


def now():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


# ---------- output safety ----------

# Escaped by property, not by a list of ranges: every control (Cc), format (Cf), surrogate (Cs),
# private-use (Co), unassigned (Cn), line separator (Zl) and paragraph separator (Zp) character,
# plus the Unicode default-ignorable code points those categories miss (combining grapheme joiner,
# Hangul fillers, Khmer inherent vowels, Mongolian and other variation selectors). Any of these can
# hide, reorder or break text on a terminal. U+2800 (Braille blank) is a symbol that renders as
# nothing, like the Hangul fillers, so it is escaped too.
_UNSAFE_CATS = frozenset(("Cc", "Cf", "Cs", "Co", "Cn", "Zl", "Zp"))
_IGNORABLE = ((0x034F, 0x034F), (0x115F, 0x1160), (0x17B4, 0x17B5), (0x180B, 0x180F),
              (0x2800, 0x2800), (0x3164, 0x3164), (0xFE00, 0xFE0F), (0xFFA0, 0xFFA0), (0xE0000, 0xE0FFF))
# A run of more than 8 blank-rendering spaces (U+0020 and the other Zs characters) is shown
# escaped: on a wrapping terminal a long blank run can push the text after it to column 0 of a
# row that looks empty before it, where it would read as a new line (a forged message header).
_BLANK_RUN = re.compile("[\u0020\u00a0\u1680\u2000-\u200a\u202f\u205f\u3000]{9,}")


@lru_cache(maxsize=4096)
def _unsafe(c):
    o = ord(c)
    if 0x20 <= o < 0x7F:
        return False
    return unicodedata.category(c) in _UNSAFE_CATS or any(lo <= o <= hi for lo, hi in _IGNORABLE)


def _esc(c):
    o = ord(c)
    return "\\x%02x" % o if o < 0x100 else "\\u%04x" % o if o < 0x10000 else "\\U%08x" % o


def clean(text, newlines=False, backslash=True):
    """Bus- or file-controlled text made safe for a terminal: controls and invisible format
    characters become visible escapes (ESC -> \\x1b, U+202E -> \\u202e), and so does every
    character of a run of more than 8 blanks, so text cannot drive the reader's terminal or forge a
    line. A literal backslash is shown doubled (\\\\), so text a lane wrote as `\\x23` can never pass
    for one of these escapes; backslash=False only for a repr(), which doubles its own. Only a
    message body passes newlines=True."""
    if text is None:
        return ""
    text = str(text)
    out, at = [], 0
    for m in _BLANK_RUN.finditer(text):
        out.append(_clean_chars(text[at:m.start()], newlines, backslash))
        out.append("".join(_esc(c) for c in m.group()))
        at = m.end()
    out.append(_clean_chars(text[at:], newlines, backslash))
    return "".join(out)


def _clean_chars(text, newlines, backslash=True):
    return "".join("\\\\" if c == "\\" and backslash else
                   _esc(c) if _unsafe(c) and not (newlines and c == "\n") else c for c in text)


# Human output is hard-wrapped here, never by the terminal: a row the terminal wraps starts at
# column 0, where text a lane wrote (a body padded to the edge, then "#99 ... [decision]") would read
# as a new message header. The rule, on stdout and stderr alike: every physical row starts either
# with a header agentbus itself wrote (a message header `#<id> ` built from the integer id column, a
# `== <section>` line, a fixed confirmation such as `posted #N`, or the `agentbus: ` prefix of a
# diagnostic) or with INDENT. A line agentbus authored is marked with HEAD while the output is
# built; every other line (a who, claims, ctx or log row, a message body, a value) is indented,
# and every row after the first of any line is indented by wrap_line. HEAD is a NUL, which
# clean() always shows escaped, so no bus text can carry the mark: lane text never starts a row,
# whatever zero-width or combining character it starts with.
INDENT = "  "
HEAD = "\x00"
MIN_WIDTH = 20


def _fd_width(fd):
    try:
        return os.get_terminal_size(fd).columns or None
    except (OSError, ValueError):
        return None


HELP_WIDTH = 80  # the layout width of help text when output is not a terminal


def wrap_width(stream="out"):
    """The width human output is hard-wrapped to, or None for no wrapping. COLUMNS set to a number is
    an explicit choice and wraps anywhere; otherwise only a terminal is wrapped (its own width, 80
    when it will not say): a pipe or a file gets each line whole, the way a program's output is meant
    to be piped (clig.dev), and `less` or the reader wraps it. At least MIN_WIDTH."""
    env = os.environ.get("COLUMNS", "").strip()
    if env.isdigit() and len(env) < 7 and int(env) > 0:
        return max(int(env), MIN_WIDTH)
    s = sys.__stderr__ if stream == "err" else sys.__stdout__
    try:
        if s is not None and s.isatty():
            return max(_fd_width(s.fileno()) or 80, MIN_WIDTH)
    except (OSError, ValueError, AttributeError):
        pass
    return None


def stdout_is_tty():
    try:
        return sys.__stdout__ is not None and sys.__stdout__.isatty()
    except (OSError, ValueError, AttributeError):
        return False


def home_names():
    """The home folder as named ($HOME) and as resolved (symlinks followed; the same unless HOME is a link,
    as it is under macOS's /var), longest first. Never the root folder."""
    names = dict.fromkeys((os.path.expanduser("~"), os.path.realpath(os.path.expanduser("~"))))
    return sorted((h for h in names if h and h != os.sep), key=len, reverse=True)


def tilde(path):
    """path with the home folder, as named or as resolved, shown as ~. The one place a path for a person is shortened."""
    for home in home_names():
        if path == home or path.startswith(home + os.sep):
            return "~" + path[len(home):]
    return path


def char_width(c):
    """Columns one character is counted as when wrapping: 1 for printable ASCII, 2 for everything
    else. Never an undercount: no terminal draws one character wider than 2 columns, and terminals
    and Unicode versions disagree on the rest (a combining mark that is also wide, U+302E, counted 0
    by Unicode's tables and 2 by libc). A row that ends early is harmless; one that runs past the
    edge is wrapped by the terminal to column 0. Text reaches here already cleaned, so controls and
    invisible characters are ASCII escapes by then."""
    return 1 if " " <= c <= "~" else 2


def wrap_line(line, width):
    """One output line as rows of at most `width` display columns; rows after the first start with
    INDENT. A row breaks after its last space, so a path or a word that fits on a row is never cut;
    only a token longer than a whole row is broken mid-token. The space stays at the end of the row
    it ends (nothing is dropped). A wide character that would cross the edge moves to the next row
    whole. width None (no wrapping, see wrap_width): the line as it is."""
    if width is None:
        return line
    rows, row, col = [], [], 0
    for c in line:
        w = char_width(c)
        while col + w > width:
            # The row's own indent (a continuation's, or an indented line's) is not a break point.
            start = len(INDENT) if row[:len(INDENT)] == list(INDENT) else 0
            k = next((i for i in range(len(row) - 1, start, -1) if row[i] == " "), None)
            if k is None:  # one token fills the row: break it here
                rows.append("".join(row))
                row, col = [INDENT], len(INDENT)
                break
            rest = row[k + 1:]
            rows.append("".join(row[:k + 1]))
            row = [INDENT] + rest
            col = len(INDENT) + sum(char_width(x) for x in rest)
        row.append(c)
        col += w
    rows.append("".join(row))
    return "\n".join(rows)


def wrap_output(text, width=None):
    """Human output, every line wrapped by wrap_line to the terminal's width. A line marked HEAD
    (agentbus wrote its start) keeps its first row at column 0; every other non-empty line is
    indented, so it starts with INDENT whatever text it holds. With no width (stdout is not a
    terminal and COLUMNS is unset) lines are not wrapped, but the same start-of-row rule holds."""
    width = width or wrap_width("out")
    lines = []
    for line in text.split("\n"):
        if line.startswith(HEAD):
            line = line[len(HEAD):]
        elif line and not line.startswith(INDENT):
            line = INDENT + line
        lines.append(wrap_line(line.replace(HEAD, ""), width))
    return "\n".join(lines)


def col0(line):
    """Text a lane controls that will start a field at the start of a row, with a leading # or =
    shown as \\x23 / \\x3d. Defence in depth: rows that start with lane text are indented anyway."""
    if isinstance(line, str) and line[:1] in ("#", "="):
        return "\\x%02x" % ord(line[0]) + line[1:]
    return line


# Output a bus command builds is queued, and rendered only after the bus is closed: formatting a
# listing a lane inflated, or cleaning a long value a lane wrote, must not hold the exclusive lock,
# and neither may a write to a stdout or stderr nobody is draining. init and upgrade queue theirs
# too, through the same output path.
_PENDING = []


def later(fn):
    _PENDING.append(fn)


def render_pending():
    while _PENDING:
        _PENDING.pop(0)()


def show(template, *fields, row=False, path_first=False):
    """The one way a human line is printed: a literal template, every field cleaned, queued.
    By default a line agentbus authors (`posted #{}`, `== agents`): the template starts with fixed
    text, and the line is marked HEAD so its first row starts at column 0.
    row=True: a line that starts with bus text (a listing row, a value): indented, so that text
    never starts a row.
    path_first=True: an authored line that starts with the repo path the caller named (init and
    upgrade): marked HEAD like any authored line; its continuation rows are indented.
    A field that starts the line has a leading # or = escaped (col0), as defence in depth.
    Fields are cleaned and the line formatted only when the queue is rendered, after the bus is closed."""
    if not row and not path_first and template.startswith("{"):
        raise ValueError("an authored line starts with fixed text: " + template)

    def render():
        cleaned = [clean(f) for f in fields]
        if template.startswith("{") and cleaned:
            cleaned[0] = col0(cleaned[0])
        print((INDENT if row else HEAD) + template.format(*cleaned))
    later(render)


def _stdout_to_devnull():
    try:  # so the interpreter's own flush at exit cannot raise again
        os.dup2(os.open(os.devnull, os.O_WRONLY), sys.stdout.fileno())
    except (OSError, ValueError, AttributeError):
        pass


def write_out(text):
    """Write the command's buffered output to stdout. stdout closed (`>&-`), or a reader that went
    away (`| head`), is a clean error when there is output to lose; the command itself has run."""
    if not text:
        return
    if sys.stdout is None:
        die("stdout is closed, so the output was not shown (the command itself ran)", "output_failed")
    try:
        _test_fail("emit")
        sys.stdout.write(text)
        sys.stdout.flush()
    except BrokenPipeError:
        _stdout_to_devnull()
        die("the reader closed stdout before all the output was written (the command itself ran)", "output_failed")


def write_help():
    """Write the --help or --version text argparse produced (Parser._print_message): a closed
    stdout or a reader that went away is a one-line error, whether or not Python buffers stdout."""
    text = "".join(_HELP_TEXT)
    del _HELP_TEXT[:]
    if not text:
        return
    if sys.stdout is None:
        die("stdout is closed, so the help or version was not shown", "output_failed")
    try:
        sys.stdout.write(text)
        sys.stdout.flush()
    except OSError as e:
        if not isinstance(e, BrokenPipeError) and e.errno != errno.EPIPE:
            raise
        _stdout_to_devnull()
        die("the reader closed stdout before the help or version was written", "output_failed")


def flush_stdout(what):
    """Flush whatever argparse (--help, --version) or anything else left in stdout's buffer; a
    reader that went away is a clean error, not Python's `Exception ignored ... BrokenPipeError`."""
    try:
        if sys.stdout is not None:
            sys.stdout.flush()
    except BrokenPipeError:
        _stdout_to_devnull()
        die(f"the reader closed stdout before {what} was written", "output_failed")


def diag(msg):
    """A diagnostic as stderr shows it: `agentbus: ` then the cleaned message, hard-wrapped to the
    same width as stdout with every continuation row indented, so bus text in an error (a trigger
    or claim name) never starts a row."""
    return wrap_line("agentbus: " + clean(msg), wrap_width("err"))


# ==== contract registry ====


# True once a write the command itself made has been committed (not the last-seen refresh, not the
# setup an open does): any failure after that carries committed: true.
_WROTE = False
# True once the command's own database rows were committed. Only that makes repeating it unsafe (without a
# --request-id): a command that changed only files (init, upgrade's copy, setup) is safe to repeat and stays retryable.
_WROTE_ROWS = False
# While a COMMIT of pending rows runs: "own" for the command's own write, "setup" for any other (the last-seen
# refresh, an open's schema work). A process stopped then (the hold watchdog) cannot know whether SQLite had
# already written the commit record, so the write may be saved: the stop says so (outcome_unknown) and counts an
# "own" write as committed. None the rest of the time.
_IN_COMMIT = None
# The command that finishes an interrupted init or setup (set by each), named in its interrupted error.
_RERUN = None
# The files the command itself has changed so far (init's and upgrade's copy and VERSION, init's exclude rule, setup's
# config files and backups): a file write is the command's change as much as a row is (file_changed).
_CHANGED = []
# True when the command carries a --request-id (set in read_inputs).
_HAS_TOKEN = False


class Diag:
    """The message of an exit by die(): cleaned and wrapped only when Python prints it at exit,
    after every bus connection has been closed (cleaning a long value a lane wrote must not hold
    the lock). It also knows the exit status of its code: the one mapping, independent of --json
    (CONTRACT["errors"]); contract_main() applies it."""

    def __init__(self, msg, code="internal", next=None, **fields):
        self.msg = msg
        self.code = code
        # next: the exact command the message tells the reader to run (it is also in the message), or None
        self.next = next
        self.fields = fields

    @property
    def status(self):
        return CONTRACT["errors"].get(self.code, CONTRACT["errors"]["internal"])["exit"]

    @property
    def retryable(self):
        """The code's own value, but never true once the command's change was saved unless a
        --request-id makes repeating it return the saved result."""
        own = CONTRACT["errors"].get(self.code, CONTRACT["errors"]["internal"])["retryable"]
        return own and (not _WROTE_ROWS or _HAS_TOKEN)

    def __str__(self):
        # committed: the command's own write had already been saved when this failure came, so a caller
        # must not repeat it blindly (every JSON error carries it; human text says so unless it already does)
        if _JSON_ERRORS:
            return json.dumps({"error": {"code": self.code, "message": clean(self.msg), "retryable": self.retryable,
                                         "committed": _WROTE, "next": None if self.next is None else clean(self.next),
                                         **jsonable(self.fields)}}, default=repr, allow_nan=False)
        saved = _WROTE and self.code not in ("output_failed", "ack_failed") and not self.fields.get("outcome_unknown")
        text = self.msg.rstrip()
        if saved:
            text += ("" if text[-1:] in ".!?" else ".") + " The command's change was saved before this."
        return diag(text)


def file_changed(path):
    """Record that the command itself changed the file at path: any failure after this says committed true,
    and an interrupted error names the files (field changed)."""
    global _WROTE
    _WROTE = True
    _CHANGED.append(path)


def die(msg, code="internal", next=None, **fields):
    """Exit non-zero with an error on stderr. msg may echo bus-controlled text, so it is cleaned,
    later (Diag). Every call names its code (tests/test_contract.sh checks the source). next is the one
    command the message tells the reader to run, spelled the same in both (the JSON error's `next`)."""
    raise SystemExit(Diag(msg, code, next, **fields))


def reason(e):
    """The message a die() carried, for a caller that turns the exit into a notice."""
    return e.code.msg if isinstance(e.code, Diag) else str(e.code)


# ---- the contract registry: one source for `schema`, the --help result lines and docs/reference.md ----
# A result schema is a JSON Schema subset (type, required, properties, items, enum, anyOf, $ref to
# "#/objects/NAME"); tests/schema_check.py validates against it. Extra keys are always allowed: JSON
# changes are additive within contract version 1. Arguments are not repeated here: cmd_schema reads
# them from the argparse tree.

_STR, _INT, _BOOL = {"type": "string"}, {"type": "integer"}, {"type": "boolean"}
_NSTR, _NINT = {"type": ["string", "null"]}, {"type": ["integer", "null"]}


def _o(props, optional=()):
    """An object schema: every key in props is required unless named in optional."""
    return {"type": "object", "required": [k for k in props if k not in optional], "properties": dict(props)}


def _ref(name):
    return {"$ref": "#/objects/" + name}


def _list(item):
    return {"type": "array", "items": item}


def _env(item):
    """A listing: items, whether rows were left out, and a cursor (null except the four id walks). Its
    `contract` is added with every command's result, below."""
    return _o({"items": _list(item), "has_more": _BOOL, "next": _NSTR})


def _with_contract(schema):
    """A result schema as the command prints it: print_json puts `contract` (the JSON contract version) in every
    --json result, so every result schema requires it. An object gets the key; each branch of an anyOf gets
    it; a $ref (a result that is one shared object) is the object and the key together (allOf)."""
    if "anyOf" in schema:
        return {**schema, "anyOf": [_with_contract(x) for x in schema["anyOf"]]}
    if "$ref" in schema:
        return {"allOf": [schema, _o({"contract": _INT})]}
    if schema.get("type") == "object" and "required" in schema:
        if "contract" in schema["properties"]:
            return schema
        return {**schema, "required": ["contract"] + schema["required"], "properties": {"contract": _INT, **schema["properties"]}}
    raise ValueError("a --json result must be an object: %r" % (schema,))


def _stamp_contract_results():
    """Called once every command has registered (the end of this file)."""
    for entry in CONTRACT["commands"].values():
        entry["result"] = _with_contract(entry["result"])


_NGOAL = {"anyOf": [{"type": "null"}, _ref("Goal")]}
_OMITTED = _o({k: _INT for k in ("agents", "context", "claims", "messages")})
# What every command that opens a bus can fail with, beyond its own codes.
_BUS_ERRORS = ["bad_input", "no_bus", "busy", "schema_refused", "schema_older", "schema_newer", "schema_corrupt",
               "backup_failed", "bus_unavailable", "output_failed", "interrupted", "internal"]
# Commands that only look for a bus, that also touch files in a repo, and that touch nothing.
_FIND_ERRORS = ["bad_input", "no_bus", "bus_unavailable", "output_failed", "interrupted", "internal"]
_FILES_ERRORS = ["bad_input", "no_bus", "bus_unavailable", "busy", "output_failed", "interrupted", "internal"]
_PLAIN_ERRORS = ["bad_input", "output_failed", "interrupted", "internal"]
_SAFE = {"class": "safe", "how": "repeat freely", "short": "safe to repeat"}
_REPEAT = {"class": "idempotent", "how": "repeat", "short": "safe to repeat"}


def _cmd(summary, result, errors=(), retry=_SAFE, text=None, base=_BUS_ERRORS):
    """base: the codes every command of its kind can fail with, from what its code path can raise
    (tests/test_exit_codes.sh checks that every code it observes for a command is listed here)."""
    return {"summary": summary, "result": result, "retry": retry, "text": text, "errors": list(errors) + list(base)}


CONTRACT = {
    "contract": 1,
    "objects": {
        "Agent": _o({"name": _STR, "tool": _NSTR, "model": _NSTR, "cwd": _NSTR, "branch": _NSTR, "role": _NSTR,
                     "joined_at": _STR, "last_seen": _STR}),
        "Message": _o({"id": _INT, "ts": _STR, "sender": _STR, "recipient": _STR, "kind": _STR, "topic": _NSTR,
                       "body": _STR, "reply_to": _NINT, "body_truncated": _BOOL}, optional=("body_truncated",)),
        "Claim": _o({"resource": _STR, "agent": _STR, "purpose": _NSTR, "claimed_at": _STR, "expires_at": _STR,
                     "state": {"type": "string", "enum": ["held", "expired"]}}),
