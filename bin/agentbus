def build_parser():
    p = Parser(prog="agentbus", description="Coordinate agents in one local workspace: messages, file claims, and shared facts.",
               formatter_class=argparse.RawDescriptionHelpFormatter,
               epilog="Start:  agentbus --as NAME join\n"
                      "Loop:   inbox; claim PATH --purpose WHY; post RESULT --to NAME --kind handoff\n"
                      "Finish: post RESULT --kind done; leave\n"
                      "Humans: agentbus watch\n"
                      "Env:    AGENTBUS_AGENT (default --as), AGENTBUS_DB (bus path)")
    common = Parser(add_help=False)
    # SUPPRESS: a subcommand must not reset an option set before it.
    for parser, default in ((p, None), (common, argparse.SUPPRESS)):
        parser.add_argument("--as", dest="as_", metavar="NAME", default=default,
                            help="Your agent identity; overrides AGENTBUS_AGENT. "
                                 "Successful commands run with --as refresh that agent's last-seen, except watch. "
                                 "Omit --as to look without counting as present.")
        parser.add_argument("--json", action="store_true", default=default,
                            help="Print successful command results as JSON. Check exit status; errors use stderr.")
        parser.add_argument("--up", metavar="N", type=bus_level, default=0 if parser is p else default,
                            help="Select the Nth outer bus (default 0). AGENTBUS_DB takes precedence.")
    p.add_argument("--version", action="version", version=f"agentbus {__version__}", help="Show program version and exit.")
    s = p.add_subparsers(dest="cmd", required=True)

    def sub(name, **k):
        if "help" in k:
            k.setdefault("description", k["help"])  # shown by `agentbus <command> --help` too
        return s.add_parser(name, parents=[common], **k)
    sub.common = common  # for the nested subparsers (ctx, log) of a register_<cmd> function

    for register in REGISTER_COMMANDS:
        register(sub)
    apply_contract_help(p)
    return p


POSITIONALS = ("cmd", "body", "action", "key", "value", "resource", "what", "detail", "repo", "text")
ENV_INPUTS = ("AGENTBUS_DB", "AGENTBUS_AGENT")


def not_utf8(v):
    """True when text came from bytes that are not UTF-8: Python decodes argv and the environment
    with surrogateescape, so each such byte is a lone surrogate, which SQLite and the terminal refuse."""
    if isinstance(v, (list, tuple)):
        return any(not_utf8(x) for x in v)
    return isinstance(v, str) and any("\ud800" <= c <= "\udfff" for c in v)


def refuse_bad_inputs(a):
    """Refuse an argument or environment value that is not valid UTF-8, naming it."""
    _test_fail("parse")
    for dest, v in sorted(vars(a).items()):
        if not_utf8(v):
            name = dest if dest in POSITIONALS else "--" + dest.rstrip("_").replace("_", "-")
            die(f"{name} is not valid UTF-8", "bad_input")
    for k in ENV_INPUTS:
        if not_utf8(os.environ.get(k)):
            die(f"{k} is not valid UTF-8", "bad_input")


# ==== watch ====

# ---- watch: a live, read-only view of the bus ----------------------------------------------------
# Each tick opens the bus, copies what the view needs, and closes it before anything is formatted or
# drawn, like every other command: the view never holds the lock while it draws, and its read-only open
# changes no data or schema (no join, no touch; it may finish SQLite's recovery of a crashed writer's journal). Every lane-written string goes through clean() and is cut to its column, and
# every row starts with text agentbus wrote, so nothing a lane stores can draw outside its cell.

def empty_snapshot():
    return {"agents": [], "claims": [], "goal": None, "context": [], "messages": [],
            "counts": {"agents": 0, "claims": 0, "messages": 0}}


def watch_snapshot(path, strict, limit, read_only=True):
    """Everything the view shows, as plain values, read in one short open. Read-only: it never
    creates, stamps, migrates or tidies the bus. A bus folder whose bus.db nothing has written yet
    is shown as the empty bus it is (and still not created)."""
    try:
        con = open_bus(path, strict, read_only=read_only)
    except SystemExit as e:
        if read_only and refusal(e)["code"] == "no_bus" and os.path.isdir(os.path.dirname(path)):
            return empty_snapshot()
        raise
    try:
        q = lambda sql, *p: [dict(r) for r in con.execute(sql, p).fetchall()]
        snap = {
            "agents": q("SELECT name, role, last_seen, joined_at FROM agents ORDER BY joined_at, name LIMIT ?", limit),
            "claims": q("SELECT resource, agent, purpose, expires_at FROM claims WHERE expires_at > ? "
                        "ORDER BY expires_at LIMIT ?", now(), limit),
            "goal": current_goal(con),
            "context": q("SELECT key, value, updated_by, updated_at FROM context WHERE key<>? ORDER BY updated_at DESC LIMIT ?",
                         GOAL_KEY, limit),
            "messages": list(reversed(q("SELECT id, ts, sender, recipient, kind, body, reply_to FROM messages "
                                        "ORDER BY id DESC LIMIT ?", limit))),
            "counts": {t: con.execute(f"SELECT COUNT(*) FROM {t}").fetchone()[0] for t in ("agents", "messages")},
        }
        snap["counts"]["claims"] = con.execute("SELECT COUNT(*) FROM claims WHERE expires_at > ?", (now(),)).fetchone()[0]
        facts = con.execute("SELECT COUNT(*) FROM context WHERE key<>?", (GOAL_KEY,)).fetchone()[0]
        snap["omitted"] = {"agents": snap["counts"]["agents"] - len(snap["agents"]), "context": facts - len(snap["context"]),
                           "claims": snap["counts"]["claims"] - len(snap["claims"]),
                           "messages": snap["counts"]["messages"] - len(snap["messages"])}
        return snap
    finally:
        con.close()


def _when(ts):
    try:
        return datetime.strptime(str(ts), "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
    except ValueError:
        return None


def ago(ts, t_now):
    """A short age: now, 42s, 12m, 3h, 2d."""
    t = _when(ts)
    if t is None:
        return "?"
    s = int((t_now - t).total_seconds())
    if s < 5:
        return "now"
    for unit, n in (("d", 86400), ("h", 3600), ("m", 60)):
        if s >= n:
            return f"{s // n}{unit}"
    return f"{s}s"


def time_left(ts, t_now):
    t = _when(ts)
    if t is None:
        return "?"
    m = max(0, int((t - t_now).total_seconds()) // 60)
    return f"{m // 60}h {m % 60:02d}m" if m >= 60 else f"{m}m"


def cell_width(c):
    """Columns a character takes in the live view: 2 for wide (East Asian W/F), 0 for combining
    marks, else 1. clean() has already escaped every control and format character. Ambiguous-width
    characters (é, the em dash) count 1, as in every non-CJK terminal; each row keeps one spare column."""
    if unicodedata.combining(c):
        return 0
    return 2 if unicodedata.east_asian_width(c) in "WF" else 1


def text_width(s):
    return sum(cell_width(c) for c in s)


def fit(text, n):
    """Lane text cleaned, folded to one line, and cut (with an ellipsis) or padded to exactly n columns."""
    s = " ".join(clean(text if isinstance(text, str) else ("" if text is None else str(text))).split())
    n = max(0, n)
    if text_width(s) <= n:
        return s + " " * (n - text_width(s))
    out, w = [], 0
    for c in s:
        cw = cell_width(c)
        if w + cw > n - 1:
            break
        out.append(c)
        w += cw
    return "".join(out) + "…" + " " * (n - 1 - w)


def fit_left(text, n):
    """Like fit(), but cut from the left: keeps the end of a path (…/myrepo)."""
    s = clean(text)
    if text_width(s) <= n:
        return s + " " * (n - text_width(s))
    out, w = [], 0
    for c in reversed(s):
        cw = cell_width(c)
        if w + cw > n - 1:
            break
        out.append(c)
        w += cw
    return "…" + "".join(reversed(out)) + " " * (n - 1 - w)


class Paint:
    def __init__(self, on, emoji=False):
        self.on = on
        self.emoji = emoji

    def __call__(self, code, s):
        return f"\033[{code}m{s}\033[0m" if self.on and code else s


# Agent colours, assigned in roster order so the first eight never share one. No red: red means alert.
AGENT_COLOURS = (34, 36, 35, 32, 33, 94, 96, 95)
KIND_COLOURS = {"handoff": 33, "question": 35, "answer": 36, "done": 32, "decision": 34, "alert": 31}
FRESH_S = 3.0  # how long a new message is marked, and an agent that just posted is lit
IDLE_MIN = 5  # an agent not seen for this long shows a hollow dot
ONCE_MESSAGES = 20  # messages in a single frame (--once, or stdout not a terminal)
WATCH_MIN_COLS = 40
# Emoji for a role (matched on words in it), a message kind and each section. Every one is a single
# East Asian Wide code point (no variation selector), so the column arithmetic stays exact. Shown only
# on a terminal, and AGENTBUS_NO_EMOJI=1 turns them off.
ROLE_EMOJI = ((("brain", "lead", "orchestrat", "planner", "coordinat"), "🧠"),
              (("lane", "hand", "implement", "worker", "fix", "build", "dev"), "✋"),
              (("test", "qa"), "🧪"), (("review", "audit", "security"), "🔍"), (("doc", "writer"), "📚"),
              (("deploy", "ops", "release"), "🚀"), (("design", "ui", "ux"), "🎨"),
              (("human", "owner", "user", "you"), "🙋"))
KIND_EMOJI = {"handoff": "🤝", "question": "❓", "answer": "💬", "done": "✅", "decision": "🧭", "alert": "🚨", "note": "📝"}
SECTION_EMOJI = {"Agents": "👥", "Claims": "🔒", "Facts": "📌", "Messages": "💬"}


def role_emoji(role):
    words = str(role or "").lower()
    for keys, e in ROLE_EMOJI:
        if any(k in words for k in keys):
            return e
    return "🤖"
WIDE_COLS = 72  # from here the kind gets its own column


def colour_map(agents):
    by_order = {}
    for a in agents:
        name = str(a["name"])
        if name not in by_order and len(by_order) < len(AGENT_COLOURS):
            by_order[name] = AGENT_COLOURS[len(by_order)]
    return lambda name: by_order.get(str(name), AGENT_COLOURS[zlib.crc32(str(name).encode("utf-8", "replace")) % len(AGENT_COLOURS)])


def share_rows(needs, room):
    """Rows for each section: one each while room lasts, then round-robin to whoever needs more."""
    got = [0] * len(needs)
    for i, n in enumerate(needs):
        if room and n:
            got[i], room = 1, room - 1
    while room:
        grew = False
        for i, n in enumerate(needs):
            if room and got[i] < n:
                got[i], room, grew = got[i] + 1, room - 1, True
        if not grew:
            break
    return got


def watch_fix_line(error, where, interval):
    """The one line that says what to do about an unreadable bus, by error code."""
    code = error.get("code")
    if code == "schema_older":
        return f"Run: agentbus upgrade {where}"
    if code == "schema_newer":
        return f"Run: agentbus upgrade {where} from a newer install"
    if code == "busy":
        return f"Another process holds the bus. Retrying every {interval:g}s."
    if code == "no_bus":
        return f"Run: agentbus init {where}"
    return None


def tilde(path):
    """path with the home directory (as named, or as resolved) shown as ~."""
    for home in dict.fromkeys((os.path.expanduser("~"), os.path.realpath(os.path.expanduser("~")))):
        if path == home or path.startswith(home + os.sep):
            return "~" + path[len(home):]
    return path


def render_error_frame(error, where, cols, rows, paint, interval, live=True):
    """The frame for a bus that could not be read: what happened and the fix, never empty sections
    (which would look like lost history)."""
    width = cols - 1
    head, tail = " agentbus  ", " not readable "
    room = width - len(head) - len(tail)
    header = paint("1;7", head + fit_left(where, room) + tail if room >= 8 else fit(head + tail.strip(), width))
    out = [header, "", "  " + fit("This bus could not be read, so the sections below are not drawn.", width - 2)]
    fix = watch_fix_line(error, error.get("directory") or where, interval)
    for text in (error.get("message", ""), fix):
        if text:  # wrapped, never cut: the fix names a path to type
            for row in wrap_line(INDENT + " ".join(clean(str(text)).split()), width).split("\n"):
                out.append(INDENT + fit(row[len(INDENT):], width - len(INDENT)))
    if error.get("code") != "busy":
        out += ["", "  " + fit(f"Retrying every {interval:g}s.", width - 2)]
    if not live:
        return out
    out = out[:rows - 1]
    while len(out) < rows - 1:
        out.append("")
    out.append(paint("2", "  " + fit("q quit · read-only", width - 2)))
    return out


def render_watch(snap, where, cols, rows, fresh, t_now, paint, live=True, error=None, interval=1.0):
    """The frame: a header bar, then Agents, Claims, Facts and Messages (newest last). Messages, the
    part that moves, get their share of the screen first; any section cut short says how many it
    left out and which command shows them. live: fill the screen and end with the key hint; else
    (one frame: --once, or not a terminal) the content alone, with the last ONCE_MESSAGES messages.
    error ({"code", "message"}): the bus could not be read; the frame says so and names the fix
    instead of drawing sections."""
    if cols < WATCH_MIN_COLS:
        return [fit(f"watch needs {WATCH_MIN_COLS}+ columns", cols)]
    if error is not None:
        return render_error_frame(error, where, cols, rows, paint, interval, live)
    width = cols - 1  # one spare column: an ambiguous-width character drawn wide never wraps a row
    wide = cols >= WIDE_COLS
    colour = colour_map(snap["agents"])
    n = snap["counts"]
    hot = {m["sender"] for m in snap["messages"] if m["id"] in fresh}

    def plural(k, word):
        return f"{n[k]} {word}{'' if n[k] == 1 else 's'}"
    stats = f"{plural('agents', 'agent')} · {plural('claims', 'claim')} · {plural('messages', 'message')} "
    head = " agentbus  "
    room = width - len(head) - len(stats) - 1
    header = paint("1;7", head + fit_left(where, room) + " " + stats if room >= 8 else fit(head + stats.strip(), width))

    def more(k, shown, command):
        return paint("2", "  " + fit(f"… {k - shown} more · agentbus {command}", width - 2))

    # Agents
    agent_rows = []
    for a in snap["agents"]:
        seen = _when(a["last_seen"])
        idle = seen is None or (t_now - seen).total_seconds() > IDLE_MIN * 60
        dot = paint("2", "○") if idle else paint(colour(a["name"]), "●")
        name_w = 16 if wide else 12
        lead_w = 1  # the dot; with emoji, "● 🧠"
        if paint.emoji:
            dot += " " + role_emoji(a["role"])
            lead_w = 4
        name = paint("1" if a["name"] in hot else "", fit(a["name"], name_w))
        role_w = max(0, width - 2 - lead_w - 1 - name_w - 1 - 5)
        role = fit(a["role"], role_w) if wide else " " * role_w
        agent_rows.append(f"  {dot} {name} {paint('2', role)}{paint('2', ago(a['last_seen'], t_now).rjust(5))}")
    # Claims
    claim_rows = []
    res_w = max(14, min(36, width // 3))
    for c in snap["claims"]:
        holder = paint(colour(c["agent"]), fit(c["agent"], 12))
        rest = f"{time_left(c['expires_at'], t_now)} left" + (f" · {c['purpose']}" if wide and c["purpose"] else "")
        claim_rows.append(f"  {fit(c['resource'], res_w)} {holder} {paint('2', fit(rest, width - 2 - res_w - 14))}")
    # Facts, newest first
    fact_rows = []
    key_w, by_w = max(10, min(24, width // 5)), min(20, width // 4)
    for x in snap["context"]:
        by = f"{x['updated_by']} · {ago(x['updated_at'], t_now)}"
        fact_rows.append(f"  {fit(x['key'], key_w)} {fit(x['value'], width - 2 - key_w - 1 - by_w - 1)} "
                         f"{paint('2', fit(by, by_w).rstrip().rjust(by_w))}")
    # Messages, oldest to newest
    msg_rows = []
    for m in snap["messages"]:
        new = m["id"] in fresh
        kind = str(m["kind"])
        kc = KIND_COLOURS.get(kind, 2)
        to = "everyone" if m["recipient"] == "*" else m["recipient"]
        route_w = 24 if wide else 15
        arrow = " → " if wide else "→"
        part = (route_w - len(arrow)) // 2
        frm, dest = fit(m["sender"], part).rstrip(), fit(to, part).rstrip()
        route_plain_w = text_width(frm) + len(arrow) + text_width(dest)
        route = (paint(colour(m["sender"]), frm) + paint("2", arrow)
                 + (paint("2", dest) if to == "everyone" else paint(colour(to), dest))
                 + " " * (route_w - route_plain_w))
        lines_ = str(m["body"] or "").split("\n")
        extra = f" ↵+{len(lines_) - 1}" if len(lines_) > 1 else ""
        reply = f"↳#{m['reply_to']} " if m["reply_to"] else ""
        mid = fit("#" + str(m["id"]), 5)
        age = ago(m["ts"], t_now).rjust(4)
        emo = KIND_EMOJI.get(kind, "📝") if paint.emoji else ""
        if wide:
            bar = paint(kc, "▌") if new else " "
            kind_cell = (emo + " " if emo else "") + fit(kind, 9)
            body_w = (width - 1 - 1 - 5 - route_w - 1 - text_width(kind_cell) - 1 - text_width(reply)
                      - text_width(extra) - 1 - 4)
            msg_rows.append(f"{bar} {paint('2', mid)}{route} {paint(kc, kind_cell)} {paint('2', reply)}"
                            f"{paint('1' if new else '', fit(lines_[0], body_w))}{paint('2', extra)} {paint('2', age)}")
        else:
            lead = emo or paint(kc, "▌")  # narrow: the kind is the emoji, or a bar in the kind's colour
            body_w = (width - text_width(emo or "▌") - 1 - 5 - route_w - 1 - text_width(reply)
                      - text_width(extra) - 1 - 4)
            msg_rows.append(f"{lead} {paint('2', mid)}{route} {paint('2', reply)}"
                            f"{paint('1' if new else '', fit(lines_[0], body_w))}{paint('2', extra)} {paint('2', age)}")

    sections = [("Agents", n["agents"], agent_rows, "no one yet. Join with: agentbus --as NAME join", "who"),
                ("Claims", n["claims"], claim_rows, "nothing claimed", "claims"),
                ("Facts", len(snap["context"]), fact_rows, "none yet", "ctx get")]
    # A blank line between sections whenever the whole frame fits with them (or the screen is tall).
    natural = 3 + 4 + sum(max(1, len(r)) for _, _, r, _, _ in sections) + max(1, len(msg_rows))
    gap = live and (rows >= 30 or natural + 4 <= rows)
    if live:
        fixed = 1 + 1 + 1 + 4 + (4 if gap else 0)  # header, goal, footer, four titles, blank lines
        body_rows = max(4, rows - fixed)
        want_msgs = max(1, len(msg_rows))
        msg_share = min(want_msgs + (1 if n["messages"] > len(msg_rows) else 0), max(3, body_rows // 2))
        needs = [max(1, len(r) + (1 if total > len(r) else 0)) for _, total, r, _, _ in sections]
        shares = share_rows(needs, max(0, body_rows - msg_share))
        msg_share = max(1, body_rows - sum(shares))  # rows the others did not need go to messages
    else:
        shares = [len(r) + (1 if total > len(r) else 0) or 1 for _, total, r, _, _ in sections]
        msg_share = ONCE_MESSAGES + 1

    g = snap.get("goal")
    if g:
        tail = f" · {g['set_by']} · {ago(g['set_at'], t_now)}"
        goal_row = (paint("1;33", "  🎯 " if paint.emoji else "  ◆ ") + paint("1", fit(g["goal"], width - 4 - text_width(clean(tail))))
                    + paint("2", fit(tail, text_width(clean(tail)))))
    else:
        goal_row = paint("2", ("  🎯 " if paint.emoji else "  ◇ ") + fit('no goal yet · agentbus --as NAME goal "..."',
                                                                            width - (5 if paint.emoji else 4)))
    out = [header, goal_row]
    for (title, total, rows_, empty, command), share in zip(sections, shares):
        if gap or not live:
            out.append("")
        out.append(paint("1", (SECTION_EMOJI[title] + " " if paint.emoji else "") + title) + paint("2", f"  {total}"))
        if not rows_:
            out.append(paint("2", "  " + fit(empty, width - 2)))
            continue
        cut = len(rows_) > share or total > len(rows_)
        keep = rows_[:share - 1] if cut and share > 1 else rows_[:share]
        out.extend(keep)
        if cut and share > 1:
            out.append(more(total, len(keep), command))
    if gap or not live:
        out.append("")
    out.append(paint("1", ("💬 " if paint.emoji else "") + "Messages") + paint("2", f"  {n['messages']}"))
    if not msg_rows:
        out.append(paint("2", "  quiet so far"))
    else:
        earlier = n["messages"] - min(len(msg_rows), msg_share)
        if earlier > 0:
            shown = msg_rows[-(msg_share - 1):] if msg_share > 1 else []
            out.append(paint("2", "  " + fit(f"… {n['messages'] - len(shown)} earlier · agentbus read", width - 2)))
            out.extend(shown)
        else:
            out.extend(msg_rows[-msg_share:])
    if not live:
        return out
    out = out[:rows - 1]
    while len(out) < rows - 1:
        out.append("")
    out.append(paint("2", "  " + fit("q quit · read-only", width - 2)))
    return out


def cmd_watch(a, strict):
    """The live view, redrawn in place until q. --json: one snapshot as JSON. --once, or stdout not
    a terminal: one frame, then exit."""
    colour_on = sys.stdout.isatty() and not os.environ.get("NO_COLOR")
    emoji_on = sys.stdout.isatty() and not os.environ.get("AGENTBUS_NO_EMOJI") and \
        (sys.stdout.encoding or "").lower().replace("-", "") == "utf8"
    paint = Paint(colour_on, emoji_on)
    folder = os.path.dirname(a._db)
    where = tilde(os.path.dirname(folder) if os.path.basename(folder) == ".agentbus" else a._db)
    limit = 200
    if a.json:
        snap = watch_snapshot(a._db, strict, limit)
        print_json({"bus": a._db, "directory": where, **snap})
        return
    if a.once or not sys.stdout.isatty():
        snap = watch_snapshot(a._db, strict, limit)
        size = shutil.get_terminal_size((100, 40))
        frame = render_watch(snap, where, size.columns, size.lines, set(), datetime.now(timezone.utc), paint, live=False)
        write_out("\n".join(l.rstrip() for l in frame) + "\n")
        return
    import select
    import signal
    import termios
    import tty as ttymod
    stdin = sys.stdin.fileno() if sys.stdin and sys.stdin.isatty() else None
    saved = termios.tcgetattr(stdin) if stdin is not None else None
    wake_r, wake_w = os.pipe()  # SIGWINCH writes here, so a resize redraws at once, not on the next tick
    os.set_blocking(wake_w, False)
    old_winch = signal.signal(signal.SIGWINCH, lambda *_: os.write(wake_w, b"r"))
    # Ctrl-C sets a flag and wakes the loop instead of raising: a KeyboardInterrupt raised inside a
    # query (the budget's progress handler is Python) comes back as a database error, which the loop
    # would show and carry on from.
    stop = []
    old_int = signal.signal(signal.SIGINT, lambda *_: (stop.append(1), os.write(wake_w, b"i")))
    # Ctrl-C must end watch however it was started. A blocked signal survives exec, and a CI runner
    # or a parent shell can start us with SIGINT or SIGWINCH blocked: the handler above would then
    # never run and watch would ignore Ctrl-C for good. And the C-level handler writes the signal
    # number to the wakeup fd from whichever thread took the signal, so select() wakes even when the
    # kernel did not deliver the signal to this thread.
    old_mask = signal.pthread_sigmask(signal.SIG_UNBLOCK, {signal.SIGINT, signal.SIGWINCH})
    old_wakeup = signal.set_wakeup_fd(wake_w, warn_on_full_buffer=False)
    first_seen, out = {}, sys.stdout
    snap = empty_snapshot()
    out.write("\033[?1049h\033[?25l")
    try:
        if stdin is not None:
            ttymod.setcbreak(stdin)
        next_read = 0.0
        error = None
        while not stop:
            if time.monotonic() >= next_read:
                try:
                    snap = watch_snapshot(a._db, strict, limit)
                    error = None
                except SystemExit as e:  # busy, or refused: say so, draw no sections, try again next tick
                    if stop:
                        break
                    error = dict(refusal(e), directory=tilde(bus_directory(a._db)))
                next_read = time.monotonic() + a.interval
                started = not first_seen
                for m in snap["messages"]:
                    first_seen.setdefault(m["id"], 0.0 if started else time.monotonic())
            fresh = {i for i, t in first_seen.items() if t and time.monotonic() - t < FRESH_S}
            size = shutil.get_terminal_size()
            frame = render_watch(snap, where, size.columns, size.lines, fresh, datetime.now(timezone.utc), paint,
                                 error=error, interval=a.interval)
            out.write("\033[H" + "\n".join(l + "\033[K" for l in frame) + "\033[J")
            out.flush()
            wait = max(0.05, next_read - time.monotonic())
            ready, _, _ = select.select([wake_r] + ([stdin] if stdin is not None else []), [], [], wait)
            if wake_r in ready:
                os.read(wake_r, 64)
            if stdin is not None and stdin in ready:
                key = os.read(stdin, 32)
                if key in (b"q", b"Q", b"\x1b"):  # a lone ESC; arrow keys and the like arrive as \x1b[...
                    break
    except KeyboardInterrupt:
        pass
    finally:
        signal.set_wakeup_fd(old_wakeup)
        signal.signal(signal.SIGWINCH, old_winch)
        signal.signal(signal.SIGINT, old_int)
        signal.pthread_sigmask(signal.SIG_SETMASK, old_mask)
        os.close(wake_r)
        os.close(wake_w)
        out.write("\033[?25h\033[?1049l")
        out.flush()
        if saved is not None:
            termios.tcsetattr(stdin, termios.TCSADRAIN, saved)


