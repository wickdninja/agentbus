# What agentbus prints with no command, and what the end of `agentbus --help` repeats.
GUIDE = ("Start:  agentbus --as NAME join\n"
         "Loop:   inbox; claim PATH --purpose WHY; post RESULT --to NAME --kind handoff\n"
         "Finish: post RESULT --kind done; leave\n"
         "Humans: agentbus watch\n"
         "Env:    AGENTBUS_AGENT (default --as), AGENTBUS_DB (bus path)")
# The flags every command takes, as a command's help shows them: once, one line each.
INHERITED_FLAGS = (("--as NAME", "Your agent identity (or AGENTBUS_AGENT)"),
                   ("--json", "Print the result as JSON"),
                   ("--up N", "Use the Nth outer bus (default 0)"))


def hidden_commands():
    return set(CONTRACT["hidden"])


def cmd_words(parser):
    """The command as typed: agentbus post, agentbus ctx set."""
    return ("agentbus",) + tuple(parser.cmd_path)


def subparsers_of(parser):
    return next((x for x in parser._actions if isinstance(x, argparse._SubParsersAction)), None)


def visible_choices(parser):
    """The subcommands a parser lists: not the hidden ones (hook), whatever the Python version prints for them."""
    sp = subparsers_of(parser)
    return [n for n in sp.choices if n not in hidden_commands()] if sp else []


def own_actions(parser):
    """What a command's help lists as its own: not help, version, the inherited flags or a subcommand list."""
    return [x for x in parser._actions
            if not isinstance(x, (argparse._HelpAction, argparse._VersionAction, argparse._SubParsersAction))
            and x.dest not in GLOBAL_DESTS]


def positional_name(action, command, bracket=True):
    """How a positional shows: NAME, or [NAME] (unless bracket is False) when it may be left out."""
    name = "{" + ",".join(map(str, action.choices)) + "}" if action.choices else (action.metavar if isinstance(action.metavar, str) else action.dest).upper()
    required = action.nargs is None or bool(CONTRACT["arg_notes"].get(command, {}).get(name.lower(), {}).get("required"))
    return name if required or not bracket else "[" + name + "]"


def flag_text(action):
    """--to NAME, --once, --scope user|project: one flag as usage shows it."""
    flag = max(action.option_strings, key=len)
    if action.nargs == 0:
        return flag
    if action.choices:
        return flag + " {" + ",".join(map(str, action.choices)) + "}"
    return flag + " " + (action.metavar if isinstance(action.metavar, str) else action.dest.upper())


def usage_text(parser):
    """agentbus post BODY [--to NAME] ...: the command's own arguments, positionals first. For agentbus itself
    and for a group such as ctx, the choice of subcommand."""
    words = list(cmd_words(parser))
    if subparsers_of(parser) is not None:
        if not parser.cmd_path:
            words += ["[--as NAME]", "[--json]", "[--up N]"]
        return " ".join(words + ["{" + ",".join(visible_choices(parser)) + "}", "..."])
    command = " ".join(parser.cmd_path)
    acts = sorted(own_actions(parser), key=lambda x: bool(x.option_strings))
    exclusive = {id(x): g for g in parser._mutually_exclusive_groups for x in g._group_actions}
    done = set()
    for x in acts:
        if id(x) in exclusive:
            g = exclusive[id(x)]
            if id(g) not in done:
                done.add(id(g))
                words.append("[" + " | ".join(flag_text(m) if m.option_strings else positional_name(m, command, False)
                                              for m in g._group_actions) + "]")
        elif x.option_strings:
            words.append("[" + flag_text(x) + "]")
        else:
            words.append(positional_name(x, command))
    return " ".join(words)


def own_flag_names(parser):
    """The long flags a usage error lists. agentbus itself lists the ones that come before a command."""
    if not parser.cmd_path:
        return ["--as", "--json", "--up", "--version"]
    return [max(x.option_strings, key=len) for x in own_actions(parser) if x.option_strings]


def wrap_text(text, width, hang=""):
    return textwrap.fill(text, width=width, subsequent_indent=hang, break_long_words=False, break_on_hyphens=False)


def help_table(rows, width, indent="  ", pad=None):
    """Two columns: the left padded to the widest name (at most 26), the right wrapped under itself."""
    pad = pad or min(max(len(left) for left, _ in rows), 26) + 2
    lines = []
    for left, right in rows:
        head = indent + left.ljust(pad)
        if len(left) > pad - 2:
            lines.append(indent + left)
            head = indent + " " * pad
        wrapped = textwrap.wrap(right, width=max(width - len(head), 20), break_long_words=False, break_on_hyphens=False) or [""]
        lines.append(head + wrapped[0])
        lines.extend(" " * len(head) + w for w in wrapped[1:])
    return "\n".join(lines)


def example_block(command):
    items = HELP_EXAMPLES.get(command)
    return "\n".join(f"  # {what}\n  {line}" for what, line in items) if items else None


def identity_example(a):
    """The first example of the command that carries --as: what the "say who you are" error shows."""
    command = a.cmd + (" " + a.action if getattr(a, "action", None) else "")
    for key in (command, a.cmd):
        for _what, line in HELP_EXAMPLES.get(key, []):
            if "--as " in line:
                return line
    return "agentbus --as alice " + command


class Parser(argparse.ArgumentParser):
    """argparse, with its errors written as agentbus diagnostics (`agentbus: ` and wrapped, every
    continuation row indented) instead of a usage block the terminal may wrap at column 0, scoped to the
    command that was being parsed, and with its help written by format_help."""

    cmd_path = ()  # ("post",), ("ctx", "set"); () for agentbus itself. Set once the tree is built.

    def __init__(self, *args, **kwargs):
        # No option abbreviations: --js would mean --json to argparse, but whether errors print as JSON
        # is decided from the exact word before parsing, so an abbreviation would get the wrong format.
        kwargs.setdefault("allow_abbrev", False)
        super().__init__(*args, **kwargs)
        for action in self._actions:
            if action.dest == "help":
                action.help = "Show this help message and exit."

    def parse_args(self, args=None, namespace=None):
        """Arguments nothing took are reported by the command being parsed, not by agentbus as a whole."""
        ns, extras = self.parse_known_args(args, namespace)
        if extras:
            words = list(sys.argv[1:] if args is None else args)
            leaf = self.leaf_for(ns)
            if getattr(ns, "cmd", None) in words and extras[0] in words[:words.index(ns.cmd)]:
                leaf = self  # a flag typed before the command belongs to agentbus, not to the command
            leaf.error(leaf.unrecognized(extras))
        return ns

    def unrecognized(self, extras):
        """The message for arguments nothing took. A flag that is one typo away from one this command (or agentbus
        itself) takes says which: `Did you mean --kind?`."""
        flags = own_flag_names(self) + ([] if not self.cmd_path else ["--as", "--json", "--up"]) + ["--help"]
        guesses = []
        for word in extras:
            if word.startswith("--"):
                flag = word.split("=", 1)[0]
                close = difflib.get_close_matches(flag, flags, n=1, cutoff=0.6)
                if close and close[0] != flag:
                    guesses.append((flag, close[0]))
        text = "unrecognized arguments: " + " ".join(extras)
        if len(guesses) == 1:
            text += f". Did you mean {guesses[0][1]}?"
        elif guesses:
            text += ". Did you mean " + ", ".join(f"{good} (for {bad})" for bad, good in guesses) + "?"
        return text

    def leaf_for(self, ns):
        """The parser of the command ns names (post, ctx set); the group when only the group is named; else self."""
        found = self
        for dest in ("cmd", "action"):
            word = getattr(ns, dest, None)
            sp = subparsers_of(found)
            if word and sp is not None and word in sp.choices:
                found = sp.choices[word]
        return found

    def error(self, message, see=None):
        """This command's usage error: what is wrong, its usage and flags, and the command that explains it
        (see: another command that does, when there is one)."""
        flags = own_flag_names(self)
        lead = message if message.endswith((".", "!", "?")) else message + "."
        text = (f"{lead} Usage: {usage_text(self)}. " + (f"Flags: {', '.join(flags)}. " if flags else "")
                + f"See: {see or ' '.join(cmd_words(self)) + ' --help'}")
        if _JSON_ERRORS:
            die(text, "bad_input", next=see or " ".join(cmd_words(self)) + " --help")
        note(text)
        raise SystemExit(2)

    def _check_value(self, action, value):
        if isinstance(action, argparse._SubParsersAction) and value not in action.choices:
            unknown_command(value, visible_choices(self), self.cmd_path)
        super()._check_value(action, value)

    def _print_message(self, message, file=None):
        """--help and --version text is collected and written by main(), which turns a reader that
        went away into a clean error. argparse writes it straight to stdout and, from Python 3.11,
        silently drops a write that fails; unbuffered (-u), 3.9 raised BrokenPipeError instead."""
        if message and file is sys.stdout:
            _HELP_TEXT.append(message)
        else:
            super()._print_message(message, file)

    def format_help(self):
        width = max((wrap_width() or HELP_WIDTH) - 2, 40)   # help is a table, not prose: off a terminal it keeps one fixed layout
        command = " ".join(self.cmd_path)
        sp = subparsers_of(self)
        blocks = [wrap_text("usage: " + usage_text(self), width, hang="    ")]
        if self.description:
            blocks.append(wrap_text(self.description, width))
        own = own_actions(self)
        if sp is not None and not self.cmd_path:
            rows = ["COMMANDS"]
            for title, names in COMMAND_GROUPS:
                rows.append("  " + title)
                rows.append(help_table([(n, COMMAND_SUMMARY[n]) for n in names], width, indent="    ", pad=12))
            blocks.append("\n".join(rows))
        elif sp is not None:
            rows = [(" ".join([n] + [positional_name(x, f"{command} {n}") for x in own_actions(sp.choices[n]) if not x.option_strings]),
                     sp.choices[n].description or "") for n in visible_choices(self)]
            blocks.append("ACTIONS\n" + help_table(rows, width))
        positionals = [x for x in own if not x.option_strings and x.help]
        if positionals:
            blocks.append("ARGUMENTS\n" + help_table([(positional_name(x, command, False), x.help) for x in positionals], width))
        if self.cmd_path == ("post",):
            blocks.append("KINDS (--kind)\n" + help_table([(k, KIND_MEANINGS[k]) for k in KINDS], width))
        helpers = [x for x in self._actions if isinstance(x, (argparse._HelpAction, argparse._VersionAction))]
        shown = helpers[:1] + [x for x in own if x.option_strings] + helpers[1:]
        if not self.cmd_path:
            shown = helpers[:1] + [x for x in self._actions if x.dest in GLOBAL_DESTS] + helpers[1:]
        rows = [(", ".join(x.option_strings) + ("" if x.nargs == 0 else " " + ("{" + ",".join(map(str, x.choices)) + "}" if x.choices else
                 (x.metavar if isinstance(x.metavar, str) else x.dest.upper()))), x.help or "") for x in shown]
        blocks.append("FLAGS\n" + help_table(rows, width))
        if self.cmd_path:
            blocks.append("INHERITED FLAGS\n" + help_table(list(INHERITED_FLAGS), width))
        examples = example_block(command)
        if examples:
            blocks.append("EXAMPLES\n" + examples)
        if not self.cmd_path:
            blocks.append("GETTING STARTED\n" + "\n".join("  " + line for line in GUIDE.split("\n")))
            blocks.append("LEARN MORE\n" + help_table([("agentbus help COMMAND", "Help and examples for one command"),
                                                       ("agentbus completion zsh", "Tab completion for bash, zsh or fish")], width))
        elif sp is not None:
            blocks.append(f"See: agentbus help {command} ACTION")
        if self.epilog:
            blocks.append(self.epilog)
        return "\n\n".join(blocks) + "\n"


def unknown_command(word, choices, path=()):
    matches = difflib.get_close_matches(word, choices, n=1)
    hint = f" Did you mean {matches[0]}?" if matches else ""
    see = "agentbus --help" if not path else "agentbus help " + " ".join(path)
    die(f"unknown command '{word}'.{hint} {'Commands' if not path else 'Actions'}: {', '.join(choices)}. See: {see}", "bad_input", next=see)


_HELP_TEXT = []


def limit_count(text):
    """An argparse type for --limit: a count, or -1 for all. Below -1 is a mistake, not a second way to say all."""
    v = integer(text)
    if v < -1:
        raise argparse.ArgumentTypeError("must be 0 or more, or -1 for all")
    return v


def request_id_arg(parser, replays=False):
    """--request-id on a write. One rule: repeating a command with the same token never repeats its effect."""
    parser.add_argument("--request-id", metavar="TOKEN", help=(
        "Retry safely: the same token and flags replay the first result, flagged duplicate." if replays else
        "Retry safely. Accepted so every write retries the same way; this command already does nothing the second time."))


class OneName(argparse.Action):
    """--to takes one name: a second --to would silently replace the first, so it is refused.
    Whether one was given is a flag on the namespace (a bool: refuse_bad_inputs checks every field's text)."""

    def __call__(self, parser, namespace, values, option_string=None):
        if getattr(namespace, "to_given", False):
            parser.error(f"{option_string} takes one name (got {getattr(namespace, self.dest)} and {values}). "
                         "Post once per name, or leave --to off to tell everyone.")
        namespace.to_given = True
        setattr(namespace, self.dest, values)


def limit_arg(parser, default=LISTING_LIMIT, what="rows"):
    parser.add_argument("--limit", type=limit_count, default=default, metavar="N",
                        help=f"At most this many {what} (default {default}). Use -1 for all.")


def register_join(sub):
    j = sub("join", help="Register yourself; refuses a name active in the last 30 min unless --takeover")
    j.add_argument("--tool", help="Tool running this session.")
    j.add_argument("--model", help="Model running this session.")
    j.add_argument("--cwd", help="Working directory for this session.")
    j.add_argument("--branch", help="Branch for this session.")
    j.add_argument("--role", help="What you do here (shown in who/watch).")
    j.add_argument("--takeover", action="store_true",
                   help="Rejoin a name active in the last 30 min (only your own); tool, model and role you leave out are kept.")
    request_id_arg(j, replays=True)


def register_leave(sub):
    request_id_arg(sub("leave", help="Leave the roster and release all your claims"))


