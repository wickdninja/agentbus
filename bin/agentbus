def cmd_skill(a):
    """Print the bundled skill (or the AGENTS.md block) exactly as embedded: not wrapped, not
    indented, so the output is byte-equal to skills/agentbus/SKILL.md."""
    text = AGENTS_SNIPPET if a.agents_md else SKILL_TEXT
