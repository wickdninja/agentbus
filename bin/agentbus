def register_ctx(sub):
    c = sub("ctx", help="Shared facts (key/value): lasting notes every agent can read")
    limit_arg(c, what="facts (get) or values (history)")
    actions = c.add_subparsers(dest="action", required=False, metavar="ACTION")
    for action, usage in (("set", "KEY VALUE"), ("get", "[KEY]"), ("history", "KEY")):
        description = {"set": "Set a shared fact and record its history.",
                       "get": "Get a fact, or list all facts.", "history": "Show the history of a fact."}[action]
        act = actions.add_parser(action, parents=[sub.common], help=description, description=description)
        act.add_argument("key", nargs="?" if action == "get" else None, metavar="KEY",
                         help="The fact's name, for example test-command." if action != "get" else "The fact's name; omit to list all facts.")
        if action == "set":
            act.add_argument("value", nargs="*", metavar="VALUE", help="The fact's value. Several words are joined; - reads it from stdin.")
            request_id_arg(act)
        else:
            act.add_argument("--limit", type=integer, default=argparse.SUPPRESS, metavar="N",
                             help=f"Maximum facts (get) or values (history); default {LISTING_LIMIT}. Use -1 for all.")
        if action == "history":
            act.add_argument("--before", metavar="NEXT", help="Older values than the previous page (its next value).")


