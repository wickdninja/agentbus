    j = sub("join", help="Register yourself; refuses a name active in the last 30 min unless --takeover")
    j.add_argument("--tool", help="Tool running this session.")
    j.add_argument("--model", help="Model running this session.")
    j.add_argument("--cwd", help="Working directory for this session.")
    j.add_argument("--branch", help="Branch for this session.")
    j.add_argument("--role", help="What you do here (shown in who/watch).")
