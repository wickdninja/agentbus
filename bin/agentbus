                              "backup": _STR, "info": _BOOL}, optional=("backup", "info")))}),
                      ["items_failed"], text='{"target": string, "scope": string, "dry_run": boolean, "changes": [{"path": string, '
                      '"detail": string, "action": string, "backup": string (only when a backup was saved), "info": boolean (true for a report about something that is not a file, such as the login shell)}]}',
                      retry={"class": "idempotent", "short": "safe to repeat",
                             "how": "a second run reports every change unchanged and writes nothing; a refusal exits 1 with the same object"},
                      base=_PLAIN_ERRORS),
        "doctor": _cmd("Check the installed tool, the bus, the skill and the AGENTS.md block; each problem names its fix",
                       _o({"agentbus": _STR, "path": _STR, "contract": _INT, "checks": _list(_ref("DoctorCheck")),
                           "fail": _INT, "warn": _INT}),
                       ["items_failed"], text='{"agentbus": string, "path": string, "contract": integer, "checks": [{"id": string, "status": '
                       '"ok" | "warn" | "fail" | "n/a", "detail": string, "fix": string or null, "hint": string or null, "scope": string (when it applies)}], '
                       '"fail": integer, "warn": integer}; exit 1 (items_failed) when fail > 0',
                       base=_PLAIN_ERRORS),
    },
}

for _e in CONTRACT["errors"].values():
    _e.setdefault("optional_fields", [])


def result_text(schema, brief=False):
    """A schema as one short phrase: {"id": integer}, [Agent], string or null. brief: only the
    keys, at most four ({id}, {resource, agent, purpose, ...})."""
    if "$ref" in schema:
        return schema["$ref"].rsplit("/", 1)[-1]
    if "anyOf" in schema:
        return " or ".join(result_text(s, brief) for s in schema["anyOf"])
    if "allOf" in schema:  # an object and the keys every result adds: it reads as the object
        return result_text(schema["allOf"][0], brief)
    t = schema.get("type")
    if isinstance(t, list):
        return " or ".join(t)
    if t == "array":
        return "[" + result_text(schema["items"], brief) + "]"
    if t == "object" and "required" in schema:
        keys = schema["required"]
        if brief:
            keys = [k for k in keys if k != "contract"]
            return "{" + ", ".join(keys if len(keys) <= 4 else keys[:3] + ["..."]) + "}"
        keys = [k for k in keys if k != "contract"]   # every result carries it (stated once, in --json's help)
        return "{" + ", ".join('"%s": %s' % (k, result_text(schema["properties"][k], brief)) for k in keys) + "}"
    return t or "any"


def help_line(entry):
    """The line each subcommand's --help ends with."""
    return "JSON result: %s. Retry: %s." % (entry.get("text") or result_text(entry["result"]), entry["retry"]["short"])


class ContractFormatter(argparse.HelpFormatter):
    """HelpFormatter that prints the registry's result line as it is, not re-wrapped."""

    def _fill_text(self, text, width, indent):
        if text.startswith("JSON result: "):
            return indent + text
        return super()._fill_text(text, width, indent)


GLOBAL_DESTS = ("as_", "json", "up")


def _arg_entry(action, notes):
    positional = not action.option_strings
    name = (action.metavar if isinstance(action.metavar, str) else action.dest) if positional else max(action.option_strings, key=len)
    e = {"name": name}
    if positional:
        e["positional"] = True
    if isinstance(action, (argparse._StoreTrueAction, argparse._StoreFalseAction)):
        e["type"] = "boolean"
    else:
        e["type"] = {integer: "integer", bus_level: "integer", limit_count: "integer", interval: "number"}.get(action.type, "string")
    if action.required or (positional and action.nargs is None):
        e["required"] = True
    if action.nargs in ("*", "+"):
        e["repeatable"] = True
    if action.choices:
        e["choices"] = list(action.choices)
    if action.default not in (None, argparse.SUPPRESS, False):
        e["default"] = action.default
    if action.help and action.help is not argparse.SUPPRESS:
        e["help"] = action.help
    e.update(notes.get(name, {}))
    return e


def parser_leaves(parser, prefix=()):
    """{command path: its parser} for every command that runs (not a group such as ctx)."""
    found = {}
    for action in parser._actions:
        if isinstance(action, argparse._SubParsersAction):
            for name, child in action.choices.items():
                if not prefix and name in CONTRACT["hidden"]:
                    continue
                found.update(parser_leaves(child, prefix + (name,)) or {prefix + (name,): child})
    return found


def contract_commands(parser):
    """The `commands` section: the registry's facts plus each command's arguments from the parser."""
    out = {}
    for path, leaf in parser_leaves(parser).items():
        name = " ".join(path)
        reg = CONTRACT["commands"][name]
        notes = CONTRACT["arg_notes"].get(name, {})
        args = [_arg_entry(a, notes) for a in leaf._actions
                if not isinstance(a, (argparse._HelpAction, argparse._SubParsersAction)) and a.dest not in GLOBAL_DESTS]
        errors = list(dict.fromkeys(reg["errors"]))
        out[name] = {"summary": reg["summary"], "args": args, "result": reg["result"], "errors": errors,
                     "retry": {k: v for k, v in reg["retry"].items() if k != "short"},
                     "exit_codes": sorted({0} | {CONTRACT["errors"][c]["exit"] for c in errors}), "help": help_line(reg)}
    return out


def apply_contract_help(parser):
    """End every command's --help with its registry line (called once, at the end of build_parser)."""
    for path, leaf in parser_leaves(parser).items():
        leaf.epilog = help_line(CONTRACT["commands"][" ".join(path)])
        leaf.formatter_class = ContractFormatter


def contract_main():
    """main(), with the exit status taken from the error code (Diag.status) and a crash made an
    internal error (exit 4) in both output modes. The one entry point that applies the mapping."""
    try:
        main()
        return
    except SystemExit as e:
        if not isinstance(e.code, Diag):
            raise
        failure = e.code
    except KeyboardInterrupt:
        if _CHANGED:
            again = f". Run: {_RERUN} to finish" if _RERUN else ""
            failure = Diag("interrupted before the command finished, after it had changed "
                           + ", ".join(dict.fromkeys(_CHANGED)) + again, "interrupted", _RERUN,
                           changed=list(dict.fromkeys(_CHANGED)), **({"rerun": _RERUN} if _RERUN else {}))
        else:
            failure = Diag("interrupted before the command finished", "interrupted")
    except Exception as e:
        if not _JSON_ERRORS:
            import traceback
            traceback.print_exc()
            raise SystemExit(CONTRACT["errors"]["internal"]["exit"])
        failure = Diag(str(e), "internal")
    try:
        sys.stderr.write(str(failure) + "\n")
        sys.stderr.flush()
    except OSError:
        pass
    raise SystemExit(failure.status)


def _write_fd(fd, data):
    try:
        while data:
            data = data[os.write(fd, data):]
    except OSError:
        pass


def exit_now(msg, code, grace=None, next=None, **fields):
    """Write the diagnostic and end the process at once with the status of `code`, without closing SQLite
    connections, within `grace` seconds even when stderr is a full pipe nobody reads (the write
    runs in a helper thread; the exit does not wait for it past grace). Exiting releases every
    lock the process holds."""
    d = Diag(msg, code, next, **fields)
    t = threading.Thread(target=_write_fd, args=(2, (str(d) + "\n").encode("utf-8", "replace")), daemon=True)
    t.start()
    t.join(EXIT_GRACE_S if grace is None else grace)
    os._exit(d.status)


def die_now(msg, code):
    """Exit at once, without closing SQLite connections: used when SQLite may hold a file that is
    not our bus. A normal close checkpoints and can truncate or rewrite the -wal it holds, which
    would then be the victim file; the kernel closing the fds at exit writes nothing."""
    exit_now(msg, code)


# Every Bus connection open in this process. While one is, nothing is written to stdout or stderr:
# a notice is queued and printed after the last one closes, so a full pipe never holds the lock.
_HELD = []
_NOTES = []


def note(msg):
    """A notice on stderr (never on stdout, which --json keeps for one JSON value); queued while a
    bus is open."""
    if _HELD or _JSON_ERRORS:
        _NOTES.append(msg)
        return
    sys.stderr.write(diag(msg) + "\n")


def flush_notes():
    """Print the queued notices, once no bus is open."""
    while _NOTES and not _HELD:
        sys.stderr.write(diag(_NOTES.pop(0)) + "\n")


# The phases of opening a bus that block outside SQL, where the query budget cannot reach
# (connecting, the first read, SQLite's own opens of -wal, a hot -journal or a super-journal it
# names), run under this watchdog: a lane that plants a FIFO at bus.db-journal makes SQLite's open
# of it block forever, and the hung command would hold the exclusive lock with it. 6 s, the same as
# QUERY_BUDGET_S and for the same reason (see there): an honest open does no work in proportion to
# the bus except reading the -wal once (a -wal of several GB before it comes near), and a hung
# command must be gone well inside the 15 s another agent retries for, on a slow machine too, so
# that agent then gets the bus instead of failing busy.
OPEN_BUDGET_S = 6.0


def open_budget():
    """OPEN_BUDGET_S. Test hook: AGENTBUS_TEST_OPEN_BUDGET=<seconds> can only shorten it."""
    try:
        v = float(os.environ.get("AGENTBUS_TEST_OPEN_BUDGET", ""))
    except ValueError:
        return OPEN_BUDGET_S
    return min(max(v, 0.1), OPEN_BUDGET_S) if math.isfinite(v) else OPEN_BUDGET_S


class Watchdog:
    """One daemon thread. While armed, it ends the process (exit_now) once the deadline passes;
    the main thread may be blocked in a system call no signal handler or progress handler reaches."""

    def __init__(self):
        self.cond = threading.Condition()
        self.deadline = None
        self.why = None
        self.why_committing = None
        self.thread = None

    def arm(self, seconds, why, why_committing=None):
        """why_committing: what to say instead when the process is stopped during a COMMIT (_IN_COMMIT)."""
        with self.cond:
            self.deadline, self.why, self.why_committing = time.monotonic() + seconds, why, why_committing
            if self.thread is None:
                self.thread = threading.Thread(target=self._run, name="agentbus-watchdog", daemon=True)
                self.thread.start()
            self.cond.notify()

    def disarm(self):
        with self.cond:
            self.deadline = None
            self.cond.notify()

    @contextmanager
    def suspended(self):
        """A test pause stops the clock, so a test holding a command at a pause point inside a
        watched phase is not taken for a hang."""
        with self.cond:
            left = None if self.deadline is None else self.deadline - time.monotonic()
            self.deadline = None
            self.cond.notify()
        try:
            yield
        finally:
            if left is not None:
                self.arm(max(left, 0.0), self.why, self.why_committing)

    def _run(self):
        global _WROTE, _WROTE_ROWS
        # The kernel may deliver a process signal (Ctrl-C) to any thread that does not block it (POSIX
        # allows it; macOS and BSD do it). Python runs the handler only when the main thread next runs
        # bytecode, which for watch, asleep in select() for up to its interval, is too late. Blocked
        # here, signals reach the main thread and interrupt its system call.
        import signal
        if hasattr(signal, "pthread_sigmask"):
            signal.pthread_sigmask(signal.SIG_BLOCK, signal.valid_signals())
        with self.cond:
            while True:
                if self.deadline is None:
                    self.cond.wait()
                    continue
                left = self.deadline - time.monotonic()
                if left > 0:
                    self.cond.wait(left)
                    continue
                why, why_committing = self.why, self.why_committing
                break
        # Stopped inside a COMMIT: what SQLite had written by now is not knowable from here (a process stuck in
        # fsync cannot say), so the write may be saved. Read once, before the cleanups run.
        committing = _IN_COMMIT
        if committing and why_committing:
            why = why_committing
        for undo in list(_KILL_CLEANUP):  # put back what a stopped migration had changed
            try:
                said = undo()
                if isinstance(said, str):
                    why = said  # what really happened (a migration that committed first)
            except Exception:
                pass
        fields = {}
        if committing:
            fields["outcome_unknown"] = True
            if committing == "own":
                _WROTE = _WROTE_ROWS = True  # possibly saved counts as saved: no repeat without a --request-id
        exit_now(why, "bus_unavailable", **fields)


WATCHDOG = Watchdog()
# Cleanups the watchdog runs before it ends the process (a migration's undo).
_KILL_CLEANUP = []


@contextmanager
def watched(seconds, why):
    WATCHDOG.arm(seconds, why)
    try:
        yield
    finally:
        WATCHDOG.disarm()


# Test hooks, active only when their AGENTBUS_TEST_* variable is set; they never run otherwise.
_HOOK_GUARD = None  # the running hook's whole-hook timer (hook_run), so a test pause can stop it


def _test_pause(point):
    """Test hook: AGENTBUS_TEST_PAUSE=<point>=<dir> stops here until <dir>/<point>.go exists, after
    creating <dir>/<point>.reached (O_EXCL|O_NOFOLLOW: never through a planted link). Only pauses;
    it changes nothing. Used to make races deterministic."""
    spec = next((x for x in os.environ.get("AGENTBUS_TEST_PAUSE", "").split(";") if x.startswith(point + "=")), "")
    if not spec:
        return
    d = spec.split("=", 1)[1]
    if not (os.path.isabs(d) and os.path.isdir(d)):
        return  # a pause point names an existing absolute folder; anything else (empty, relative) does nothing
    if _HOOK_GUARD is not None:
        _HOOK_GUARD.cancel()  # a hook held at a test pause is not a hung hook
    mark = os.path.join(d, point + ".reached")
    flags = os.O_WRONLY | os.O_CREAT | os.O_EXCL | NOFOLLOW
    try:
        os.close(os.open(mark, flags, 0o600))
    except FileExistsError:  # reached before, by this or an earlier command: a fresh mark
        os.unlink(mark)
        os.close(os.open(mark, flags, 0o600))
    with WATCHDOG.suspended():
        deadline = time.time() + 60
        while not os.path.exists(os.path.join(d, point + ".go")) and time.time() < deadline:
            time.sleep(0.02)


def _test_fail(point):
    """Test hook: AGENTBUS_TEST_FAIL=<point> makes the command fail there, as a real fault would:
    parse (bad arguments), open (the bus cannot be opened), before-emit (a database error after the
    command ran, before any output), emit (stdout cannot be written), ack (inbox cannot mark messages
    read), touch (the last-seen refresh fails), internal (a bug). tests/test_failure_phases.sh and test_exit_codes.sh use it."""
    if os.environ.get("AGENTBUS_TEST_FAIL") != point:
        return
    if point == "parse":
        die("injected parse failure", "bad_input")
    if point == "open":
        die("injected open failure", "bus_unavailable")
    if point == "before-emit":
        raise sqlite3.OperationalError("injected failure before output")
    if point == "emit":
        raise BrokenPipeError(errno.EPIPE, "injected")
    if point in ("ack", "touch"):
        raise sqlite3.OperationalError("injected " + point + " failure")
    raise RuntimeError("injected internal failure")


def _test_stall_commit():
    """Test hook: AGENTBUS_TEST_STALL_COMMIT=<seconds> sleeps just before the COMMIT of pending rows, with the clock
    running, as a COMMIT stuck in fsync on a stalled disk would. It only sleeps."""
    v = os.environ.get("AGENTBUS_TEST_STALL_COMMIT")
    if v:
        time.sleep(float(v))


def _test_slow():
    """Test hook: AGENTBUS_TEST_SLOW=<seconds> stalls the command in Python with the bus held (the
    clock keeps running, unlike a pause), as a slow loop over planted rows would."""
    v = os.environ.get("AGENTBUS_TEST_SLOW")
    if v:
        time.sleep(float(v))


# ---------- link-safe file handling ----------

NOFOLLOW = getattr(os, "O_NOFOLLOW", 0)
# Every path a lane can write is opened with O_NONBLOCK too: a FIFO swapped in after check_node
# would otherwise block the open (and the exclusive lock with it) forever, before any fstat.
NONBLOCK = getattr(os, "O_NONBLOCK", 0)


def _ident(st):
    return (st.st_dev, st.st_ino)


def _owned(st):
    return not hasattr(os, "getuid") or st.st_uid == os.getuid()


def check_node(path, kind, must_exist=False, optional=False):
    """Refuse a path that is a symlink, the wrong type, not owned by the caller or (for files)
    hard-linked elsewhere. kind is "file" or "dir". A sandboxed lane can write the .agentbus folder,
    so it can plant links there; the brain must never follow one. Returns False if absent. With
    optional=True (a bus file), a file caught mid-unlink (0 links: SQLite deleting -wal on another
    connection's last close) raises _Vanished, so open_bus retries instead of refusing."""
    try:
        st = os.lstat(path)
    except FileNotFoundError:
        if must_exist:
            die(f"{path} is missing", "bus_unavailable", file=path)
        return False
    if stat.S_ISLNK(st.st_mode):
        die(f"refusing {path}: it is a symlink", "bus_unavailable", file=path)
    if kind == "dir" and not stat.S_ISDIR(st.st_mode):
        die(f"refusing {path}: not a directory", "bus_unavailable", file=path)
    if kind == "file" and not stat.S_ISREG(st.st_mode):
        die(f"refusing {path}: not a regular file", "bus_unavailable", file=path)
    if not _owned(st):
        die(f"refusing {path}: owned by another user", "bus_unavailable", file=path)
    if kind == "file" and st.st_nlink == 0 and optional:
        raise _Vanished(path)
    if kind == "file" and st.st_nlink != 1:
        die(f"refusing {path}: it has {st.st_nlink} hard links", "bus_unavailable", file=path)
    return st


def make_dir(path):
    """mkdir 0700, tolerating a concurrent caller that made it first, then validate what is there.
    Returns its lstat."""
    try:
        os.mkdir(path, 0o700)
    except FileExistsError:
        pass
    return check_node(path, "dir", must_exist=True)


class _Vanished(Exception):
    """An optional bus file vanished or was replaced between its check and its open: an ordinary
    race with another connection closing (SQLite deletes -wal on the last close). Validation starts
    over inside open_bus's retry budget."""


def chmod_nofollow(path, mode, kind, expect, optional=False):
    """chmod through an fd opened with O_NOFOLLOW, so a symlink swapped in after the check is refused
    by the kernel instead of followed. `expect` is check_node's lstat of the path: the opened node
    must be that same node (device and inode) and, for a file, still have one link, so a hard link
    swapped in after the check is refused too instead of having its outside target chmodded.
    With optional=True (a bus file), a node that vanished or was replaced by another single-link
    file raises _Vanished instead of exiting."""
    flags = os.O_RDONLY | NOFOLLOW | NONBLOCK
    if kind == "dir":
        flags |= getattr(os, "O_DIRECTORY", 0)
    _test_pause("before-chmod-" + os.path.basename(path))
    try:
        fd = os.open(path, flags)
    except FileNotFoundError as e:
        if optional:
            raise _Vanished(path)
        die(f"refusing {path}: {e.strerror}", "bus_unavailable", file=path)
    except OSError as e:
        die(f"refusing {path}: {e.strerror}", "bus_unavailable", file=path)
    try:
        _test_pause("after-chmod-open-" + os.path.basename(path))
        st = os.fstat(fd)
        if kind == "file" and not stat.S_ISREG(st.st_mode):
            die(f"refusing {path}: not a regular file (it changed while opening)", "bus_unavailable", file=path)
        if (kind == "dir") != stat.S_ISDIR(st.st_mode) or not _owned(st):
            die(f"refusing {path}: changed while opening", "bus_unavailable", file=path)
        if optional and st.st_nlink == 0:
            raise _Vanished(path)  # unlinked after our open (SQLite deleting -wal on its last close)
        if kind == "file" and st.st_nlink != 1:
            die(f"refusing {path}: it has {st.st_nlink} hard links", "bus_unavailable", file=path)
        if _ident(st) != _ident(expect):
            if optional:
                raise _Vanished(path)
            die(f"refusing {path}: changed while opening", "bus_unavailable", file=path)
        os.fchmod(fd, mode)
    finally:
        os.close(fd)


def write_atomic(path, data, mode):
    """Replace path with data: a fresh, randomly named temp file in the same folder, created with
    O_CREAT|O_EXCL|O_NOFOLLOW (never an existing file or link), then os.replace."""
    d = os.path.dirname(path)
    tmp = os.path.join(d, f".{os.path.basename(path)}.{secrets.token_hex(8)}.tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | NOFOLLOW, mode)
    try:
        with os.fdopen(fd, "wb") as f:
            os.fchmod(f.fileno(), mode)
            f.write(data)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


SMALL = 4096  # VERSION: a version line
TEXT_LIMIT = 1 << 20  # info/exclude and .gitignore, read only to look for the .agentbus rule


COPY_LIMIT = 16 << 20  # a bus folder's copy of agentbus, read to keep beside a backup


def read_small(path, limit=SMALL):
    """At most `limit` bytes of a text file, as text: opened without following a symlink and
    without blocking (a FIFO swapped in after the caller's check never hangs the read), then
    refused unless fstat says it is a regular file owned by the caller."""
    return _read_file(path, limit).decode("utf-8", "replace")


def _read_file(path, limit):
    """read_small's bytes."""
    _test_pause("before-read-" + os.path.basename(path))
    fd = os.open(path, os.O_RDONLY | NOFOLLOW | NONBLOCK)
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            die(f"refusing {path}: not a regular file", "bus_unavailable", file=path)
        if not _owned(st):
            die(f"refusing {path}: owned by another user", "bus_unavailable", file=path)
        data = b""
        while len(data) < limit:
            chunk = os.read(fd, limit - len(data))
            if not chunk:
                break
            data += chunk
    finally:
        os.close(fd)
    return data


# ---------- git ----------

def git(args, cwd=None, timeout=10):
    try:
        return subprocess.run(["git", *args], capture_output=True, text=True, timeout=timeout, cwd=cwd)
    except (OSError, subprocess.SubprocessError):
        return None


_GIT_OK = None


def have_git():
    """False when git is not installed. Dies when it is older than MIN_GIT: rev-parse
    --path-format=absolute (2.31) is load-bearing, and older git echoes the flag back as output."""
    global _GIT_OK
    if _GIT_OK is None:
        r = git(["--version"])
        if r is None or r.returncode != 0:
            _GIT_OK = False
        else:
            m = re.search(r"(\d+)\.(\d+)", r.stdout)
            if not m or (int(m.group(1)), int(m.group(2))) < MIN_GIT:
                die("needs git %d.%d or newer (found: %s)" % (MIN_GIT + (r.stdout.strip() or "unknown",)), "no_bus")
            _GIT_OK = True
    return _GIT_OK


def repo_info(path=None):
    """(main checkout, its info/exclude path) for the git repository at `path` (default: cwd), or
    None outside a work tree. Every worktree of one repo maps to the same checkout, including repos
    whose git dir is not named .git (--separate-git-dir, submodules and their worktrees).
    A linked worktree of a --separate-git-dir repo, or of a bare repository, has no main checkout
    git can name (git's own `worktree list` reports the git dir there), so it refuses."""
    if not have_git():
        return None
    r = git(["rev-parse", "--path-format=absolute", "--git-dir", "--git-common-dir", "--show-toplevel"],
            cwd=path, timeout=5)
    if r is None or r.returncode != 0:
        return None
    lines = r.stdout.strip().splitlines()
    if len(lines) != 3 or lines[0].startswith("--"):
        die("needs git %d.%d or newer (rev-parse --path-format=absolute is not supported)" % MIN_GIT, "no_bus")
    gitdir, common, top = (os.path.realpath(x) for x in lines)
    # Not `rev-parse --git-path info/exclude`: git resolves a symlinked exclude to its target.
    exclude = os.path.join(common, "info", "exclude")
    if gitdir == common:
        return top, exclude  # the main worktree itself
    if os.path.basename(common) == ".git":
        return os.path.dirname(common), exclude
    wt = git(["--git-dir", common, "config", "--get", "core.worktree"])
    if wt is not None and wt.returncode == 0 and wt.stdout.strip():
        return os.path.realpath(os.path.join(common, wt.stdout.strip())), exclude  # a submodule
    die(f"cannot find the main checkout for this worktree: its git dir {common} records none "
        "(a linked worktree of a --separate-git-dir or bare repository). Set AGENTBUS_DB to "
        "<main checkout>/.agentbus/bus.db.", "no_bus")


def repo_root(path=None):
    info = repo_info(path)
    return info[0] if info else None


def self_path():
    return os.path.realpath(__file__)


def is_repo_local_copy():
    """True when this script is a project's own copy (<repo>/.agentbus/bin/agentbus)."""
    return os.path.basename(os.path.dirname(os.path.dirname(self_path()))) == ".agentbus"


def source_version():
    """'<sha> <commit date>' when this script is tracked in a git checkout of the source repo (+dirty
    with uncommitted changes), else the release version (an installed package)."""
    here = os.path.dirname(self_path())
    def g(*a):
        r = git(["-C", here, *a])
        return r.stdout.strip() if r is not None and r.returncode == 0 else ""
    if not have_git() or not g("ls-files", "--error-unmatch", "--", self_path()):
        return __version__
    out = g("log", "-1", "--format=%H %cI")
    if not out:
        return __version__
    if g("status", "--porcelain", "--", self_path()):
        out += " +dirty"
    return out


_RULES = (".agentbus", ".agentbus/", "/.agentbus", "/.agentbus/")


def gitignore_has_rule(root):
    """True when the worktree's .gitignore (a file a lane can write) has the rule. Read like any
    lane-writable file: no symlink followed, never blocking, regular files only; anything else
    counts as no rule (the rule then goes in info/exclude)."""
    gi = os.path.join(root, ".gitignore")
    try:
        fd = os.open(gi, os.O_RDONLY | NOFOLLOW | NONBLOCK)
    except OSError:
        return False
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            return False
        text = os.read(fd, TEXT_LIMIT).decode("utf-8", "replace")
    except OSError:
        return False
    finally:
        os.close(fd)
    return any(line.strip() in _RULES for line in text.splitlines())


def ensure_exclude(exclude):
    """Add .agentbus/ to the repo's info/exclude (local, never dirties the tree), never through a
    symlinked info/ or exclude. Returns True when it added the rule."""
    info = os.path.dirname(exclude)
    if not check_node(info, "dir"):
        make_dir(info)
    text = read_small(exclude, TEXT_LIMIT) if check_node(exclude, "file") else ""
    if any(line.strip() in _RULES for line in text.splitlines()):
        return False
    _test_pause("before-exclude-append")
    # Opened like every lane-writable path (no link followed, never blocking: a FIFO swapped in
    # after the read is refused, not waited on), then refused unless it is still a single-link
    # regular file owned by the caller.
    try:
        fd = os.open(exclude, os.O_RDWR | os.O_APPEND | os.O_CREAT | NOFOLLOW | NONBLOCK, 0o644)
    except OSError as e:
        die(f"refusing {exclude}: {e.strerror}", "bus_unavailable")
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode):
            die(f"refusing {exclude}: not a regular file (it changed while opening)", "bus_unavailable")
        if not _owned(st):
            die(f"refusing {exclude}: owned by another user", "bus_unavailable")
        if st.st_nlink != 1:
            die(f"refusing {exclude}: it has {st.st_nlink} hard links", "bus_unavailable")
        # Concurrent first uses: an exclusive flock, then the file read again through this fd, so
        # only the first of them appends the rule. Never waited on for long: a lock nobody
        # releases makes this a refusal (a notice for an ordinary command).
        lock_briefly(fd, exclude)
        os.lseek(fd, 0, os.SEEK_SET)
        text = _read_fd(fd, TEXT_LIMIT).decode("utf-8", "replace")
        if any(line.strip() in _RULES for line in text.splitlines()):
            return False
        _write_fd_all(fd, (("" if not text or text.endswith("\n") else "\n") + ".agentbus/\n").encode())
    finally:
        os.close(fd)  # drops the flock
    return True


def lock_briefly(fd, path, seconds=2.0):
    """An exclusive flock on fd, retried for at most `seconds`."""
    deadline = time.monotonic() + seconds
    while True:
        try:
            fcntl.flock(fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return
        except BlockingIOError:
            if time.monotonic() > deadline:
                die(f"refusing {path}: another process keeps it locked", "busy", bus=str(path))
            time.sleep(0.01)


def _read_fd(fd, limit):
    data = b""
    while len(data) < limit:
        chunk = os.read(fd, limit - len(data))
        if not chunk:
            break
        data += chunk
    return data


def _write_fd_all(fd, data):
    while data:
        data = data[os.write(fd, data):]


def keep_excluded(root, exclude):
    """ensure_exclude for an ordinary command: nothing to do when .gitignore or info/exclude already
    has the rule, and a refused write (a sandboxed lane cannot write .git) is a notice, never fatal.
    Returns True when it added the rule."""
    try:
        if gitignore_has_rule(root):
            return False
        return ensure_exclude(exclude)
    except OSError as e:
        note(f"could not add .agentbus/ to {exclude} ({e.strerror or e}); add it there or to .gitignore")
    except SystemExit as e:  # refused: a link, a FIFO, another owner
        note(f"could not add .agentbus/ to {exclude} ({reason(e)}); add it there or to .gitignore")
    return False


# ---------- install ----------

def install_copy(root):
    """Copy this script to <root>/.agentbus/bin/agentbus (0700) and write VERSION. Returns (old, new).
    Refuses if .agentbus, bin, VERSION or bin/agentbus is a symlink or the wrong type: a lane that
    can write .agentbus could otherwise point VERSION or bin at a file outside it."""
    folder = os.path.join(root, ".agentbus")
    bindir = os.path.join(folder, "bin")
    vfile = os.path.join(folder, "VERSION")
    dest = os.path.join(bindir, "agentbus")
    if os.path.lexists(folder):
        refuse_downgrade(root)
    for d in (folder, bindir):
        chmod_nofollow(d, 0o700, "dir", make_dir(d))
    check_node(dest, "file")
    old = read_small(vfile).strip() if check_node(vfile, "file") else "none"
    with open(self_path(), "rb") as f:
        code = f.read()
    if os.environ.get("AGENTBUS_TEST_INSTALL_FAIL") == "eperm":  # test hook: bin/ made immutable (chflags uchg)
        raise PermissionError(errno.EPERM, os.strerror(errno.EPERM), dest)
    write_atomic(dest, code, 0o700)
    file_changed(dest)
    new = source_version()
    write_atomic(vfile, (new + "\n").encode(), 0o600)
    file_changed(vfile)
    return old, new


def refuse_downgrade(root):
    """Never replace a newer copy: refuse (copy_newer) when the folder's VERSION is a release newer
    than this tool, and (schema_newer) when its bus has a schema this tool does not know. The bus is
    read without a write; a bus that cannot be read now (busy) is refused too, never guessed at."""
    folder = os.path.join(root, ".agentbus")
    check_node(folder, "dir")
    vfile = os.path.join(folder, "VERSION")
    old = read_small(vfile).strip() if check_node(vfile, "file") else ""
    mine, theirs = release_key(__version__), release_key(old)
    if mine is not None and theirs is not None and theirs > mine:
        die(f"{root}: its copy of agentbus ({old}) is newer than this one ({__version__}); nothing was changed. "
            "Upgrade it with a newer agentbus", "copy_newer", directory=root, copy_version=old, tool_version=__version__)
    schema_probe(os.path.join(folder, "bus.db"))  # raises schema_newer (or busy) before anything is written


# The VERSION formats agentbus itself writes (source_version): a release (0.1.0, 0.2.0rc1,
# 1.0.0.dev3, 1.0.0+local), or a source checkout's commit (SHA-1 or SHA-256) and its committer
# date as git's %cI prints it, then " +dirty" when it had uncommitted changes.
_SHOWN_VERSION = re.compile(
    r"[0-9]{1,6}(?:\.[0-9]{1,6}){1,3}(?:(?:a|b|rc)[0-9]{1,6})?(?:\.post[0-9]{1,6})?(?:\.dev[0-9]{1,6})?"
    r"(?:\+[a-z0-9]{1,20}(?:\.[a-z0-9]{1,20}){0,4})?"
    r"|[0-9a-f]{40}(?:[0-9a-f]{24})? [0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:Z|[+-][0-9]{2}:[0-9]{2})"
    r"(?: \+dirty)?"
    r"|none")  # what init reports when there was no VERSION


def shown_version(v):
    """A repo's old VERSION (a file a lane can write) as init and upgrade print it: as written when it
    is one of the formats agentbus writes, else a placeholder. Nothing else a lane put there is
    printed, so it cannot carry a forged row (`agentbus: refusing ...`, `#99 ...`) however the line
    wraps."""
    return v if _SHOWN_VERSION.fullmatch(v) else "(VERSION is not a version)"


_RELEASE = re.compile(r"([0-9]{1,6}(?:\.[0-9]{1,6}){1,3})(?:(a|b|rc)([0-9]{1,6}))?(?:\.post([0-9]{1,6}))?"
                      r"(?:\.dev([0-9]{1,6}))?(?:\+[a-z0-9]{1,20}(?:\.[a-z0-9]{1,20}){0,4})?")


def release_key(v):
    """A sortable key for a release version (PEP 440 order for the forms agentbus writes:
    1.0.dev1 < 1.0a1 < 1.0rc1 < 1.0 < 1.0.post1), or None when v is not one (a commit, junk)."""
    m = _RELEASE.fullmatch(v or "")
    if not m:
        return None
    nums, pre, pre_n, post, dev = m.groups()
    release = tuple(int(x) for x in nums.split(".")) + (0,) * (4 - len(nums.split(".")))
    if pre:
        pre_key = (0, ("a", "b", "rc").index(pre), int(pre_n))
    elif dev and not post:
        pre_key = (-1, 0, 0)
    else:
        pre_key = (1, 0, 0)
    return (release, pre_key, int(post) if post else -1, int(dev) if dev else math.inf)


def bus_copy_version(db_path):
    """The release version of the copy in the bus folder holding db_path (.agentbus/VERSION), or None:
    no such folder or file, a VERSION that is a source commit or not a version, or a file that is a
    link or not the caller's. Reads one small file, never the database."""
    folder = os.path.dirname(db_path)
    if os.path.basename(folder) != ".agentbus":
        return None
    vfile = os.path.join(folder, "VERSION")
    try:
        if not check_node(vfile, "file"):
            return None
        v = read_small(vfile).strip()
    except (SystemExit, OSError):
        return None
    return v if release_key(v) is not None else None


def make_target(root):
    """init's DIR: an existing directory is used as is; one that does not exist is created with its
    missing parents (mkdir -p), unless the nearest existing parent is not a writable directory
    (bad_input, nothing created). A path that exists but is not a directory is refused. Returns the
    folders it created, outermost first."""
    if os.path.isdir(root):
        return []
    if os.path.lexists(root):
        die(f"not a directory: {root}. Pick a folder: agentbus init DIR", "bad_input", next="agentbus init DIR")
    near = os.path.dirname(root)
    while not os.path.lexists(near) and near != os.path.dirname(near):
        near = os.path.dirname(near)
    if not os.path.isdir(near):
        die(f"cannot create {root}: {near} is not a directory. Pick another path: agentbus init DIR", "bad_input", next="agentbus init DIR")
    if not os.access(near, os.W_OK | os.X_OK):
        die(f"cannot create {root}: {near} is not writable. Create the folder yourself, or pick a path you can write to", "bad_input")
    missing = []
    d = root
    while d != near:
        missing.append(d)
        d = os.path.dirname(d)
    for d in reversed(missing):
        try:
            os.mkdir(d)
        except FileExistsError:
            pass
        except OSError as e:
            die(f"cannot create {d}: {e.strerror}", "bad_input")
        file_changed(d)
    return list(reversed(missing))


def setup_detected():
    """True when this machine's Claude Code or Codex already has agentbus set up (the skill or the AGENTS.md block, in
    your own config or the current project's). Anything unreadable counts as not detected."""
    for target in sorted(SETUP_TARGETS):
        for scope in ("user", "project"):
            try:
                if any(code in ("ok", "stale") for _id, code, _detail, _fix in SETUP_TARGETS[target][0].check(scope)):
                    return True
            except (OSError, ValueError, KeyError):
                continue
    return False


def cmd_init(a):
    if is_repo_local_copy():
        die("init runs from the installed agentbus or a clone of its repo, not a project copy. Run: agentbus init DIR", "bad_input", next="agentbus init DIR")
    root = os.path.realpath(os.path.abspath(os.path.expanduser(a.repo or os.getcwd())))
    made = make_target(root)
    info = repo_info(root)
    if info and os.path.realpath(info[0]) != root:
        top = git(["rev-parse", "--show-toplevel"], cwd=root)
        if top and top.returncode == 0 and os.path.realpath(top.stdout.strip()) == root:
            die(f"{root} is a linked worktree; its commands use the main checkout's bus. Run: agentbus init {info[0]}", "bad_input", next=f"agentbus init {info[0]}")
    # Only a checkout's top level gets an exclude rule; an arbitrary directory is a workspace.
    top = git(["rev-parse", "--show-toplevel"], cwd=root) if info else None
    exclude = info[1] if top and top.returncode == 0 and os.path.realpath(top.stdout.strip()) == root else None
    parent = os.path.dirname(root)
    outer = next(walk_buses(parent), None) if parent != root else None
    folder = os.path.join(root, ".agentbus")
    say = (lambda *x, **k: None) if a.json else show
    global _RERUN
    _RERUN = "agentbus init " + root
    old, new = install_copy(root)
    record_buses(buses=[root])
    version = shown_version(new)
    if re.fullmatch(r"[0-9a-f]{40}(?:[0-9a-f]{24})? .*", version):
        version = version[:7] + (" +dirty" if version.endswith(" +dirty") else "")
    if made:
        say("created {}", tilde(root))
    say("installed agentbus {} into {}/.agentbus/", version, tilde(root))
    added = ensure_exclude(exclude) if exclude else False
    if added:
        file_changed(exclude)
    shared = gitignore_has_rule(root) if exclude else False
    if added:
        say("added .agentbus/ to {} (local only; the repo stays clean)", tilde(exclude))
    if exclude and not shared:
        say("optional: add `.agentbus/` to .gitignore to share that rule")
    if outer:
        say("outer bus: {}", tilde(outer))
    say("next: cd {}", tilde(root))
    say("next: .agentbus/bin/agentbus --as YOUR_NAME join")
    if not setup_detected():
        say("next: agentbus setup claude (teaches Claude Code the protocol)")
        say("next: agentbus setup codex (teaches Codex the protocol)")
    if a.json:
        print_json({"directory": root, "copy": os.path.join(folder, "bin", "agentbus"), "old": old, "new": new,
                    "exclude_added": added, "gitignore_rule": shared, "outer": outer})


# While upgrade runs: every migration it started (_Undo), so a Ctrl-C after one committed says what was
# done and how to finish. None for every other command.
_UPGRADE_MIGRATIONS = None


def cmd_upgrade(a):
    """Replace a bus folder's copy of the tool and migrate its database: DIR's, or by default the
    nearest bus's (found the way every command finds its bus); with --all, every bus folder under DIR.
    Works for a repo or a workspace folder alike. A Ctrl-C after a migration committed is the
    interrupted error naming each migration, its backup and the command that finishes the job."""
    global _UPGRADE_MIGRATIONS
    _UPGRADE_MIGRATIONS = []
    try:
        _cmd_upgrade(a)
    except KeyboardInterrupt:
        done = [u for u in _UPGRADE_MIGRATIONS if u.committed and u.summary]
        # The bus folders whose copy (or VERSION) this run had already replaced: install_copy records each file.
        mark = os.sep + ".agentbus" + os.sep
        copies = list(dict.fromkeys(p.split(mark, 1)[0] for p in _CHANGED if mark in p))
        if not done and not copies:
            raise
        where = [bus_directory(u.bus) for u in done]
        last = copies[-1] if copies else where[-1]
        if a.all and a.repo:
            again = "agentbus upgrade --all " + os.path.realpath(os.path.abspath(os.path.expanduser(a.repo)))
        else:
            again = "agentbus upgrade " + last
        said = []
        if done:
            what = "; ".join(f"{d} ({u.summary})" for d, u in zip(where, done))
            said.append(f"interrupted after the bus was migrated: {what}. "
                        + ("Its copy of agentbus may not have been replaced yet. " if not copies else ""))
        if copies:
            said.append(("Then" if done else "interrupted after") + " the copy of agentbus was replaced in "
                        + ", ".join(copies) + ". ")
        die("".join(said) + f"Run: {again} to finish", "interrupted", next=again, directory=last,
            backup=done[-1].backup if done else None,
            migrations=[{"directory": d, "schema_old": u.schema[0], "schema_new": u.schema[1], "backup": u.backup}
                        for d, u in zip(where, done)], rerun=again, changed=list(dict.fromkeys(_CHANGED)))


def _cmd_upgrade(a):
    if is_repo_local_copy():
        die("upgrade runs from the installed agentbus or a clone of its repo; this is a project copy. Run: agentbus upgrade DIR", "bad_input", next="agentbus upgrade DIR")
    if a.depth < 0:
        die("--depth must be 0 or more. For example: agentbus upgrade --all DIR --depth 3", "bad_input", next="agentbus upgrade --all DIR --depth 3")
    if a.all:
        if not a.repo:
            die("upgrade --all needs a directory: agentbus upgrade --all DIR", "bad_input", next="agentbus upgrade --all DIR")
        top = os.path.realpath(os.path.abspath(os.path.expanduser(a.repo)))
        if not os.path.isdir(top):
            die(f"not a directory: {top}. Pass a folder: agentbus upgrade --all DIR", "bad_input", next="agentbus upgrade --all DIR")
        rows = [upgrade_one(d, a.dry_run, top) for d in find_bus_dirs(top, a.depth)]
        if not a.dry_run:
            record_buses(buses=[r["directory"] for r in rows if r["status"] in ("upgraded", "current")])
        report_upgrades(a, rows)
        return
    if a.repo:
        root = os.path.realpath(os.path.abspath(os.path.expanduser(a.repo)))
        info = repo_info(root)
        if info and os.path.realpath(info[0]) != root:
            top = git(["rev-parse", "--show-toplevel"], cwd=root)
            if top and top.returncode == 0 and os.path.realpath(top.stdout.strip()) == root:
                root = os.path.realpath(info[0])  # a linked worktree: its bus is the main checkout's
    else:
        root = selected_bus(getattr(a, "up", 0))
    if not (check_node(os.path.join(root, ".agentbus"), "dir") and check_node(os.path.join(root, ".agentbus", "bin"), "dir")
            and check_node(os.path.join(root, ".agentbus", "bin", "agentbus"), "file")):
        die(f"{root} has no .agentbus/bin/agentbus. Run: agentbus init {root}", "no_bus", next=f"agentbus init {root}")
    if a.dry_run:
        report_upgrades(a, [upgrade_one(root, True)])
        return
    refuse_downgrade(root)
    replaced = read_copy(root)
    db = os.path.join(root, ".agentbus", "bus.db")
    schema_old = schema_new = backup = None
    # The bus first, then the copy: a migration that fails leaves the folder as it was.
    if os.path.lexists(db):
        con = open_bus(db, migrate=True, old_copy=replaced)
        try:
            schema_new = schema_old = user_version(con)
            if con.migrated:
                schema_old, backup = con.migrated["from"], con.migrated["backup"]
        finally:
            con.close()
    _test_pause("before-install")
    old, new = install_after_migration(root, schema_old, schema_new, backup)
    record_buses(buses=[root])
    if a.json:
        print_json({"directory": root, "old": old, "new": new, "schema_old": schema_old, "schema_new": schema_new,
                    "backup": backup})
    elif schema_old == schema_new:
        show("{}: {} -> {}", tilde(root), shown_version(old), new, path_first=True)
    elif backup:
        show("{}: {} -> {}   schema {} -> {}   backup {}", tilde(root), shown_version(old), new, schema_old, schema_new,
             tilde(backup), path_first=True)
    else:
        show("{}: {} -> {}   schema {} -> {}", tilde(root), shown_version(old), new, schema_old, schema_new, path_first=True)


# Folders upgrade --all never walks into: version control, dependencies, caches, and a bus folder
# itself (a bus is found by its parent).
WALK_SKIP = frozenset((".git", "node_modules", ".venv", "__pycache__", ".agentbus"))
# How long upgrade --all waits for each bus to be free: an agent's command holds one for milliseconds,
# and a bus held longer (a sqlite3 shell, a dashboard) is reported failed, with the fix, not waited on.
UPGRADE_BUSY_WAIT_S = 5.0


def find_bus_dirs(top, depth):
    """Every directory under top (top included, at most depth levels below it) that has a
    .agentbus/bin/agentbus entry, nearest first and in name order. Never follows a symlink."""
    found = []

    def walk(d, level):
        if os.path.lexists(os.path.join(d, ".agentbus")):
            folder = os.path.join(d, ".agentbus")
            if os.path.islink(folder) or os.path.lexists(os.path.join(folder, "bin", "agentbus")):
                found.append(d)
        if level >= depth:
            return
        try:
            entries = sorted(os.scandir(d), key=lambda e: e.name)
        except OSError:
            return
        for e in entries:
            if e.name not in WALK_SKIP and e.is_dir(follow_symlinks=False):
                walk(e.path, level + 1)
    walk(top, 0)
    return found


def install_after_migration(root, schema_old, schema_new, backup):
    """install_copy, once the bus may already have been migrated: a refusal then says what did happen
    (the migration and its backup) and that running upgrade again finishes the job."""
    try:
        return install_copy(root)
    except (SystemExit, OSError) as e:
        if schema_old is None or schema_old == schema_new:
            raise
        if isinstance(e, OSError):
            r = {"code": "bus_unavailable", "message": f"{e.strerror or e}: {e.filename or root}"}
        else:
            r = refusal(e)
        done = f"schema {schema_old} -> {schema_new}" + (f", backup {backup}" if backup else "")
        die(f"{root}: the bus was migrated ({done}), but its copy of agentbus could not be replaced: {r['message']}. "
            f"Run: agentbus upgrade {root} again", r["code"], directory=root, backup=backup)


def read_copy(root):
    """(the bytes of a bus folder's copy, its VERSION text) before upgrade replaces them, so a backup
    taken by the migration can keep the copy that wrote it beside it. Read like any lane-writable file."""
    folder = os.path.join(root, ".agentbus")
    dest, vfile = os.path.join(folder, "bin", "agentbus"), os.path.join(folder, "VERSION")
    check_node(dest, "file", must_exist=True)
    code = _read_file(dest, COPY_LIMIT)
    version = _read_file(vfile, SMALL) if check_node(vfile, "file") else b""
    return code, version


def check_still_under(top, d):
    """Refuse d unless it is still a real directory inside top: every component from top down to
    d (and its .agentbus) is a directory and not a symlink, and d resolves to itself. A folder found
    by the walk can be swapped for a link to a bus outside top before its turn comes."""
    if os.path.realpath(d) != d or not d.startswith(top.rstrip(os.sep) + os.sep) and d != top:
        die(f"refusing {d}: it now resolves outside {top} (a link was swapped in); not upgraded", "bus_unavailable", file=d)
    rel = os.path.relpath(d, top)
    path = top
    for part in ([] if rel == "." else rel.split(os.sep)) + [".agentbus"]:
        path = os.path.join(path, part)
        st = os.lstat(path)
        if stat.S_ISLNK(st.st_mode) or not stat.S_ISDIR(st.st_mode):
            die(f"refusing {path}: it is now a link or not a directory (it changed during the run); not upgraded", "bus_unavailable", file=path)


def short_version(v):
    """A VERSION as a one-word label: a release as written, a source commit as its first 7 digits."""
    v = shown_version(v)
    if re.fullmatch(r"[0-9a-f]{40}(?:[0-9a-f]{24})? .*", v):
        return v[:7] + (" +dirty" if v.endswith(" +dirty") else "")
    return v


def schema_probe(db):
    """(schema the bus has, schema it would have after an upgrade) read through a read-only open (which
    changes no data or schema; it may finish SQLite's recovery of a crashed writer's journal); None for
    both when there is no bus.db. Raises the open's refusal (busy, newer, refused)."""
    if not os.path.lexists(db):
        return None, None
    try:
        con = open_bus(db, read_only=True, busy_wait=UPGRADE_BUSY_WAIT_S)
    except SystemExit as e:
        r = refusal(e)
        if r["code"] == "schema_older":
            return e.code.fields["bus_schema"], SCHEMA_VERSION
        if r["code"] == "no_bus":
            return None, None
        raise
    try:
        have = user_version(con)
    finally:
        con.close()
    return have, SCHEMA_VERSION


def upgrade_one(root, dry_run=False, top=None):
    """Upgrade one bus folder: its copy (never to an older version), then its database (migrated
    after a backup, or stamped). A dict of what happened; refusals are reported, not raised."""
    folder = os.path.join(root, ".agentbus")
    db = os.path.join(folder, "bus.db")
    row = {"directory": root, "status": None, "old": None, "new": source_version(),
           "schema_old": None, "schema_new": None, "backup": None, "error": None}
    try:
        _test_pause("before-upgrade-" + os.path.basename(root))
        if top is not None:
            check_still_under(top, root)
        if not (check_node(folder, "dir") and check_node(os.path.join(folder, "bin"), "dir")
                and check_node(os.path.join(folder, "bin", "agentbus"), "file")):
            die(f"{root} has no .agentbus/bin/agentbus. Run: agentbus init {root}", "no_bus", next=f"agentbus init {root}")
        vfile = os.path.join(folder, "VERSION")
        old = read_small(vfile).strip() if check_node(vfile, "file") else "none"
        row["old"] = shown_version(old)
        mine, theirs = release_key(__version__), release_key(old)
        if mine is not None and theirs is not None and theirs > mine:
            row["status"] = "skipped"
            return row
        same_copy = old == source_version() and _same_file(os.path.join(folder, "bin", "agentbus"), self_path())
        have, want = schema_probe(db)
        row["schema_old"], row["schema_new"] = have, want
        if same_copy and have == want:
            row["status"] = "current"
            return row
        if dry_run:
            row["status"] = "would_upgrade"
            return row
        if top is not None:
            check_still_under(top, root)  # again, right before the writes
        replaced = None if same_copy else read_copy(root)
        # The bus first, then the copy: a migration that fails leaves the folder as it was.
        if os.path.lexists(db):
            con = open_bus(db, migrate=True, busy_wait=UPGRADE_BUSY_WAIT_S, old_copy=replaced)
            try:
                done = con.migrated
                row["schema_new"] = user_version(con)
            finally:
                con.close()
            if done:
                row["schema_old"], row["backup"] = done["from"], done["backup"]
        if not same_copy:
            _test_pause("before-install")
            if top is not None:
                check_still_under(top, root)
            install_after_migration(root, row["schema_old"], row["schema_new"], row["backup"])
        row["status"] = "upgraded"
    except SystemExit as e:
        row["status"], row["error"] = "failed", refusal(e)
    except OSError as e:
        # The system refused a file (the copy could not be replaced, a folder could not be read): as upgrade DIR
        # reports it, with the path, never as a bug. A rerun once the cause is fixed finishes the folder.
        where = e.filename or root
        row["status"] = "failed"
        row["error"] = {"code": "bus_unavailable", "message": f"{e.strerror or e}: {where}", "file": where}
    except sqlite3.Error as e:
        # SQLite refusing the file (not a database, corrupt, unreadable) is the bus being unusable, as upgrade DIR
        # reports it; only a misuse of the API by this program is a bug.
        row["status"] = "failed"
        misuse = (sqlite3.ProgrammingError, sqlite3.InterfaceError, sqlite3.InternalError, sqlite3.NotSupportedError)
        if isinstance(e, misuse):
            row["error"] = {"code": "internal", "message": str(e)}
        else:
            row["error"] = {"code": "bus_unavailable", "message": f"database error: {e}: {db}", "file": db}
    return row


def _same_file(a, b):
    try:
        with open(a, "rb") as x, open(b, "rb") as y:
            return x.read() == y.read()
    except OSError:
        return False


def _upgrade_parts(row):
    """A report row as its columns: directory, copy, then (when the schema changed) schema and backup."""
    s = row["status"]
    if s == "current":
        return [tilde(row["directory"]), f"current ({short_version(row['new'])})"]
    if s == "skipped":
        return [tilde(row["directory"]), f"skipped: copy is newer ({short_version(row['old'])})"]
    if s == "failed":
        msg = row["error"]["message"]
        if row["error"]["code"] == "busy" and "stayed busy" in msg:
            msg = "busy. Close any sqlite3 shell or dashboard holding it, then retry."
        return [tilde(row["directory"]), f"failed: {msg}"]
    old, new = short_version(row["old"]), short_version(row["new"])
    copy = f"{old} -> {new}" if old != new else f"current ({new})"
    parts = [tilde(row["directory"]), ("would upgrade: " if s == "would_upgrade" else "") + copy]
    if row["schema_old"] is not None and row["schema_old"] != row["schema_new"]:
        parts.append(f"schema {row['schema_old']} -> {row['schema_new']}")
        if row["backup"]:
            parts.append("backup " + os.path.relpath(row["backup"], row["directory"]))
    return parts


def report_upgrades(a, rows):
    counts = {k: sum(1 for r in rows if r["status"] == k) for k in ("upgraded", "current", "skipped", "failed")}
    if a.dry_run:
        counts["would_upgrade"] = sum(1 for r in rows if r["status"] == "would_upgrade")
    if a.json:
        print_json({"buses": rows, **counts})
    else:
        for parts in (_upgrade_parts(r) for r in rows):
            if len(parts) == 2:
                show("{}   {}", *parts, path_first=True)
            elif len(parts) == 3:
                show("{}   {}   {}", *parts, path_first=True)
            else:
                show("{}   {}   {}   {}", *parts, path_first=True)
        if a.dry_run:
            show("would upgrade {}, current {}, skipped {}, failed {}", counts["would_upgrade"], counts["current"],
                 counts["skipped"], counts["failed"])
        else:
            show("upgraded {}, current {}, skipped {}, failed {}", counts["upgraded"], counts["current"],
                 counts["skipped"], counts["failed"])
    if counts["failed"]:
        emit_pending(a)  # the report is the result: printed before the error says a bus failed
        failed = [r for r in rows if r["status"] == "failed"]
        die(f"{len(failed)} of {len(rows)} bus folders failed: " + ", ".join(r["directory"] for r in failed)
            + "; each one's row says why", "items_failed", failed=failed)


# Commands whose human output carries the stale-copy notice (never under --json).
STALE_NOTICE_COMMANDS = ("join", "status", "buses")


def copy_label(directory):
    """A bus folder's VERSION as one word for a human row (a source commit shortened), or none."""
    vfile = os.path.join(directory, ".agentbus", "VERSION")
    try:
        return short_version(read_small(vfile).strip()) if check_node(vfile, "file") else "none"
    except (SystemExit, OSError):
        return "unreadable"


def stale_copy(db_path):
    """(the bus copy's version, True when it is a release older than this tool), from VERSION."""
    copy = bus_copy_version(db_path)
    mine = release_key(__version__)
    return copy, bool(copy and mine is not None and release_key(copy) < mine)


def stale_copy_notice(a, db_path):
    """The installed tool's notice, on stderr, that a bus folder's copy is older than itself: only
    from a tool that is not that copy, never with --json, and off with AGENTBUS_NO_UPDATE_NOTICE=1."""
    if a.json or a.cmd not in STALE_NOTICE_COMMANDS or os.environ.get("AGENTBUS_NO_UPDATE_NOTICE", "") not in ("", "0") \
            or is_repo_local_copy():
        return
    copy, stale = stale_copy(db_path)
    if stale:
        note(f"this bus's copy is {copy}; the installed agentbus is {__version__}. "
             f"Run: agentbus upgrade {bus_directory(db_path)}")


# ---------- opening the bus ----------

def discovery_start():
    """Map cwd in a linked worktree to the same relative directory in its main checkout."""
    cwd = os.path.realpath(os.getcwd())
    info = repo_info(cwd)
    if info:
        r = git(["rev-parse", "--show-toplevel"], cwd=cwd)
        if r is None or r.returncode != 0:
            die("cannot find this worktree's top level", "no_bus")
        top = os.path.realpath(r.stdout.strip())
        return os.path.normpath(os.path.join(info[0], os.path.relpath(cwd, top)))
    return cwd


def check_bus_folder(folder):
    check_node(folder, "dir", must_exist=True)
    check_node(os.path.join(folder, "VERSION"), "file")
    check_node(os.path.join(folder, "bin"), "dir")


def walk_buses(start):
    """Nearest to outermost. A suspect .agentbus is refused, never silently skipped."""
    home = os.path.realpath(os.path.expanduser("~"))
    directory = start
    while True:
        folder = os.path.join(directory, ".agentbus")
        if directory != home and os.path.lexists(folder):
            check_bus_folder(folder)
            yield directory
        parent = os.path.dirname(directory)
        if parent == directory:
            break
        directory = parent


def explicit_db():
    env = os.environ.get("AGENTBUS_DB")
    return os.path.abspath(os.path.expanduser(env)) if env else None


def selected_bus(up):
    for level, directory in enumerate(walk_buses(discovery_start())):
        if level == up:
            return directory
    if up:
        die(f"no bus at --up {up}; no such outer bus. See: agentbus buses", "no_bus", next="agentbus buses")
    die("no bus here or in any parent folder. Run: agentbus init <dir>", "no_bus", next="agentbus init <dir>")


def find_bus_path(up):
    """(the bus database path, strict): an explicit database wins over discovery and --up. The one way a
    bus is found, for every command and for doctor; it writes nothing."""
    path = explicit_db()
    strict = path is None
    if strict:
        path = os.path.join(selected_bus(up), ".agentbus", "bus.db")
    folder = os.path.dirname(path)
    if os.path.basename(folder) == ".agentbus" and os.path.isdir(folder):
        check_bus_folder(folder)
    return path, strict


def db_path(args):
    """find_bus_path, then the git exclude rule for the bus folder."""
    path, strict = find_bus_path(args.up)
    folder = os.path.dirname(path)
    if os.path.basename(folder) == ".agentbus" and os.path.isdir(folder):
        info = repo_info(os.path.dirname(folder))
        if info and os.path.realpath(info[0]) == os.path.realpath(os.path.dirname(folder)):
            keep_excluded(*info)
    return path, strict


def cmd_buses(a):
    """List bus locations without opening or creating any database."""
    path = explicit_db()
    if path:
        folder = os.path.dirname(path)
        if os.path.basename(folder) == ".agentbus":
            check_bus_folder(folder)
        paths = [(os.path.dirname(folder) if os.path.basename(folder) == ".agentbus" else folder, path)]
    else:
        paths = [(d, os.path.join(d, ".agentbus", "bus.db")) for d in walk_buses(discovery_start())]
        if not paths:
            die("no bus here or in any parent folder. Run: agentbus init <dir>", "no_bus", next="agentbus init <dir>")
        if a.up >= len(paths):
            die(f"no bus at --up {a.up}; no such outer bus. See: agentbus buses", "no_bus", next="agentbus buses")
    rows = []
    for level, (directory, db) in enumerate(paths):
        exists = bool(check_node(db, "file"))
        for suffix in SIDECARS:
            check_node(db + suffix, "file")
        if os.path.lexists(db + "-journal"):
            die(f"refusing {db}-journal: agentbus never writes one; remove it after checking where it came from", "bus_unavailable", file=db + "-journal")
        copy, stale = stale_copy(db)
        rows.append({"level": level, "directory": directory, "exists": exists, "copy_version": copy, "stale": stale})
        stale_copy_notice(a, db)
    if a.json:
        print_json(envelope(rows))
    else:
        for row in rows:
            show("{}  {}  bus.db {}  copy {}", row["level"], tilde(row["directory"]), "exists" if row["exists"] else "not created",
                 row["copy_version"] or copy_label(row["directory"]), row=True)


SIDECARS = ("-wal", "-shm", "-journal")


def check_bus(path, strict_dir, read_only=False):
    """Before opening: the bus files and (for a .agentbus folder) the folder itself
    must be real, owned by the caller and not links. Then tighten modes without following links
    (not for a read-only open, which changes no data or schema; may finish SQLite's recovery of a crashed writer's journal)."""
    folder = os.path.dirname(path)
    if strict_dir or os.path.basename(folder) == ".agentbus":
        check_node(folder, "dir", must_exist=True)
        if os.path.basename(folder) == ".agentbus":
            check_node(os.path.join(folder, "VERSION"), "file")
            check_node(os.path.join(folder, "bin"), "dir")
    for suffix in ("",) + SIDECARS:
        st = check_node(path + suffix, "file", optional=True)
        if st and not read_only:
            chmod_nofollow(path + suffix, 0o600, "file", st, optional=True)
    if os.path.lexists(path + "-journal"):
        # agentbus never uses a rollback journal (WAL, converted with an in-memory journal); a
        # journal here was planted, and SQLite would replay it.
        die(f"refusing {path}-journal: agentbus never writes one; remove it after checking where it came from", "bus_unavailable", file=path + "-journal")


def _linked_here(path):
    """Identity of the regular, single-link, caller-owned file at path (not followed), else None.
    A file SQLite holds open whose identity equals this is the file named in our folder, and with one
    link it cannot also be some victim file elsewhere."""
    try:
        st = os.lstat(path)
    except OSError:
        return None
    if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1 or not _owned(st):
        return None
    return _ident(st)


def _open_files():
    """{(fd, (dev, inode))} for every regular file this process has open. Keyed by identity as well
    as number, because fd numbers are reused."""
    try:
        names = [int(n) for n in os.listdir("/dev/fd") if n.isdigit()]
    except OSError:
        die("cannot list /dev/fd to verify the bus files SQLite opened", "bus_unavailable")
    found = set()
    for fd in names:
        try:
            st = os.fstat(fd)
        except OSError:
            continue
        if stat.S_ISREG(st.st_mode):
            found.add((fd, _ident(st)))
    return found


# Every bus another agent cannot open retries for BUSY_WAIT_S, so no command may hold one longer.
# A lane that can write bus.db can always deny service (hold the lock with its own sqlite3 connection,
# or delete the bus); what agentbus bounds is its OWN hold, whatever rows a lane planted:
# - QUERY_BUDGET_S: all of a command's SQL on one connection, counted from the connect (so the open
#   counts against it). A statement still running then is stopped, its write rolled back. 6 s, the
#   same as OPEN_BUDGET_S: an honest command's SQL takes milliseconds, and the bound must leave room
#   under BUSY_WAIT_S for the Python work around it.
# - HOLD_GRACE_S more for everything else done with the lock held (Python loops, fetching and
#   decoding rows): past QUERY_BUDGET_S + HOLD_GRACE_S from the connect, the hold watchdog ends the
#   process, which releases the lock. 8 s in all.
# Why 8 and not more: the lock is really free only after the stopped process is gone, which takes
# up to exit_now's 1 s grace (stderr may be a full pipe) plus a slow machine's late watchdog wake-up
# and process teardown. At 12 s that ate the whole 3 s margin on CI runners and the waiting agent
# failed busy. 8 s leaves at least 5 s of slack against BUSY_WAIT_S even then. BUSY_WAIT_S itself
# stays 15 s: agents running an older agentbus wait 15 s whatever this one says, so only a shorter
# hold keeps the promise for them, and a longer wait only delays the report of a real stuck lock.
BUSY_WAIT_S = 15.0
QUERY_BUDGET_S = 6.0
HOLD_GRACE_S = 2.0
_TIMED_OUT = False


def query_budget():
    """QUERY_BUDGET_S. Test hook: AGENTBUS_TEST_DEADLINE=<seconds> can only shorten it."""
    try:
        v = float(os.environ.get("AGENTBUS_TEST_DEADLINE", ""))
    except ValueError:
        return QUERY_BUDGET_S
    return min(max(v, 0.0), QUERY_BUDGET_S) if math.isfinite(v) else QUERY_BUDGET_S


def hold_budget():
    """How long a command may hold a bus, from its connect: the query budget plus HOLD_GRACE_S."""
    return query_budget() + HOLD_GRACE_S


def held_too_long_message(path, hold=None, committing=False):
    """The hold watchdog's message. committing: it fired during a COMMIT, whose outcome is not known."""
    held = f"{path}: this command held the bus for {hold_budget() if hold is None else hold:g} s, the most agentbus allows (other agents " \
           f"wait {BUSY_WAIT_S:g} s for it), and was stopped"
    if committing:
        return (held + " while saving a write, so that write may or may not have been saved. Check the bus before "
                "repeating the command, or repeat it only with its --request-id. Something slow made the save last "
                "(a stalled disk, or rows an agent wrote)")
    return (held + "; a write still in progress was not saved. Something "
            "in the bus makes this command slow (an agent can write any rows); check the bus")


def timed_out_message():
    return (f"a bus query ran for more than {query_budget():g} s and was stopped (a write it was part of "
            "was rolled back). Something in the bus makes queries this slow; an agent can write any rows")


class Bus(sqlite3.Connection):
    """A connection that knows which file it is on, so every write can first prove the path still
    names that file."""
    path = None
    ident = None
    pin = None  # our own O_NOFOLLOW fd on the bus file
    deadline = None  # time.monotonic() after which every statement on this connection is stopped
    guarded = False  # the hold watchdog is armed for this connection (open_bus)
    wal_was_there = True  # bus.db-wal existed before this connection opened the bus
    migrated = None  # {"from", "to", "backup"} when this open changed the schema version

    def _progress(self):
        """SQLite's progress handler: a non-zero return stops the running statement ("interrupted")."""
        global _TIMED_OUT
        if time.monotonic() > self.deadline:
            _TIMED_OUT = True
            return 1
        return 0

    def close(self):
        # POSIX drops every lock a process holds on a file when ANY of its fds on that file is
        # closed, so our fd may only be closed after SQLite's own.
        try:
            super().close()
        finally:
            if self.guarded:
                self.guarded = False
                WATCHDOG.disarm()
            if self.pin is not None:
                os.close(self.pin)
                self.pin = None
            if self in _HELD:
                _HELD.remove(self)

    def verify(self):
        if _linked_here(self.path) != self.ident:
            die(f"{self.path} changed while in use (replaced, linked or moved); refusing to write", "bus_unavailable")


def _audit(con, path, before, need_main):
    """Every regular file this process gained since `before` must be the bus or its -wal, as named
    in our folder right now. Catches a link swapped in between our checks and SQLite's own open."""
    main = _linked_here(path)
    if main is None or main != con.ident:
        die_now(f"{path} changed while opening (replaced or linked); refusing to use it", "bus_unavailable")
    allowed = {main, _linked_here(path + "-wal")}
    seen_main = False
    for fd, idn in _open_files() - before:
        if idn not in allowed:
            die_now(f"{path}: SQLite opened a file that is not this bus (a link was swapped in); refusing", "bus_unavailable")
        seen_main = seen_main or idn == main
    if need_main and not seen_main:
        die_now(f"{path}: cannot find the file SQLite opened; refusing", "bus_unavailable")


def _open_once(path, read_only=False, budgets=None):
    """One attempt. Returns a Bus holding the exclusive lock, or None if another process holds it.
    read_only: the file must exist (never created) and its mode is left alone. budgets: (open, query)
    seconds, by default open_budget() and query_budget()."""
    open_s, query_s = budgets or (open_budget(), query_budget())
    flags = os.O_RDWR | NOFOLLOW | NONBLOCK | (0 if read_only else os.O_CREAT)  # as a write, but never creating
    try:
        fd = os.open(path, flags, 0o600)
    except FileNotFoundError:
        if read_only:
            die(f"no bus at {path} yet (nothing has written it). Run any agentbus command there, or: agentbus init DIR",
                "no_bus", next="agentbus init DIR", bus=path)
        die(f"refusing {path}: No such file or directory", "bus_unavailable", file=path)
    except OSError as e:
        die(f"refusing {path}: {e.strerror}", "bus_unavailable", file=path)
    owned = []
    try:
        st = os.fstat(fd)
        if not stat.S_ISREG(st.st_mode) or st.st_nlink != 1 or not _owned(st):
            die(f"refusing {path}: not a single-link regular file owned by you", "bus_unavailable", file=path)
        if not read_only:
            os.fchmod(fd, 0o600)
        # Our fd stays open until both audits are done, so SQLite's own fd for the file can never
        # reuse its number and hide in the snapshot.
        before = _open_files()
        _test_pause("before-connect")
        with watched(open_s, f"{path}: opening the bus did not finish within {open_s:g} s, so the "
                     "command was stopped. SQLite was blocked on a file in the bus folder (a FIFO or other "
                     "special file planted at bus.db-journal, for example); check the folder"):
            return _connect_watched(path, fd, st, before, owned, read_only, query_s)
    finally:
        if not owned:
            os.close(fd)


def _connect_watched(path, fd, st, before, owned, read_only=False, query_s=None):
    """_open_once from the connect on, under the watchdog: every SQLite-internal open (the main
    file, -wal, a hot -journal, a super-journal it names) happens in here. Returns the Bus or None.
    Once the connection exists it owns fd (owned is set), and con.close() closes it."""
    # mode=rw: SQLite never creates the main file itself (we just did, without following links).
    wal_was_there = os.path.lexists(path + "-wal")
    con = sqlite3.connect("file:" + quote(path) + "?mode=rw", uri=True, timeout=0,
                          isolation_level=None, factory=Bus)
    con.path, con.ident, con.pin, con.wal_was_there = path, _ident(st), fd, wal_was_there
    owned.append(con)
    _HELD.append(con)
    con.deadline = time.monotonic() + (query_budget() if query_s is None else query_s)
    con.set_progress_handler(con._progress, 10000)
    con.row_factory = sqlite3.Row
    # A lane can store bytes that are not UTF-8 in a TEXT column; the default decoder then
    # fails every query that reads the row. U+FFFD is visible and passes clean() unchanged.
    con.text_factory = lambda b: b.decode("utf-8", "replace")
    try:
        # SQLite opens the main file at connect time; prove it is ours before any read or write.
        _audit(con, path, before, need_main=True)
        # The first statement, before any that could reach a view or trigger (a lane can add
        # either to the bus): with trusted_schema OFF, SQLite refuses to run functions with
        # side effects from them. It reads no file.
        con.execute("PRAGMA trusted_schema=OFF")
        # Exclusive locking before the first WAL access: SQLite then keeps the WAL index in heap
        # memory and never opens -shm, so a planted -shm link is never touched.
        con.execute("PRAGMA locking_mode=EXCLUSIVE")
        con.execute("PRAGMA temp_store=MEMORY")  # statement journals and sorts never touch disk
        # Debian and Ubuntu build SQLite with SECURE_DELETE on: every page a delete frees is zeroed, so
        # releasing 500 planted 1 MB claim names wrote 600 MB to the -wal and the checkpoint, with the bus
        # held. FAST still zeroes deleted cells on the pages a delete writes anyway, and adds no I/O.
        con.execute("PRAGMA secure_delete=FAST")
        _test_pause("before-first-read")
        # The first read is a plain read: SQLite reads the header itself and opens -wal if the
        # file is WAL. (Setting a journal mode before it would make SQLite convert a WAL file
        # on that read, touching -wal before the audit below.)
        con.execute("SELECT COUNT(*) FROM sqlite_master").fetchone()  # takes the lock
        _audit(con, path, before, need_main=False)
        _test_pause("before-wal-convert")
        # Decide from SQLite's own view after its read, never from a header we read ourselves
        # (a lane can flip bytes 18-19 at any time). Not WAL (new or flipped): convert
        # through an in-memory journal, so no -journal file is opened for writing. A read-only
        # open converts nothing: it reads the file in whatever mode it is.
        if not read_only and con.execute("PRAGMA journal_mode").fetchone()[0] != "wal":
            con.execute("PRAGMA journal_mode=MEMORY")
            con.execute("PRAGMA journal_mode=WAL").fetchone()
            con.execute("SELECT COUNT(*) FROM sqlite_master").fetchone()
        _audit(con, path, before, need_main=False)
        _test_pause("after-open")
    except BaseException as e:
        if not isinstance(e, SystemExit):
            # Before a normal close (which may checkpoint into whatever -wal SQLite holds),
            # prove SQLite holds only our files; otherwise exit without closing.
            _audit(con, path, before, need_main=False)
        con.close()
        if isinstance(e, sqlite3.OperationalError) and ("locked" in str(e) or "busy" in str(e)):
            return None
        raise
    return con


def refusal(e):
    """{"code", "message"} of a SystemExit raised by die(), for a caller that shows the error itself
    (watch's frame) instead of exiting."""
    if isinstance(e.code, Diag):
        return {"code": e.code.code, "message": e.code.msg}
    return {"code": "internal", "message": str(e.code)}


def bus_directory(path):
    """The directory a bus belongs to, as commands name it: the folder holding .agentbus, else the
    database's own folder (an explicit AGENTBUS_DB elsewhere)."""
    folder = os.path.dirname(path)
    return os.path.dirname(folder) if os.path.basename(folder) == ".agentbus" else folder


def schema_older(path, have):
    die(f"this bus is older than this agentbus (schema {have}, needs {SCHEMA_VERSION}). Any agentbus command "
        f"that is not watch upgrades it after taking a backup, or run: agentbus upgrade {bus_directory(path)}",
        "schema_older", next=f"agentbus upgrade {bus_directory(path)}", bus=path, bus_schema=have, tool_schema=SCHEMA_VERSION)


def schema_newer(path, have):
    die(f"this bus is newer than this copy of agentbus (schema {have}, this copy knows {SCHEMA_VERSION}). "
        f"Use a newer agentbus: agentbus upgrade {bus_directory(path)} from an up-to-date install",
        "schema_newer", next=f"agentbus upgrade {bus_directory(path)}", bus=path, bus_schema=have, tool_schema=SCHEMA_VERSION)


def user_version(con):
    return con.execute("PRAGMA user_version").fetchone()[0]


def _has_tables(con):
    names = {r[0] for r in con.execute("SELECT name FROM sqlite_master WHERE type='table'")}
    return any(t in names for t in TABLES)


def schema_state(con):
    """What a bus needs, read without writing, after check_objects: ("new", 0) no tables yet;
    ("adopt", 0) the version-1 shape without the stamp (a v0.1.0 bus); ("current", n);
    ("older", (n, history entry or None)) a migration is due; ("newer", n). A shape that is none of
    these is refused here, by check_schema's own message."""
    check_objects(con)
    have = user_version(con)
    if have < 0 or have > MAX_SCHEMA_VERSION:
        die(f"bus.db records schema version {have}, which no agentbus writes: another tool or an agent changed it. "
            "Check the bus, or restore a backup (docs/how-to/upgrade.md)", "schema_corrupt", bus=getattr(con, "shown", con.path),
            bus_schema=have)
    if have > SCHEMA_VERSION:
        return "newer", have
    if not _has_tables(con):
        return "new", have  # nothing of agentbus's (every table dropped counts too): created as new
    if have == SCHEMA_VERSION:
        check_schema(con, before_setup=True)  # a missing index is created by the write open
        return "current", have
    if have == 0:
        if SCHEMA_VERSION == 1 or SCHEMA_V1 == SCHEMA:
            try:
                check_schema(con, before_setup=True)
                return "adopt", 0
            except SystemExit:
                entry = history_match(con)
                if entry is None:
                    raise
                return "older", (0, entry)
        if {t: table_shape(con, t) for t in TABLES} == schema_shapes(SCHEMA_V1):
            return "older", (0, {"name": "v0.1.0", "schema": SCHEMA_V1, "steps": []})  # stamp 1, then migrate
        entry = history_match(con)
        if entry is None:
            check_schema(con)  # refused, with the difference named
            die("bus schema is not agentbus's: it matches no version this agentbus knows", "schema_refused")
        return "older", (0, entry)
    return "older", (have, None)


def history_match(con):
    """The HISTORY entry whose captured shape this bus has, table for table, else None."""
    if not HISTORY:
        return None
    shapes = {t: table_shape(con, t) for t in TABLES}
    for entry in HISTORY:
        if schema_shapes(entry["schema"]) == shapes:
            return entry
    return None


@lru_cache(maxsize=None)
def schema_shapes(schema):
    """{table: shape} of the tables a schema text creates, built in memory."""
    ref = sqlite3.connect(":memory:")
    try:
        ref.executescript(schema)
        return {t: table_shape(ref, t) for t in TABLES}
    finally:
        ref.close()


def open_bus(path, strict_dir=False, migrate=True, read_only=False, busy_wait=BUSY_WAIT_S, hold=None, old_copy=None):
    """Open a bus without ever letting SQLite write through a link a lane swapped in:
    1. the folder and files are checked (no links, one owner, one link each);
    2. the main file is opened by us with O_NOFOLLOW and SQLite only reopens it (mode=rw, no create);
    3. after SQLite opens the main file, and again after it opens -wal, every regular file this
       process holds must be one of the two files named in our folder (dev/inode, single link);
    4. exclusive locking mode, so -shm is never used and nothing else holds the bus meanwhile;
    5. every write transaction re-checks the path still names the opened file (Bus.verify).
    Another process holding the bus makes this retry (closing in between) for up to busy_wait seconds
    (default 15). The hold watchdog ends the process once the connection has been open for `hold`
    seconds (default and most hold_budget()): Python work with the lock held (the setup below, the
    command, its fetches) is bounded too, not only its SQL.
    Open modes: the default write open creates a new bus, stamps the schema version and migrates an
    older bus. migrate=False refuses a bus that needs a migration (schema_older) instead of writing
    it. read_only=True creates nothing and changes no data or schema (no file, no folder, no mode
    change, no setup, no stamp; SQL is query_only), and refuses a bus that needs a write first (schema_older,
    or no_bus when there are no tables). It opens the bus exactly as a write does (the same checks,
    exclusive locking, the same audits): it changes no row or schema, and may finish SQLite's
    recovery of a crashed writer's -wal (folding its committed frames into bus.db) on close."""
    hold = hold_budget() if hold is None else min(max(float(hold), 0.05), hold_budget())
    query_s = min(query_budget(), hold - min(HOLD_GRACE_S, hold / 2))
    budgets = (min(open_budget(), hold), query_s)
    folder = os.path.dirname(path)
    if not os.path.lexists(folder):
        if read_only:
            die(f"no bus at {path}: {folder} does not exist. Run: agentbus init DIR", "no_bus", next="agentbus init DIR", bus=path)
        os.makedirs(os.path.dirname(folder), exist_ok=True)
        make_dir(folder)
    deadline = time.time() + busy_wait
    while True:
        try:
            check_bus(path, strict_dir, read_only)
        except _Vanished as e:
            if time.time() > deadline:
                die(f"refusing {e}: it keeps vanishing or changing while being checked", "bus_unavailable", file=str(e))
            time.sleep(random.uniform(0.002, 0.03))
            continue
        con = _open_once(path, read_only, budgets)
        if con is not None:
            break
        _test_pause("lock-retry")
        if time.time() > deadline:
            die(f"{path} stayed busy for {busy_wait:g} seconds. "
                "Close any sqlite3 shell or dashboard holding it open, then retry.", "busy", bus=path)
        time.sleep(random.uniform(0.002, 0.03))
    con.shown = path
    con.guarded = True
    WATCHDOG.arm(max(con.deadline + (hold - query_s) - time.monotonic(), 0.0), held_too_long_message(path, hold),
                 held_too_long_message(path, hold, committing=True))
    try:
        con.execute(f"PRAGMA busy_timeout={int(busy_wait * 1000)}")
        con.execute("PRAGMA foreign_keys=ON")
        if read_only:
            _setup_read_only(con, path)
            return con
        with immediate(con, record=False):  # setup is not the command's change
            # First, before any statement that could fire a trigger or read a view: a lane can
            # add either (or a table or index) to the bus, and it would run here, unsandboxed
            # (schema_state runs check_objects first). Then, still before any write: every table
            # that exists has agentbus's own shape before creating anything in an empty bus.
            state, info = schema_state(con)
        if state == "newer":
            schema_newer(path, info)
        if state == "older":
            if not migrate:
                schema_older(path, info[0])
            migrate_bus(con, path, info, old_copy)
        with immediate(con, record=False):  # the stamp and setup are not the command's change either
            # Again, in the transaction that writes: the connection kept its exclusive lock since
            # the check above, so this only re-proves what that check found.
            state, info = schema_state(con)
            if state == "newer":
                schema_newer(path, info)
            if state == "older":
                schema_older(path, info[0])
            check_schema(con, before_setup=True)
            create_schema(con, indexes=False)
            check_objects(con, index_sql=True)
            create_schema(con)
            check_schema(con)
            if state in ("new", "adopt"):
                # A new bus, or a v0.1.0 bus whose tables already have the version-1 shape: the
                # stamp is the only write adoption makes.
                con.execute(f"PRAGMA user_version={SCHEMA_VERSION}")
                if state == "adopt":
                    con.migrated = {"from": 0, "to": SCHEMA_VERSION, "backup": None}
            normalize_stored_claims(con)
    except BaseException:
        con.close()
        raise
    return con


def _setup_read_only(con, path):
    """The checks of a read-only open, which changes no data or schema (it may finish SQLite's recovery of a
    crashed writer's journal): refuse what the default open would refuse,
    and a bus that needs a write before it can be read (no tables yet, or a migration)."""
    con.execute("PRAGMA query_only=ON")
    con.execute("BEGIN")
    try:
        state, info = schema_state(con)
        if state == "newer":
            schema_newer(path, info)
        if state == "older":
            schema_older(path, info[0])
        if state == "new":
            die(f"no bus at {path} yet (nothing has written it). Run any agentbus command there, or: agentbus init DIR",
                "no_bus", next="agentbus init DIR", bus=path)
    finally:
        if con.in_transaction:
            con.execute("COMMIT")


# ---------- migrations and backups ----------

# A migration's own budget, replacing QUERY_BUDGET_S and the hold watchdog for the connection that
# migrates: the quick_check, the backup copy and its check, and the migration SQL all count against
# it. With HOLD_GRACE_S and the exit it stays under BUSY_WAIT_S, so an agent waiting on the bus always
# gets it (then migrates it itself if this run was stopped). 10 s copies and checks hundreds of MB; a
# bus too big for that fails backup_failed with the bus unchanged.
MIGRATE_BUDGET_S = 9.0
# How long the watchdog waits for a COMMIT in progress before it gives up on undoing (UNDO_LOCK_WAIT_S),
# and exit_now's grace for writing its message (EXIT_GRACE_S): with MIGRATE_BUDGET_S and HOLD_GRACE_S a
# stopped migration is gone in 13 s, inside the 15 s another agent waits.
UNDO_LOCK_WAIT_S = 1.0
EXIT_GRACE_S = 1.0
BACKUP_KEEP = 5
PARTIAL_MAX_AGE_S = 3600
BACKUP_SPARE = 16 << 20
COPY_BLOCK = 1 << 20
_BACKUP_NAME = re.compile(r"bus-v([0-9]{1,6})-([0-9]{8}T[0-9]{6}Z)(?:-([0-9]{1,2}))?\.db")


def migrate_budget():
    """MIGRATE_BUDGET_S. Test hook: AGENTBUS_TEST_DEADLINE=<seconds> can only shorten it."""
    try:
        v = float(os.environ.get("AGENTBUS_TEST_DEADLINE", ""))
    except ValueError:
        return MIGRATE_BUDGET_S
    return min(max(v, 0.0), MIGRATE_BUDGET_S) if math.isfinite(v) else MIGRATE_BUDGET_S


def backup_failed(path, why):
    die(f"{path}: could not back up the bus before upgrading it ({why}); nothing was changed",
        "backup_failed", bus=path, reason=why)


def migration_steps(have, entry):
    """The statements that take this bus to SCHEMA_VERSION, as [(from version, [SQL, ...])]."""
    plan, v = [], have
    if entry is not None:
        plan.append((0, list(entry["steps"])))
        v = 1
    while v < SCHEMA_VERSION:
        if v not in MIGRATIONS:
            die(f"bus schema {v} has no migration to {v + 1} in this agentbus", "schema_refused", bus=None)
        plan.append((v, list(MIGRATIONS[v])))
        v += 1
    return plan


def rehearse(con, plan):
    """Run the migration on an in-memory copy of the bus's schema (no rows), then check the result as
    every open checks a bus: a bus whose shape the statements would not bring to agentbus's is
    refused here, before any backup or write."""
    ref = sqlite3.connect(":memory:", isolation_level=None)
    try:
        for typ, name, sql in con.execute("SELECT type, name, sql FROM sqlite_master WHERE sql IS NOT NULL "
                                          "AND name <> 'sqlite_sequence' ORDER BY type DESC, rowid").fetchall():
            ref.execute(sql)
        for _, stmts in plan:
            for stmt in stmts:
                ref.execute(stmt)
        check_schema(ref)
        check_objects(ref, index_sql=True)
    finally:
        ref.close()


def _backups_dir(path):
    """The backups folder beside the bus, made 0700, opened once as a directory fd that every later
    step passes as dir_fd: swapping the folder for a link afterwards cannot redirect a write."""
    d = os.path.join(os.path.dirname(path), "backups")
    expect = make_dir(d)
    try:
        dfd = os.open(d, os.O_RDONLY | getattr(os, "O_DIRECTORY", 0) | NOFOLLOW)
    except OSError as e:
        backup_failed(path, f"cannot open {d}: {e.strerror}")
    st = os.fstat(dfd)
    if not stat.S_ISDIR(st.st_mode) or not _owned(st) or _ident(st) != _ident(expect):
        os.close(dfd)
        backup_failed(path, f"{d} changed while opening")
    if stat.S_IMODE(st.st_mode) != 0o700:
        os.fchmod(dfd, 0o700)
        if stat.S_IMODE(os.fstat(dfd).st_mode) != 0o700:
            os.close(dfd)
            backup_failed(path, f"cannot make {d} owner-only")
    return d, dfd


def _entry_stat(name, dfd):
    try:
        st = os.stat(name, dir_fd=dfd, follow_symlinks=False)
    except OSError:
        return None
    return st if stat.S_ISREG(st.st_mode) and _owned(st) else None


def _same_bytes(fd_a, fd_b, size, deadline):
    off = 0
    while off < size:
        if time.monotonic() > deadline:
            raise TimeoutError
        n = min(COPY_BLOCK, size - off)
        if os.pread(fd_a, n, off) != os.pread(fd_b, n, off):
            return False
        off += n
    return True


def _reusable_backup(con, dfd, version, size, deadline):
    """The newest existing backup of this version that already holds exactly the bus's bytes (a run
    that died after its backup), so a retried migration does not make a second one."""
    names = sorted((m.group(2), int(m.group(3) or 1), n) for n in os.listdir(dfd)
                   for m in [_BACKUP_NAME.fullmatch(n)] if m and int(m.group(1)) == version)
    for _, _, name in reversed(names):
        st = _entry_stat(name, dfd)
        if st is None or st.st_size != size or st.st_nlink != 1 or stat.S_IMODE(st.st_mode) != 0o600:
            continue
        try:
            fd = os.open(name, os.O_RDONLY | NOFOLLOW | NONBLOCK, dir_fd=dfd)
        except OSError:
            continue
        try:
            fst = os.fstat(fd)
            if _ident(fst) == _ident(st) and _same_bytes(con.pin, fd, size, deadline):
                return name
        except TimeoutError:
            return None
        finally:
            os.close(fd)
    return None


def _copy_names(backup_name):
    """The names of the copy (and its VERSION) kept beside a backup: agentbus-<stamp>, VERSION-<stamp>."""
    stamp = backup_name.split("-", 2)[2][:-len(".db")]
    return f"agentbus-{stamp}", f"VERSION-{stamp}"


def _keep_copy(dfd, backup_name, old_copy, undo=None):
    """Write the replaced copy and its VERSION beside the backup, 0600, each through a temp file
    that is checked (size) and then linked in, so a name is only ever a complete copy; never over an
    existing name (a retried migration that reuses its backup keeps the first copy saved). Returns the
    names it created."""
    made = []
    for name, data in zip(_copy_names(backup_name), old_copy):
        if _entry_stat(name, dfd) is not None:
            continue
        tmp = f".{name}.{secrets.token_hex(8)}.tmp"
        if undo is not None:
            undo.tmps.append(tmp)
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_EXCL | NOFOLLOW, 0o600, dir_fd=dfd)
        try:
            if os.environ.get("AGENTBUS_TEST_BACKUP_FAIL") == "keep-enospc":
                _write_fd_all(fd, data[:len(data) // 2])
                raise OSError(errno.ENOSPC, os.strerror(errno.ENOSPC))
            if os.environ.get("AGENTBUS_TEST_BACKUP_FAIL") == "keep-stall":
                _write_fd_all(fd, data[:len(data) // 2])
                time.sleep(60)  # test hook: stalled until the watchdog stops the migration
            _write_fd_all(fd, data)
            os.fsync(fd)
            if os.fstat(fd).st_size != len(data):
                raise OSError(errno.EIO, f"the kept copy {name} does not match the copy it saves")
            try:
                os.link(tmp, name, src_dir_fd=dfd, dst_dir_fd=dfd, follow_symlinks=False)
                made.append(name)
            except FileExistsError:
                pass
        finally:
            os.close(fd)
            try:
                os.unlink(tmp, dir_fd=dfd)
            except OSError:
                pass
            if undo is not None and tmp in undo.tmps:
                undo.tmps.remove(tmp)
    return made


def _prune_backups(dfd, keep):
    """Keep `keep` (the backup just taken, whatever its stamp says) and the newest BACKUP_KEEP - 1
    other backups (exact name pattern, regular files we own); remove .partial files older than an
    hour (a crash mid-copy leaves one)."""
    full, now_s = [], time.time()
    for n in os.listdir(dfd):
        m = _BACKUP_NAME.fullmatch(n[:-len(".partial")] if n.endswith(".partial") else n)
        st = _entry_stat(n, dfd) if m else None
        if st is None:
            continue
        if n.endswith(".partial"):
            if now_s - st.st_mtime > PARTIAL_MAX_AGE_S:
                os.unlink(n, dir_fd=dfd)
            continue
        if n != keep:
            full.append((m.group(2), int(m.group(3) or 1), n))
    for _, _, n in sorted(full)[:max(len(full) - (BACKUP_KEEP - 1), 0)]:
        os.unlink(n, dir_fd=dfd)
        for kept in _copy_names(n):  # the copy upgrade kept beside it goes with it
            if _entry_stat(kept, dfd) is not None:
                os.unlink(kept, dir_fd=dfd)


class _Undo:
    """What a migration made in backups/ (its dir fd, the folder if it made it, the partial, the
    published backup and kept copy), removed again if the migration does not complete."""

    def __init__(self):
        self.dfd, self.made_dir, self.partial, self.names, self.empty_wal = None, None, None, [], None
        self.tmps = []  # a kept copy's temp file while it is written
        # COMMIT and `committed` change together under the lock; the watchdog thread takes it before
        # undoing, so it never removes the backup of a migration that has committed.
        self.lock = threading.Lock()
        self.committed = False
        self.summary = None  # "schema N -> M, backup PATH", for the message when it did commit
        self.bus, self.backup, self.schema = None, None, (None, None)  # the bus, its backup and (N, M), for upgrade

    def run(self):
        """Undo, unless the migration committed (then say so). Returns a message for the watchdog
        when the state is not "nothing was changed"."""
        if not self.lock.acquire(timeout=UNDO_LOCK_WAIT_S):
            return "the upgrade was stopped while it was committing; run any agentbus command to see the bus's state"
        try:
            if self.committed:
                return (f"the bus was migrated ({self.summary}) before the command was stopped; run "
                        "agentbus upgrade DIR again to finish replacing the copy" if self.summary else None)
            self._undo()
        finally:
            self.lock.release()
        return None

    def _undo(self):
        for tmp in list(self.tmps):
            try:
                os.unlink(tmp, dir_fd=self.dfd)
            except (OSError, TypeError):
                pass
        if self.empty_wal:  # only when the watchdog ends the process: nothing else can use it then
            try:
                st = os.lstat(self.empty_wal)
                if stat.S_ISREG(st.st_mode) and st.st_size == 0 and st.st_nlink == 1 and _owned(st):
                    os.unlink(self.empty_wal)
            except OSError:
                pass
        for name in ([self.partial] if self.partial else []) + self.names:
            try:
                os.unlink(name, dir_fd=self.dfd)
            except (OSError, TypeError):
                pass
        if self.made_dir:
            try:
                os.rmdir(self.made_dir)  # only if empty; a link there is not a directory to remove
            except OSError:
                pass

    def close(self):
        if self.dfd is not None:
            os.close(self.dfd)
            self.dfd = None


def take_backup(con, path, version, deadline, old_copy=None, undo=None):
    """A verified copy of bus.db in backups/, taken with the exclusive lock held, before any migrating
    write. Never by name through SQLite: the bytes come from our own pinned O_NOFOLLOW fd on the bus
    and go into a file we created with O_EXCL|O_NOFOLLOW under the backups folder's fd. Returns the
    backup's name (a reused one when a dead run already made it)."""
    size = os.fstat(con.pin).st_size + (os.lstat(path + "-wal").st_size if os.path.lexists(path + "-wal") else 0)
    vfs = os.statvfs(os.path.dirname(path))
    free, need = vfs.f_bavail * vfs.f_frsize, 2 * size + BACKUP_SPARE
    if os.environ.get("AGENTBUS_TEST_BACKUP_FAIL") == "space":
        free = need - 1
    if free < need:
        backup_failed(path, f"not enough free space for a backup; free {-(-(need - free) // (1 << 20))} MB or move the bus")
    busy, _, _ = con.execute("PRAGMA wal_checkpoint(TRUNCATE)").fetchone()
    if busy:
        backup_failed(path, "the bus could not be checkpointed")
    _test_pause("after-checkpoint")
    # The bus itself must pass SQLite's quick_check (on our own audited connection, never by naming a
    # file); the backup is then checked byte for byte against it, so it passes too.
    problems = [r[0] for r in con.execute("PRAGMA quick_check").fetchall()]
    if problems != ["ok"]:
        backup_failed(path, "the bus fails SQLite's quick_check (" + "; ".join(map(str, problems[:3])) + "); it is not migrated")
    size = os.fstat(con.pin).st_size
    undo = undo or _Undo()
    if not os.path.lexists(os.path.join(os.path.dirname(path), "backups")):
        undo.made_dir = os.path.join(os.path.dirname(path), "backups")
    d, dfd = _backups_dir(path)
    undo.dfd = dfd
    partial = None
    try:
        name = _reusable_backup(con, dfd, version, size, deadline)
        if name:
            if old_copy:
                undo.names += _keep_copy(dfd, name, old_copy, undo)
            return os.path.join(d, name)
        stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
        for k in range(1, 100):
            name = f"bus-v{version}-{stamp}{'' if k == 1 else f'-{k}'}.db"
            if _entry_stat(name, dfd) is not None or os.path.lexists(os.path.join(d, name)):
                continue
            try:
                out = os.open(name + ".partial", os.O_RDWR | os.O_CREAT | os.O_EXCL | NOFOLLOW, 0o600, dir_fd=dfd)
            except FileExistsError:
                continue
            except OSError as e:
                backup_failed(path, f"cannot create {name}.partial: {e.strerror}")
            partial = name + ".partial"
            undo.partial = partial
            break
        else:
            backup_failed(path, "no free backup name")
        try:
            off = 0
            while off < size:
                if time.monotonic() > deadline:
                    raise TimeoutError
                block = os.pread(con.pin, min(COPY_BLOCK, size - off), off)
                if not block:
                    break
                if os.environ.get("AGENTBUS_TEST_BACKUP_FAIL") == "enospc":
                    raise OSError(errno.ENOSPC, os.strerror(errno.ENOSPC))
                if os.environ.get("AGENTBUS_TEST_BACKUP_FAIL") == "corrupt" and off == 0:
                    block = bytes([block[0] ^ 0xFF]) + block[1:]  # test hook: a bad write
                _write_fd_all(out, block)
                off += len(block)
                if off == len(block):
                    _test_pause("mid-copy")
                    _test_slow()
            os.fsync(out)
            if time.monotonic() > deadline:
                raise TimeoutError
            st = os.fstat(out)
            if st.st_size != size or off != size or st.st_nlink != 1 or not _owned(st) \
                    or stat.S_IMODE(st.st_mode) != 0o600 or not stat.S_ISREG(st.st_mode) \
                    or not _same_bytes(con.pin, out, size, deadline):
                raise OSError(errno.EIO, "the backup does not match the bus")
            # Publish exactly the file we wrote and checked: link (never replaces an existing
            # name), then the name must be our descriptor's file.
            try:
                os.link(partial, name, src_dir_fd=dfd, dst_dir_fd=dfd, follow_symlinks=False)
            except FileExistsError:
                raise OSError(errno.EEXIST, f"{name} appeared while the backup was written; not replaced")
            linked = _entry_stat(name, dfd)
            if linked is None or _ident(linked) != _ident(st):
                raise OSError(errno.EIO, f"{name} is not the file that was written; not used")
            undo.names.append(name)
            os.unlink(partial, dir_fd=dfd)
            partial = undo.partial = None
            published = _ident(st)
            if old_copy:
                undo.names += _keep_copy(dfd, name, old_copy, undo)
        except TimeoutError:
            backup_failed(path, f"the backup did not finish within {migrate_budget():g} s")
        except OSError as e:
            backup_failed(path, e.strerror or str(e))
        finally:
            os.close(out)
        os.fsync(dfd)
        _test_pause("after-backup")
        st = _entry_stat(name, dfd)
        if st is None or st.st_size != size or _ident(st) != published:
            backup_failed(path, f"the backup {name} is gone or changed")  # nothing is migrated without it
        return os.path.join(d, name)
    finally:
        if partial is not None:
            try:
                os.unlink(partial, dir_fd=dfd)
            except OSError:
                pass
            undo.partial = None


def migrate_bus(con, path, info, old_copy=None):
    """Bring an older bus to SCHEMA_VERSION: rehearse the statements on its schema, back it up (a
    verified copy), then run them, check the result as every open does, stamp the version and log
    it, all in one transaction that a failed check rolls back. On its own budget (MIGRATE_BUDGET_S).
    Records what changed on con.migrated."""
    have, entry = info
    plan = migration_steps(have, entry)
    rehearse(con, plan)
    budget = migrate_budget()
    start = time.monotonic()
    con.deadline = start + budget
    WATCHDOG.arm(budget + HOLD_GRACE_S, f"{path}: upgrading the bus did not finish within {budget:g} s and was "
                 "stopped; nothing was changed")
    # Everything the migration makes in backups/ is removed again unless it commits, also when the
    # watchdog stops it, so a failed upgrade leaves the folder as it was.
    undo = _Undo()
    if not con.wal_was_there:
        undo.empty_wal = path + "-wal"  # SQLite made it for this connection; a stopped run leaves it empty
    _KILL_CLEANUP.append(undo.run)
    undo.bus, undo.schema = path, (have, SCHEMA_VERSION)
    if _UPGRADE_MIGRATIONS is not None:
        _UPGRADE_MIGRATIONS.append(undo)  # the upgrade names it if a Ctrl-C comes once it has committed
    try:
        backup = take_backup(con, path, have, start + budget, old_copy, undo)
        undo.summary, undo.backup = f"schema {have} -> {SCHEMA_VERSION}, backup {backup}", backup
        # Under upgrade the migration is the command's change (committed: true after it); for any other
        # command it is setup, like the stamp, and the command's own write is what counts.
        with immediate(con, record=_UPGRADE_MIGRATIONS is not None, guard=undo):
            if user_version(con) != have:
                die(f"{path} changed while it was being upgraded; retry", "busy", bus=path)
            for _, stmts in plan:
                for stmt in stmts:
                    con.execute(stmt)
            check_schema(con)
            check_objects(con, index_sql=True)
            con.execute(f"PRAGMA user_version={SCHEMA_VERSION}")
            log(con, "agentbus", "migrate", f"v{have} -> v{SCHEMA_VERSION}, backup {os.path.basename(backup)}")
            _test_pause("before-commit")
        # Old backups are pruned only once the migration has committed: a failed or stopped one keeps every backup
        # that was there before it (its own is removed by the undo).
        try:
            _prune_backups(undo.dfd, os.path.basename(backup))
        except OSError:
            pass  # old backups stay; never a reason to stop
    except BaseException:
        undo.empty_wal = None  # the process lives on and SQLite still has it open
        if not undo.committed:
            undo.run()
        raise
    finally:
        _KILL_CLEANUP.remove(undo.run)
        undo.close()
    con.migrated = {"from": have, "to": SCHEMA_VERSION, "backup": backup}
    # Back to an ordinary command's budgets for whatever the command does next.
    con.deadline = time.monotonic() + query_budget()
    WATCHDOG.arm(hold_budget(), held_too_long_message(path), held_too_long_message(path, committing=True))


def create_schema(con, indexes=True):
    """Create SCHEMA's tables and (indexes=True) indexes, also used for reference shapes."""
    stmts = [x for x in SCHEMA.split(";") if x.strip()]
    for stmt in [x for x in stmts if "CREATE TABLE" in x]:
        con.execute(stmt)
    if indexes:
        for stmt in [x for x in stmts if "CREATE TABLE" not in x]:
            con.execute(stmt)


# SQL text as tokens, for comparing a table's definition with agentbus's whatever its spacing,
# case, comments or identifier quoting: the clauses no pragma reports (CHECK, COLLATE on a column
# no index covers, ON CONFLICT, WITHOUT ROWID, STRICT) are then caught as tokens agentbus's lacks.
_SQL_TOKEN = re.compile(r"""\s+|--[^\n]*|/\*.*?(?:\*/|\Z)|'(?:[^']|'')*'|"(?:[^"]|"")*"|`(?:[^`]|``)*`|\[[^\]]*\]|\w+|.""",
                        re.S)


def sql_tokens(sql):
    out = []
    for m in _SQL_TOKEN.finditer(str(sql or "")):
        t = m.group()
        if t[0].isspace() or t.startswith("--") or t.startswith("/*"):
            continue
        if t[0] in "\"`" and len(t) > 1:
            t = t[1:-1].replace(t[0] * 2, t[0]).lower()  # a quoted identifier is the identifier
        elif t[0] == "[" and len(t) > 1:
            t = t[1:-1].lower()
        elif t[0] != "'":
            t = t.lower()
        out.append(t)
    return tuple(out)


def _qid(name):
    return '"' + str(name).replace('"', '""') + '"'


def table_shape(con, t):
    """Everything about table t that changes what agentbus's statements do, from SQLite's own
    pragmas (formatting-independent), plus its definition as tokens; None when t does not exist."""
    cols = tuple(tuple(r)[1:] for r in con.execute(f"PRAGMA table_xinfo({_qid(t)})"))
    if not cols:
        return None
    auto, named = {}, {}
    for r in con.execute(f"PRAGMA index_list({_qid(t)})").fetchall():
        _, name, unique, origin, part = tuple(r)[:5]
        info = (unique, origin, part, tuple(tuple(x) for x in con.execute(f"PRAGMA index_xinfo({_qid(name)})")))
        (named if origin == "c" else auto)[name] = info
    fks = tuple(sorted(tuple(r)[2:] for r in con.execute(f"PRAGMA foreign_key_list({_qid(t)})")))
    sql = con.execute("SELECT sql FROM sqlite_master WHERE type='table' AND name=?", (t,)).fetchone()
    return {"columns": cols, "auto": auto, "named": named, "fks": fks, "sql": sql_tokens(sql[0] if sql else "")}


@lru_cache(maxsize=1)
def reference_shapes():
    """Current table shapes, built in memory by the real creation path."""
    ref = sqlite3.connect(":memory:")
    try:
        create_schema(ref)
        return {t: table_shape(ref, t) for t in TABLES}
    finally:
        ref.close()


_COLUMN_FIELDS = ("name", "type", "notnull", "default", "pk", "hidden")


def _fk_text(fks):
    return "; ".join(f"{f} -> {tb}({to}) on update {u} on delete {d} match {m}" for tb, f, to, u, d, m in fks) or "none"


def _index_text(name, info):
    unique, origin, part, cols = info
    keys = ", ".join(f"{c[2]}{' DESC' if c[3] else ''} COLLATE {c[4]}" for c in cols if c[5])
    return f"{'unique ' if unique else ''}{'partial ' if part else ''}index {name} ({origin}) on ({keys})"


def shape_difference(have, want):
    """What differs between two table shapes, as text, or None when they are the same (named
    indexes aside: check_schema reports those as the index they are)."""
    hc, wc = have["columns"], want["columns"]
    if hc != wc:
        hn, wn = [c[0] for c in hc], [c[0] for c in wc]
        missing, extra = [n for n in wn if n not in hn], [n for n in hn if n not in wn]
        if missing:
            return "no column " + ", ".join(map(str, missing))
        if extra:
            return "extra column " + ", ".join(map(str, extra))
        if hn != wn:
            return f"columns in the order ({', '.join(map(str, hn))}), not ({', '.join(map(str, wn))})"
        for h, w in zip(hc, wc):
            for i, field in enumerate(_COLUMN_FIELDS):
                if h[i] != w[i]:
                    return f"column {h[0]} has {field} {h[i]!r}, not {w[i]!r}"
    if have["auto"] != want["auto"]:
        for name in sorted(set(have["auto"]) | set(want["auto"]), key=str):
            h, w = have["auto"].get(name), want["auto"].get(name)
            if h != w:
                if w is None:
                    return "extra " + _index_text(name, h)
                if h is None:
                    return "no " + _index_text(name, w)
                return f"{_index_text(name, h)}, not {_index_text(name, w)}"
    if have["fks"] != want["fks"]:
        return f"foreign keys {_fk_text(have['fks'])}, not {_fk_text(want['fks'])}"
    if have["sql"] != want["sql"]:
        h, w = have["sql"], want["sql"]
        i = next((k for k in range(min(len(h), len(w))) if h[k] != w[k]), min(len(h), len(w)))
        return (f"its definition has {' '.join(h[i:i + 4]) or 'nothing'!r} where agentbus's has "
                f"{' '.join(w[i:i + 4]) or 'nothing'!r}")
    return None


def check_schema(con, before_setup=False):
    """Exit cleanly unless every table has agentbus's own shape: the same columns (name, type,
    NOT NULL, default, primary key, hidden), the same indexes including SQLite's automatic ones
    (unique, origin, partial, columns, collation, order), the same foreign keys and actions, and
    the same definition token for token (no CHECK, COLLATE, ON CONFLICT, GENERATED, WITHOUT ROWID
    or STRICT agentbus's lacks). A lane can rebuild a table: `body ... UNIQUE ON CONFLICT REPLACE`
    made every post delete earlier posts with the same text, and `sender REFERENCES agents(name) ON
    DELETE CASCADE` made a leave delete that agent's messages. With before_setup (no write has
    run yet), a missing index is fine (it is about to be created), and so are missing tables, but
    only all of them: a new bus. This release creates all seven tables at once, in one transaction, so an existing bus that lacks one was
    changed by a lane (or another tool); recreating it empty would hide that."""
    accepted = reference_shapes()
    shapes = {t: table_shape(con, t) for t in TABLES}
    missing = [t for t in TABLES if shapes[t] is None]
    if missing and (not before_setup or len(missing) < len(TABLES)):
        die(f"bus schema is not agentbus's: {'table' if len(missing) == 1 else 'tables'} "
            f"{', '.join(missing)} {'is' if len(missing) == 1 else 'are'} missing. Another agent (or tool) "
            f"dropped {'it' if len(missing) == 1 else 'them'}; restore the bus from a copy, or move it aside to start a new one", "schema_refused")
    for t in TABLES:
        have = shapes[t]
        if have is None:
            continue
        want = accepted[t]
        diff = shape_difference(have, want)
        if diff is not None:
            die(f"bus schema is not agentbus's: table {t} differs ({diff})", "schema_refused")
        for name, info in have["named"].items():
            if want["named"].get(name) != info:
                unexpected("index", name)
        if not before_setup and set(have["named"]) != set(want["named"]):
            die(f"bus schema is not agentbus's: table {t} differs (no index "
                f"{', '.join(sorted(set(want['named']) - set(have['named'])))})", "schema_refused")
    seq = con.execute("SELECT sql FROM sqlite_master WHERE type='table' AND name='sqlite_sequence'").fetchone()
    if seq and sql_tokens(seq[0]) != ("create", "table", "sqlite_sequence", "(", "name", ",", "seq", ")"):
        die("bus schema is not agentbus's: table sqlite_sequence differs (its definition is not SQLite's own)", "schema_refused")


def unexpected(typ, name):
    die(f"bus schema is not agentbus's: unexpected {typ} {name}. Another agent (or tool) added it; "
        "agentbus does not run schema objects it did not create. Check what it is, then drop it", "schema_refused")


def _sql_words(sql):
    return " ".join(str(sql).replace("(", " ( ").replace(")", " ) ").replace(",", " , ").split()).lower()


@lru_cache(maxsize=1)
def reference_indexes():
    """{index name: (its table, its CREATE statement, normalised)} for the indexes SCHEMA names."""
    ref = sqlite3.connect(":memory:")
    try:
        ref.executescript(SCHEMA)
        return {r[0]: (r[1], _sql_words(r[2])) for r in
                ref.execute("SELECT name, tbl_name, sql FROM sqlite_master WHERE type='index' AND sql IS NOT NULL")}
    finally:
        ref.close()


def check_objects(con, index_sql=False):
    """Exit cleanly when the bus holds a schema object agentbus did not create: a trigger, a view,
    a virtual table, or a table or index by a name SCHEMA does not use (or a named index that is not
    SCHEMA's own). Expected besides SCHEMA's tables and indexes: SQLite's sqlite_sequence and the
    automatic indexes behind a PRIMARY KEY (check_schema then compares those by shape). Triggers
    and views run inside the caller's connection (a trigger rewrote a brain's post; one looped
    forever holding the lock), so this runs before any statement that could fire or read one.
    Matched by exact type and name. A named index is also compared by its definition with
    index_sql=True, which runs after check_schema, so a renamed column (which rewrites the index
    over it) is reported as the column it is."""
    named = reference_indexes()
    for typ, name, tbl, sql in con.execute("SELECT type, name, tbl_name, sql FROM sqlite_master").fetchall():
        if typ == "table" and (name in TABLES or name == "sqlite_sequence") and tbl == name \
                and isinstance(sql, str) and _sql_words(sql).startswith("create table "):
            continue
        if typ == "index" and isinstance(name, str) and name.startswith("sqlite_autoindex_") \
                and sql is None and tbl in TABLES:
            continue
        if typ == "index" and name in named and (not index_sql or (tbl, _sql_words(sql)) == named[name]):
            continue
        unexpected(typ, name)


@contextmanager
def _sigint_deferred():
    """Hold SIGINT back (blocked, so it stays pending) while the body runs in the main thread."""
    import signal
    if threading.current_thread() is not threading.main_thread() or not hasattr(signal, "pthread_sigmask"):
        yield
        return
    old = signal.pthread_sigmask(signal.SIG_BLOCK, {signal.SIGINT})
    try:
        yield
    finally:
        signal.pthread_sigmask(signal.SIG_SETMASK, old)


def _commit(con, pending, record):
    """COMMIT. While rows are pending, _IN_COMMIT says so ("own" when record: the command's own write), so the hold
    watchdog can tell a stop during the commit, whose outcome is unknown, from one before it, where the write was
    rolled back. Every write transaction commits here, and the commit is noted (_WROTE) before the flag is
    cleared, so a stop in between still reads as possibly saved."""
    global _IN_COMMIT, _WROTE, _WROTE_ROWS
    _IN_COMMIT = ("own" if record else "setup") if pending else None
    try:
        if pending:
            _test_stall_commit()
        con.execute("COMMIT")
        if record and pending:
            _WROTE = _WROTE_ROWS = True
    finally:
        _IN_COMMIT = None


@contextmanager
def immediate(con, record=True, guard=None):
    """One write transaction, taken up front so a check and the write it guards cannot interleave
    with another agent's, and verified first: the path must still name the file this connection
    holds. record: a commit that changed rows is noted (_WROTE, _WROTE_ROWS) for the error contract."""
    con.execute("BEGIN IMMEDIATE")
    changes = con.total_changes
    try:
        if isinstance(con, Bus):
            con.verify()
        yield
    except BaseException as e:
        if _TIMED_OUT:
            con.set_progress_handler(None, 0)  # or the ROLLBACK would be stopped too
        if con.in_transaction:
            con.execute("ROLLBACK")
        if isinstance(e, sqlite3.OperationalError) and "full" in str(e):
            full = id_exhausted(con)
            if full:
                die(full, "bus_unavailable")
        raise
    # A command's own commit and the note that it happened are one step: a Ctrl-C that arrives meanwhile is
    # held until both are done and raised then, so an interrupted error never says committed false for a saved write.
    # With a guard (a migration), the watchdog's lock is held too and guard.committed is set in the same step.
    pending = con.total_changes != changes  # rows to save: the only commit whose outcome a stop can leave unknown
    if guard is not None:
        with _sigint_deferred(), guard.lock:
            if record:
                _test_pause("commit")
            _commit(con, pending, record)
            guard.committed = True
        return
    # A command's own commit and the note that it happened are one step: a Ctrl-C that arrives meanwhile is
    # held until both are done and raised then, so an interrupted error never says committed false for a saved write.
    held, old = [], None
    if record and callable(signal.getsignal(signal.SIGINT)):
        try:
            old = signal.signal(signal.SIGINT, lambda *_: held.append(1))
        except ValueError:  # not the main thread
            old = None
    try:
        if record:
            _test_pause("commit")
        _commit(con, pending, record)
    finally:
        if old is not None:
            signal.signal(signal.SIGINT, old)
    if held:
        raise KeyboardInterrupt


MAX_ID = 2 ** 63 - 1
AUTOINCREMENT_TABLES = ("messages", "context_history", "log")


def id_exhausted(con):
    """Why an insert failed with "database or disk is full" when the cause is an id, else None. With
    AUTOINCREMENT, SQLite gives up once a table's largest id (or its sqlite_sequence entry) is
    2**63-1, which only a lane writing the row directly can reach; every insert then fails. The
    comparison is SQLite's own (CAST, as AUTOINCREMENT reads seq), so a seq stored as TEXT, REAL or
    BLOB counts exactly when SQLite would count it."""
    seq = {}
    if con.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name='sqlite_sequence'").fetchone():
        seq = {r[0]: r[1] for r in con.execute(
            "SELECT name, typeof(seq) FROM sqlite_sequence WHERE CAST(seq AS INTEGER) >= ?", (MAX_ID,))}
    full, odd = [], []
    for t in AUTOINCREMENT_TABLES:
        top = con.execute(f'SELECT MAX(id) >= ? FROM "{t}"', (MAX_ID,)).fetchone()[0]
        if top or t in seq:
            full.append(t)
            if t in seq and seq[t] != "integer":
                odd.append(f"{t} ({seq[t].upper()})")
    if not full:
        return None
    return (f"cannot add a row: {'table' if len(full) == 1 else 'tables'} {', '.join(full)} {'has' if len(full) == 1 else 'have'} reached id {MAX_ID} (2**63-1), the largest SQLite "
            "allows, so every insert into it fails (\"database or disk is full\"). Only an agent writing rows "
            "directly can get there: check that row, delete it and lower its sqlite_sequence entry"
            + (f". Not an integer in sqlite_sequence, read as one: {', '.join(odd)}" if odd else ""))


# ---------- claims: resources ----------

# Resources with a scheme prefix (issue:17, table:tenants, area:billing) are opaque names compared
# exactly. Anything else is a bus-relative path, stored normalised: a claim on X covers X/...
_SCHEME = re.compile(r"[A-Za-z][A-Za-z0-9+._-]*:")
# The longest resource `claim` takes, in characters. Text a lane stored in any field is cut to this
# length wherever agentbus builds text from it with the bus held (log rows, a refusal naming a
# holder), so a planted 100 MB name never becomes a 100 MB log row or error.
RESOURCE_MAX = 1024
# The byte length of a stored value, from its record header when SQLite has octet_length (3.43+):
# length() reads the whole value first, which for a planted 100 MB name is 100 MB per row per open.
BYTE_LENGTH = "octet_length" if sqlite3.sqlite_version_info >= (3, 43) else "length"


def cut(col, n=RESOURCE_MAX):
    """SQL for column col, cut to n characters (text a lane stored can be any length), marked with
    `...` when it was longer."""
    return f"(CASE WHEN length({col}) > {n} THEN substr({col}, 1, {n}) || '...' ELSE {col} END)"


def is_path(resource):
    return not _SCHEME.match(resource)


def norm_resource(resource, strict=True):
    """The stored form of a claimed resource. Paths: posixpath.normpath, no leading ./, a trailing /
    kept as the folder marker; absolute paths and paths that climb out with .. are refused (a claim
    must name the same thing in every worktree). With strict=False (rows planted directly)
    a bad path comes back unchanged instead of exiting."""
    if strict and len(resource) > RESOURCE_MAX:
        die(f"cannot claim a resource of {len(resource)} characters: at most {RESOURCE_MAX}. Claim the folder above it, or use area:NAME", "bad_input")
    if not is_path(resource):
        return resource
    def bad(why):
        if strict:
            die(f"cannot claim '{resource}': {why}. For example: agentbus --as NAME claim src/app/ --purpose WHY", "bad_input",
                next="agentbus --as NAME claim src/app/ --purpose WHY")
        return resource
    if resource.startswith("/"):
        return bad("use a bus-relative path, not an absolute one")
    n = posixpath.normpath(resource)
    if n in ("", "."):
        return bad("name a path inside the bus directory")
    if n == ".." or n.startswith("../"):
        return bad("it climbs out of the bus directory")
    return n + "/" if resource.endswith("/") else n


# A text resource posixpath.normpath (or the folder-marker rule) could rewrite: an empty, . or ..
# component, a doubled slash, or a doubled trailing slash. Everything else is stored as
# norm_resource would store it, so the common open reads no claim at all. A resource longer than
# `claim` takes (RESOURCE_MAX characters, so at most 4 bytes each) is skipped by its header length
# before any GLOB reads it: no version of agentbus stored one, and a planted 100 MB name would
# otherwise be read eight times per open. It stays as it is, for `claims` to show and `release` or
# `leave` to remove.
_NEEDS_NORM = (f"typeof(resource)='text' AND {BYTE_LENGTH}(resource) <= {4 * RESOURCE_MAX} AND (resource GLOB '*//*' "
               "OR resource GLOB './*' OR resource GLOB '*/./*' "
               "OR resource GLOB '*/.' OR resource GLOB '*/../*' OR resource GLOB '*/..' OR resource IN ('.', '..') "
               "OR resource GLOB '../*')")
NORMALIZE_BATCH = 500


def normalize_stored_claims(con):
    """Rewrite unnormalised claims planted directly (./a//b.py) in their normalised form, inside the
    caller's transaction. Two rows that become one keep the later expiry; the dropped holder and
    resource are logged, since they may be another agent's claim."""
    # Only rows norm_resource could change are read: one scan in SQLite (under the query budget),
    # then at most NORMALIZE_BATCH rows per open in Python, so a lane that planted many such rows
    # never holds the lock for long; the rest are normalised by the next opens, and overlaps()
    # normalises whatever it compares in the meantime. _raw: the stored bytes, so a row whose text
    # is not UTF-8 (read back with U+FFFD) is still deleted by its real value.
    # The row's other fields are read cut (cut()) and copied by SQL, never through Python whole.
    for r in con.execute(f"SELECT resource, CAST(resource AS BLOB) AS _raw, {cut('agent')} AS agent, "
                         f"{cut('expires_at')} AS expires_at, typeof(expires_at) AS et FROM claims WHERE {_NEEDS_NORM} LIMIT ?",
                         (NORMALIZE_BATCH,)).fetchall():
        if not isinstance(r["resource"], str) or r["et"] != "text":
            continue  # not a row any version of this tool wrote; left for claims to show
        n = norm_resource(r["resource"], strict=False)
        if n == r["resource"]:
            continue
        other = con.execute(f"SELECT {cut('agent')}, {cut('expires_at')}, typeof(expires_at) FROM claims WHERE resource=?",
                            (n,)).fetchone()
        if other and (other[2] != "text" or other[1] >= r["expires_at"]):
            con.execute("DELETE FROM claims WHERE resource=CAST(? AS TEXT)", (r["_raw"],))
            log(con, r["agent"], "claim", f"{r['resource']} held by {r['agent']} until {r['expires_at']} dropped: "
                f"it normalises to {n}, held by {other[0]} until {other[1]} (normalised)")
            continue
        if other:
            log(con, other[0], "claim", f"{n} held by {other[0]} until {other[1]} dropped: {r['resource']}, "
                f"held by {r['agent']} until {r['expires_at']}, normalises to it and expires later (normalised)")
        con.execute("INSERT OR REPLACE INTO claims(resource,agent,purpose,claimed_at,expires_at) "
                    "SELECT ?, agent, purpose, claimed_at, expires_at FROM claims WHERE resource=CAST(? AS TEXT)",
                    (n, r["_raw"]))
        con.execute("DELETE FROM claims WHERE resource=CAST(? AS TEXT)", (r["_raw"],))
        log(con, r["agent"], "claim", f"{r['resource']} renamed to {n} (normalised)")


def overlap_filters(res):
    """[(SQL condition, params)] that together match every stored claim overlapping res (normalised):
    the same resource, or (paths) a folder holding it or a path inside it, with or without the
    trailing /. Each is an equality or a range on the resource index, so SQLite reads only the
    claims that overlap, never every claim a lane planted. The folders above res are matched in
    chunks, so no statement carries more parameters than any SQLite build allows (999 before 3.32)."""
    if not is_path(res):
        return [("resource=?", [res])]
    s = res.rstrip("/")
    parts = s.split("/")
    forms = []
    for i in range(1, len(parts) + 1):
        folder = "/".join(parts[:i])
        forms += [folder, folder + "/"]
    out = [(f"resource IN ({','.join('?' * len(forms[k:k + 400]))})", forms[k:k + 400])
           for k in range(0, len(forms), 400)]
    # Everything inside s: the text that starts with s + "/" ("0" is the character after "/").
    out.append(("resource >= ? AND resource < ?", [s + "/", s + "0"]))
    return out


AUTO_RELEASE_SHOWN = 20  # stale claims a claim lists (output, log rows) when it releases them
UNDECODED_SCAN = 1000  # rows read to match a resource with U+FFFD against stored bytes that are not UTF-8


def overlaps(x, y):
    """Two claims conflict when they name the same resource, or one path is a folder holding the other
    (with or without the trailing /)."""
    x, y = norm_resource(x, strict=False), norm_resource(y, strict=False)
    if not (is_path(x) and is_path(y)):
        return x == y
    x, y = x.rstrip("/"), y.rstrip("/")
    return x == y or y.startswith(x + "/") or x.startswith(y + "/")


def undecoded_overlaps(con, res, name, t):
    """Stored claims whose bytes are not UTF-8 but read (with U+FFFD) as overlapping res: only
    possible when res holds U+FFFD, since the SQL filters compare bytes. Candidates are the claims
    from res's text before its first U+FFFD up to that prefix followed by 0xFF 0xFF (above every UTF-8
    byte), an index range, at most UNDECODED_SCAN of them. Returns [(raw bytes, row)]."""
    if "\ufffd" not in res:
        return []
    p = res[:res.index("\ufffd")]
    rows = con.execute(f"SELECT CAST(resource AS BLOB) AS _raw, resource, {cut('agent')} AS agent, "
                       f"{cut('expires_at')} AS expires_at, {cut('purpose')} AS purpose FROM claims "
                       "WHERE resource >= ? AND resource < CAST(? AS TEXT) AND typeof(resource)='text' "
                       "AND agent<>? AND expires_at>? LIMIT ?",
                       (p, p.encode() + b"\xff\xff", name, t, UNDECODED_SCAN)).fetchall()
    out = []
    for r in rows:
        raw = bytes(r["_raw"])
        try:
            raw.decode("utf-8")
            continue  # valid UTF-8: the SQL filters already compared it
        except UnicodeDecodeError:
            pass
        if len(r["resource"]) <= RESOURCE_MAX and overlaps(r["resource"], res):
            out.append((raw, r))
    return out


def _is_text(param):
    """SQL comparing to a parameter as text (a stored BLOB never equals it)."""
    return f"CAST({param} AS TEXT)"


def same_path_forms(res):
    """Every stored spelling of one path resource: with and without the folder marker."""
    if not is_path(res):
        return [res]
    s = res.rstrip("/")
    return [s, s + "/"]


# ---------- commands ----------

def ident(args):
    return args.as_ or os.environ.get("AGENTBUS_AGENT") or None


def me(args):
    name = ident(args)
    if not name:
        die("say who you are with --as NAME or AGENTBUS_AGENT=NAME. For example: " + identity_example(args), "bad_input",
            next=identity_example(args))
    return name


ROSTER_SHOWN = 10   # names of the roster an error or a warning lists; the rest are counted


def or_list(names):
    """alpha, alpha or beta, alpha, beta or gamma."""
    return names[0] if len(names) == 1 else ", ".join(names[:-1]) + " or " + names[-1]


def roster_view(con, name):
    """(the roster names closest to `name`, the roster as errors show it, how many agents are on it).
    Bounded, because a lane can plant any number of agents with any name under the bus lock: only short text names
    are compared (a name join accepts is at most 40 characters), at most 1000 of them; the roster shown is the
    ROSTER_SHOWN most recently seen, by name."""
    close = []
    if len(name) <= 64:
        names = [r[0] for r in con.execute("SELECT name FROM agents WHERE typeof(name)='text' AND length(name)<=64 "
                                            "ORDER BY name LIMIT 1000")]
        close = difflib.get_close_matches(name, names, n=3, cutoff=0.6)
    shown = sorted(r[0] for r in con.execute("SELECT name FROM agents WHERE typeof(name)='text' AND length(name)<=64 "
                                             "ORDER BY last_seen DESC, name LIMIT ?", (ROSTER_SHOWN,)))
    total = con.execute("SELECT COUNT(*) FROM agents").fetchone()[0]
    return close, shown, total


def roster_text(shown, total):
    """On the roster: alpha, gamma. With more agents than are named: ... (+4 more: agentbus who)."""
    if not shown:
        return "Nobody has joined yet."
    more = f" (+{total - len(shown)} more: agentbus who)" if total > len(shown) else ""
    return "On the roster: " + ", ".join(shown) + more + "."


def refuse_invalid_name(name):
    """A name join would never accept (HOOK_NAME_RE): bad_input with the rule and a valid example to run. One
    message for join and for every write, so no error ever suggests a join that would itself be refused."""
    die(f"'{name}' is not a valid name. Use 1 to 40 letters, digits, dots, underscores or hyphens ([A-Za-z0-9._-]). Then run: agentbus --as NAME join",
        "bad_input", next="agentbus --as NAME join", field="name")


def require_joined(con, name):
    """Every write is made by a name on the roster: inside the caller's transaction, refuse one that
    has not joined (or left) or could never join. A name close to one that has is probably a typo: the error says so, lists
    the roster, and still names the join command."""
    if con.execute("SELECT 1 FROM agents WHERE name=?", (name,)).fetchone():
        return   # a name already on the bus works, even one that predates the name rule
    if not HOOK_NAME_RE.fullmatch(name):
        refuse_invalid_name(name)   # it could never join: say so, not "join first"
    close, shown, total = roster_view(con, name)
    join = f"agentbus --as {shlex.quote(name)} join"
    if close:
        die(f"{name} is not on the roster. Did you mean {or_list(close)}? {roster_text(shown, total)} To join as {name}: {join}",
            "not_on_roster", next=join, agent=name, did_you_mean=close, roster=shown)
    die(f"{name} is not on the roster. Run: {join}", "not_on_roster", next=join, agent=name, did_you_mean=[], roster=shown)


def roster_warnings(con, to):
    """The warnings for a message addressed to `to`: [] for a broadcast or a name on the roster, else one
    recipient_not_on_roster with the closest roster names and the roster. The message is still delivered
    (it waits for that name); this only says the name may be a typo."""
    if to == "*" or con.execute("SELECT 1 FROM agents WHERE name=?", (to,)).fetchone():
        return []
    close, shown, total = roster_view(con, to)
    return [{"code": "recipient_not_on_roster", "name": to, "did_you_mean": close, "roster": shown, "roster_total": total}]


def warn_text(w):
    """A warning as one stderr line."""
    text = f"{w['name']} is not on the roster; the message waits for that name."
    if w["did_you_mean"]:
        text += f" Did you mean {or_list(w['did_you_mean'])}?"
    return text + " " + roster_text(w["roster"], w["roster_total"])


def request_reused(token, name, original_id, original, what, same):
    """The one refusal for a request id reused with a different request: it names the original and the way out."""
    die(f"request id '{token}' was already used with a different {what}. Original: {original}. "
        f"Reuse the same {same} or pick a new --request-id.", "request_id_reused",
        request_id=token, agent=name, original_id=original_id)


def touch(con, name):
    with immediate(con, record=False):
        con.execute("UPDATE agents SET last_seen=? WHERE name=?", (now(), name))


def plural(n, word):
    """1 claim, 0 claims, 5 claims."""
    return f"{n} {word}" + ("" if n == 1 else "s")


def log(con, agent, action, detail=""):
    return con.execute("INSERT INTO log(ts,agent,action,detail) VALUES(?,?,?,?)", (now(), agent, action, detail)).lastrowid


def clean_row(r):
    """Every field escaped for the terminal; only a message body keeps its newlines. A lane can
    store any SQLite type in any column: numbers stay numbers, NULL (allowed in several columns,
    and in any column of a table a lane rebuilt) is shown empty, anything else (a BLOB) is shown as
    its repr. (--json does the same through json.dumps(default=repr); non-finite floats become strings.)"""
    def one(k, v):
        if isinstance(v, str):
            return clean(v, newlines=(k == "body"))
        if v is None:
            return ""
        if isinstance(v, (int, float)):
            return v
        return clean(repr(v), backslash=False)  # repr already shows a backslash as \\\\
    return {k: one(k, v) for k, v in r.items()}


def jsonable(v):
    """v with every non-finite float (a lane can store inf or -inf in any column) as its string,
    so json.dumps(allow_nan=False) never emits Infinity or NaN, which are not JSON."""
    if isinstance(v, float) and not math.isfinite(v):
        return repr(v)
    if isinstance(v, dict):
        return {k: jsonable(x) for k, x in v.items()}
    if isinstance(v, (list, tuple)):
        return [jsonable(x) for x in v]
    return v


def json_style():
    """json.dumps keywords for stdout: indented on a terminal, compact (no indent, no spaces) when stdout is
    a pipe or a file, where an agent pays for every byte. The same values either way."""
    return {"indent": 2} if stdout_is_tty() else {"separators": (",", ":")}


def with_contract(obj):
    """A --json result with `contract` (the JSON contract version) as its first key. One rule for every result:
    the same name in every command, and in `schema`, so a reader can tell which contract a copy follows."""
    assert isinstance(obj, dict), "a --json result is an object"
    return {"contract": CONTRACT["contract"], **{k: v for k, v in obj.items() if k != "contract"}}


def print_json(obj):
    """One JSON value, encoded after the bus is closed (obj holds plain values by then)."""
    obj = with_contract(obj)
    later(lambda: print(json.dumps(jsonable(obj), **json_style(), default=repr, allow_nan=False)))


def emit(a, obj, template, *fields):
    """Exactly one JSON value under --json, else one human line authored by show()."""
    if a.json:
        print_json(obj)
    else:
        show(template, *fields)


# Listings stop at this many rows unless --limit says otherwise: a lane can add rows without
# bound, and every row is formatted (and every --json row encoded) for the reader, and an agent
# reads every byte. 20 for what an agent reads at the start of a turn (inbox, each section of
# status), 50 for every other listing; a cut listing names the command that continues it.
INBOX_LIMIT = 20
LISTING_LIMIT = 50
# What leave and release --all list and log of the claims they drop: a lane can plant any number.
RELEASED_SHOWN = 500
# A listing cuts a message body at this many bytes (body_truncated true); read --id N has all of it.
# A body over MAX_BODY bytes is refused when it is posted.
LIST_BODY_MAX = 2048
MAX_BODY = 64 * 1024


def capped(con, sql, params, limit):
    """(the first `limit` rows of sql, how many more it has). A negative limit means no limit, as
    SQLite's LIMIT does. Counted only when there are more."""
    params = list(params)
    if limit < 0:
        return con.execute(sql, params).fetchall(), 0
    n = min(limit, MAX_ID - 1)
    rows = con.execute(sql + " LIMIT ?", params + [n + 1]).fetchall()
    if len(rows) <= n:
        return rows, 0
    total = con.execute(f"SELECT COUNT(*) FROM ({sql})", params).fetchone()[0]
    return rows[:n], max(total - n, 1)


def envelope(items, more=0, cursor=None):
    """The JSON of a listing: the rows, whether rows were left out, and a cursor (null except for the four
    id walks, see make_cursor). print_json adds the contract version."""
    return {"items": items, "has_more": bool(more), "next": cursor}


CURSOR_PREFIX = "v1."


def cursor_command(a):
    return a.cmd if a.cmd in ("read", "inbox") else f"{a.cmd} {a.action}"


def cursor_filters(a):
    """What a cursor is bound to besides its command: the filters that choose the rows."""
    if a.cmd == "read":
        return {"topic": a.topic}
    if a.cmd == "ctx":
        return {"key": a.key}
    if a.cmd == "inbox":
        return {"as": ident(a)}
    return {}


def _filter_hash(filters):
    return hashlib.sha256(json.dumps(filters, sort_keys=True).encode("utf-8", "replace")).hexdigest()[:6]


# A cursor is `v1.<command code>.<filter hash>.<row id>`, for example v1.r.3fa9c1.4021: short enough that the
# `next:` line fits 80 columns. Callers treat it as opaque; the version prefix is what changes if the format does.
CURSOR_CODES = {"read": "r", "inbox": "i", "ctx history": "h", "log show": "l"}
CURSOR_RE = re.compile(r"v1\.([a-z])\.([0-9a-f]{6})\.([0-9]{1,19})")


def make_cursor(a, row_id):
    """An opaque cursor for the id walks (ctx history, read, log show: --before; inbox --peek:
    --after): the command, a hash of the filters it was made with, and the row id. Row ids are immutable and
    only grow, so a walk never skips or repeats a row. Callers must not parse it."""
    return make_cursor_text({"c": cursor_command(a), "f": _filter_hash(cursor_filters(a)), "id": row_id})


def make_cursor_text(body):
    return f"{CURSOR_PREFIX}{CURSOR_CODES[body['c']]}.{body['f']}.{body['id']}"


def read_cursor(a, text, flag):
    """The row id inside a cursor, refusing (bad_input) any that is not from this command with these filters."""
    def refuse(why):
        first = {"read": "agentbus --json read", "inbox": "agentbus --as NAME --json inbox --peek",
                 "ctx history": "agentbus --json ctx history KEY", "log show": "agentbus --json log show"}.get(cursor_command(a), "agentbus --json")
        die(f"{flag} needs the next value from a previous page of this same command and filters ({why}). "
            f"Get one with: {first}, and pass the next it prints", "bad_input", next=first)
    m = CURSOR_RE.fullmatch(text)
    if not m or int(m.group(3)) > MAX_ID or str(int(m.group(3))) != m.group(3):  # only a cursor this tool made, byte for byte
        refuse("not a cursor")
    if m.group(1) != CURSOR_CODES.get(cursor_command(a)):
        refuse("it came from another command")
    if m.group(2) != _filter_hash(cursor_filters(a)):
        refuse("it was made with other filters")
    return int(m.group(3))


def next_command(a, *words, as_=True):
    """The command line that continues a cut listing, to paste as it is: `agentbus [--as NAME] [--up N]` and
    words (a word that needs it is shell-quoted). as_=False leaves --as out, for a command that needs no name."""
    parts = ["agentbus"]
    if as_ and getattr(a, "as_", None):
        parts += ["--as", a.as_]
    if getattr(a, "up", 0):
        parts += ["--up", str(a.up)]
    return " ".join(shlex.quote(str(p)) for p in parts + list(words))


def page_size(a, default=LISTING_LIMIT):
    """The --limit a continuing command repeats: the one in use, or the default when it was 0 or all."""
    return a.limit if a.limit > 0 else default


def out(args, rows, fmt, more=0, empty=None, earlier=False, unread=False, cursor=None, next_cmd=None):
    """A listing with an empty state and a directional truncation hint. JSON is an envelope
    (envelope()). Rows are copied now and formatted only after the bus is closed. In text, a cut
    listing says how many rows it left out and, on the next line, the exact command that continues
    it (next_cmd)."""
    rows = [dict(r) for r in rows]
    if args.json:
        print_json(envelope(rows, more, cursor))
        return

    if more and earlier:
        show("... {} earlier", more, row=True)
        if next_cmd:
            show("next: {}", next_cmd, row=True)

    def render():
        formatter = table_formatter(rows, fmt) if fmt in (fmt_who, fmt_claim) else fmt
        for r in rows:
            print(formatter(clean_row(r)))
    later(render)
    if not rows and not more and empty:
        show("{}", empty, row=True)
    if more and not earlier:
        if unread:
            show("... {} more unread", more, row=True)
        else:
            show("... {} more", more, row=True)
        if next_cmd:
            show("next: {}", next_cmd, row=True)


def cut_body(row):
    """A message row for a listing (a copy): the body cut at LIST_BODY_MAX bytes, on a character boundary,
    and body_truncated true when it was. Nothing is added to a row that fits. read --id N has the whole body."""
    d = dict(row)
    body = d.get("body")
    if isinstance(body, str) and len(body) * 4 > LIST_BODY_MAX:
        raw = body.encode("utf-8", "replace")
        if len(raw) > LIST_BODY_MAX:
            d["body"] = raw[:LIST_BODY_MAX].decode("utf-8", "ignore")
            d["body_truncated"] = True
    return d


def read_body(parts, command, empty=None):
    """The body from the arguments, or from stdin when it is exactly `-`. Only `-` reads stdin: an
    agent passing an empty variable gets an empty-body error, never a command waiting on its stdin. Stdin
    is read as bytes; bytes that are not UTF-8 become U+FFFD."""
    body = " ".join(parts).strip()
    if body == "-":
        _test_pause("before-stdin-read")
        if sys.stdin is None:
            die(f'stdin is closed, so there is nothing to read for `-`. Pass the text instead: {command} "text"', "bad_input")
        body = sys.stdin.buffer.read().decode("utf-8", "replace").strip()
    if not body:
        die(empty or f'empty message. Use {command} "text", or pipe text to {command} -.', "bad_input")
    size = len(body.encode("utf-8", "replace"))
    if size > MAX_BODY:
        field = {"ctx": "value", "log": "detail", "goal": "text"}.get(command.split()[0], "body")
        die(f"the {field} is {size:,} bytes; the limit is {MAX_BODY // 1024} KB. "
            "Put the long text in a file in the repo and send its path.", "bad_input", field=field)
    return body


LIVE_WINDOW_MIN = 30


def free_name(con, name):
    """A name close to `name` that is not on the roster: alpha -> alpha-2, alpha-2 -> alpha-3."""
    base = re.sub(r"-[0-9]+$", "", name) or name
    for n in range(2, 10000):
        suffix = f"-{n}"
        cand = base[:40 - len(suffix)] + suffix
        if not con.execute("SELECT 1 FROM agents WHERE name=?", (cand,)).fetchone():
            return cand
    return None


def join_result(con, a, name, **extra):
    return {"joined": name, "bus": a._db, "goal": current_goal(con), "agentbus": __version__,
            "contract": CONTRACT["contract"], **extra}


def cmd_join(con, a):
    name = me(a)
    t = now()
    detail = {"tool": a.tool, "model": a.model, "branch": a.branch, "role": a.role}
    if a.request_id is not None:
        detail["request_id"] = a.request_id
    with immediate(con):
        if a.request_id is not None and con.execute("SELECT 1 FROM agents WHERE name=?", (name,)).fetchone():
            # A retry: this name's latest join carried this token. The first result stands, and the name
            # (still active from that join) is not refused as another session's.
            prev = con.execute("SELECT id, detail FROM log WHERE agent=? AND action='join' ORDER BY id DESC LIMIT 1",
                               (name,)).fetchone()
            try:
                old = json.loads(prev["detail"]) if prev else None
            except (TypeError, ValueError):
                old = None
            if isinstance(old, dict) and old.get("request_id") == a.request_id:
                if old != detail:
                    request_reused(a.request_id, name, prev["id"], f"join (log #{prev['id']})", "join", "flags")
                result = join_result(con, a, name, duplicate=True)
                g = result["goal"]
                emit(a, result, "joined as {} on {} (already joined)", name, a._db)
                if g and not a.json:
                    show("goal: {}", g["goal"])
                return
        # A name seen in the last LIVE_WINDOW_MIN minutes may belong to another live session; joining
        # under it would overwrite that session's roster entry and let this one act as it.
        row = con.execute("SELECT last_seen FROM agents WHERE name=?", (name,)).fetchone()
        if row and not a.takeover:
            try:
                seen = datetime.strptime(row[0], "%Y-%m-%dT%H:%M:%SZ").replace(tzinfo=timezone.utc)
                mins = (datetime.now(timezone.utc) - seen).total_seconds() / 60
            except (TypeError, ValueError):
                mins = LIVE_WINDOW_MIN  # not a time this tool wrote: counts as stale
            # A last_seen in the future is not a time this tool wrote either (a lane can set it):
            # stale, or the name would stay locked until then.
            if 0 <= mins < LIVE_WINDOW_MIN:
                age = "less than a minute" if mins < 1 else f"{int(mins)} min"
                free = free_name(con, name)
                try_name = f"Pick your own name (run: agentbus --as {shlex.quote(free)} join), or pass" if free else "Pick your own name, or pass"
                die(f"{name} was active {age} ago and may be another live session. "
                    f"{try_name} --takeover only if that session is you.", "name_active",
                    next=f"agentbus --as {shlex.quote(free)} join" if free else None, agent=name, last_seen_min=int(mins), suggested_name=free)
        # --takeover is the same session coming back: what it does not say again (tool, model, role) stays.
        keep = (lambda c: f"COALESCE(excluded.{c}, agents.{c})") if a.takeover else (lambda c: f"excluded.{c}")
        con.execute(
            f"""INSERT INTO agents(name,tool,model,cwd,branch,role,joined_at,last_seen)
               VALUES(?,?,?,?,?,?,?,?)
               ON CONFLICT(name) DO UPDATE SET tool={keep('tool')}, model={keep('model')}, cwd=excluded.cwd,
                 branch=excluded.branch, role={keep('role')}, last_seen=excluded.last_seen""",
            (name, a.tool, a.model, a.cwd or cwd_text(), a.branch, a.role, t, t))
        ensure_cursor(con, name)
        log(con, name, "join", json.dumps(detail))
    result = join_result(con, a, name)
    g = result["goal"]
    emit(a, result, "joined as {} on {}", name, tilde(a._db))
    if g and not a.json:
        show("goal: {}", g["goal"])


def cwd_text():
    """The working directory as text SQLite accepts: bytes that are not UTF-8 shown as U+FFFD."""
    return os.getcwd().encode("utf-8", "surrogateescape").decode("utf-8", "replace")


def ensure_cursor(con, name):
    """A new name's cursor: every message addressed to it since the bus began, broadcasts from now."""
    con.execute("INSERT OR IGNORE INTO cursors(agent,last_read_id,bcast_from) "
                "VALUES(?,0,(SELECT COALESCE(MAX(id),0) FROM messages))", (name,))


def release_all(con, name):
    """Delete every claim `name` holds, inside the caller's transaction. Returns (the first
    RELEASED_SHOWN resources, in order, each cut to RESOURCE_MAX characters, and how many there
    were): a lane can plant any number of claims of any length under a name, and they are listed,
    logged and printed only up to the cap.
    Ordered by the first RESOURCE_MAX + 1 characters (then rowid), the same order for every name
    within the cap: ORDER BY resource made SQLite walk the resource index, reading every planted
    name whole from the index and again from the table (1 GB for 500 names of 1 MB); this scans
    the table once and sorts only the short keys."""
    paths, more = capped(con, f"SELECT {cut('resource')} FROM claims WHERE agent=? "
                         f"ORDER BY substr(resource, 1, {RESOURCE_MAX + 1}), rowid", (name,), RELEASED_SHOWN)
    paths = [r[0] for r in paths]
    con.execute("DELETE FROM claims WHERE agent=?", (name,))
    return paths, len(paths) + more


def claims_text(paths, total):
    """The log detail for released claims: the count, then the first RELEASED_SHOWN of them."""
    if not total:
        return "(none)"
    return ", ".join(map(str, paths)) + (f", and {total - len(paths)} more" if total > len(paths) else "")


def show_released(a, paths, total):
    if not a.json:
        for p in paths:
            show("{}", p, row=True)
        if total > len(paths):
            show("... {} more", total - len(paths), row=True)


def cmd_leave(con, a):
    name = me(a)
    with immediate(con):
        paths, total = release_all(con, name)
        gone = con.execute("DELETE FROM agents WHERE name=?", (name,)).rowcount
        if total or gone:  # a second leave changes nothing and writes nothing
            log(con, name, "leave", f"released {plural(total, 'claim')}: {claims_text(paths, total)}")
    if not gone:
        note(f"{name} was not on the roster, so there was nothing to leave.")
    emit(a, {"left": name, "was_joined": bool(gone), "released": paths, "released_count": total},
         "left as {}, released {}", name, plural(total, "claim"))
    show_released(a, paths, total)


def q_who(con, limit=LISTING_LIMIT):
    return capped(con, "SELECT * FROM agents ORDER BY last_seen DESC", (), limit)


def fmt_who(r):
    return [r['name'], r['role'], r['tool'], r['model'], r['branch'],
            "seen just now" if ago(r['last_seen'], datetime.now(timezone.utc)) == "now"
            else f"seen {ago(r['last_seen'], datetime.now(timezone.utc))} ago"]


def table_formatter(rows, fmt):
    """Data-sized columns, without empty columns. Keep record identities whole; long identities
    still wrap safely. Other cells are capped to leave room for identity and relative time.
    Measure cleaned fields after the bus closes; the returned formatter takes a cleaned row."""
    if not rows:
        return lambda r: INDENT
    cells = [[str(v) for v in fmt(clean_row(r))] for r in rows]
    caps = [28, 24, 10, 20, 20, 18] if fmt is fmt_who else [40, 28, 32, 32]
    columns = [i for i in range(len(caps)) if any(r[i] for r in cells)]
    width = lambda s: sum(char_width(c) for c in s)
    sizes = {i: min(caps[i], max(width(r[i]) for r in cells)) for i in columns}
    # Retain the first column and the time; shrink descriptive columns first.
    time_col = 5 if fmt is fmt_who else 2
    budget = (wrap_width("out") or 10 ** 6) - len(INDENT) - 2 * (len(columns) - 1)
    flexible = [i for i in columns if i not in (0, time_col)]
    while sum(sizes.values()) > budget and any(sizes[i] > 4 for i in flexible):
        i = max(flexible, key=lambda i: sizes[i])
        sizes[i] -= 1

    def cell(s, n, whole=False):
        w = width(s)
        # Keep escaped values intact: clipping could hide the control that explains the value,
        # or leave half an escape. Unusually long lane text still uses the safe wrapping path.
        if w > n and not whole and '\\' not in s:
            kept, used = [], 0
            for c in s:
                if used + char_width(c) > n - 3:
                    break
                kept.append(c)
                used += char_width(c)
            s, w = ''.join(kept) + '...', used + 3
        return s + ' ' * max(0, n - w)
    def row(r):
        values = [str(v) for v in fmt(r)]
        return INDENT + col0('  '.join(cell(values[i], sizes[i], whole=(i == 0)) for i in columns).rstrip())
    return row


def cmd_who(con, a):
    rows, more = q_who(con, a.limit)
    out(a, rows, fmt_who, more, empty="no agents. Join with: agentbus --as NAME join",
        next_cmd=next_command(a, "who", "--limit", len(rows) + more))


def read_inputs(a):
    """Everything a command reads from its arguments or stdin, read before the bus is opened: stdin
    may be slow (a pipe, a FIFO, a terminal), and the bus is exclusively locked while open."""
    global _HAS_TOKEN
    _HAS_TOKEN = getattr(a, "request_id", None) is not None
    a._body = None
    a._before_id = a._after_id = None
    if getattr(a, "before", None) is not None:
        if a.cmd == "read" and a.since is not None:
            die("--before and --since cannot be combined: --since pages forward from an id, --before pages back. "
                "Use one: agentbus read --since ID, or agentbus read --before NEXT", "bad_input",
                next="agentbus read --since ID")
        a._before_id = read_cursor(a, a.before, "--before")
    if getattr(a, "after", None) is not None:
        if not a.peek:
            die("--after needs --peek: a consuming inbox continues by running inbox again. "
                "To page without reading: agentbus --as NAME inbox --peek --after NEXT", "bad_input",
                next="agentbus --as NAME inbox --peek --after NEXT")
        a._after_id = read_cursor(a, a.after, "--after")
    if a.cmd == "ctx" and a.key == "":
        die("KEY must not be empty. List facts with: agentbus ctx get", "bad_input", next="agentbus ctx get")
    if a.cmd == "ctx" and a.action == "set" and a.key == GOAL_KEY:
        die(f"{GOAL_KEY} is reserved; use: agentbus goal TEXT", "bad_input", next="agentbus goal TEXT", field="key")
    if a.cmd == "join" and not HOOK_NAME_RE.fullmatch(me(a)):
        refuse_invalid_name(me(a))
    if a.cmd == "post":
        me(a)
        if a.kind not in KINDS:
            die(f"unknown kind '{a.kind}'; use one of: {', '.join(KINDS)}", "bad_input")
        a._body = read_body(a.body, "post")
    elif a.cmd == "ctx" and a.action == "set":
        me(a)
        a._body = read_body(a.value, "ctx set KEY",
                            'ctx set KEY needs a value. Use: agentbus --as NAME ctx set KEY "VALUE", or pipe text to ctx set KEY -.')
    elif a.cmd == "log" and a.action == "add":
        me(a)
        a._body = read_body(a.detail, "log add ACTION",
                            'log add ACTION needs a detail. Use: agentbus --as NAME log add ACTION "DETAIL", or pipe text to log add ACTION -.')
    elif a.cmd == "goal" and a.text:
        me(a)
        a._body = read_body(a.text, "goal", 'the goal is empty. Use: agentbus --as NAME goal "TEXT", or pipe text to goal -.')


def cmd_post(con, a):
    name = me(a)
    body = a._body
    with immediate(con):
        require_joined(con, name)
        if a.request_id is not None:
            old = con.execute("SELECT id, body, recipient, kind, topic, reply_to FROM messages "
                              "WHERE sender=? AND request_id=?", (name, a.request_id)).fetchone()
            if old:
                if tuple(old)[1:] != (body, a.to, a.kind, a.topic, a.reply_to):
                    request_reused(a.request_id, name, old['id'], f"#{old['id']}", "message", "body")
                warnings = roster_warnings(con, a.to)
                for w in warnings:
                    note(warn_text(w))
                emit(a, {"id": old['id'], "duplicate": True, "warnings": warnings},
                     "posted #{} to {} [{}] (already posted)", old['id'], "everyone" if a.to == "*" else a.to, a.kind)
                return
        if a.reply_to is not None and not con.execute("SELECT 1 FROM messages WHERE id=?", (a.reply_to,)).fetchone():
            die(f"no message #{a.reply_to} to reply to. See recent ids with: agentbus read", "no_message", next="agentbus read", id=a.reply_to)
        cur = con.execute(
            "INSERT INTO messages(ts,sender,recipient,kind,topic,body,reply_to,request_id) VALUES(?,?,?,?,?,?,?,?)",
            (now(), name, a.to, a.kind, a.topic, body, a.reply_to, a.request_id))
        warnings = roster_warnings(con, a.to)
    for w in warnings:
        note(warn_text(w))
    emit(a, {"id": cur.lastrowid, "warnings": warnings}, "posted #{} to {} [{}]", cur.lastrowid,
         "everyone" if a.to == "*" else a.to, a.kind)


def fmt_msg(r):
    """A message header (marked HEAD: agentbus wrote `#<id> `, and the id is the integer rowid),
    then the body, every line indented."""
    mid = r["id"]
    head = (HEAD + "#%d" % mid if isinstance(mid, int) and not isinstance(mid, bool) else f"{INDENT}#{mid}")
    head += f" {r['sender']} -> {'everyone' if r['recipient'] == '*' else r['recipient']} [{r['kind']}]"
    if r.get("topic"):
        head += f" ({r['topic']})"
    if r.get("reply_to"):
        head += f" re #{r['reply_to']}"
    head += f" · {human_time(r['ts'])}"  # a hostile or malformed stored time shows as it is (already cleaned)
    text = f"{head}\n{INDENT}" + str(r["body"]).replace("\n", "\n" + INDENT)
    if r.get("body_truncated") is True:
        text += f"\n{INDENT}... cut at 2 KB. Full text: agentbus read --id {r['id']}"
    return text


def cmd_inbox(con, a):
    name = me(a)
    row = con.execute("SELECT last_read_id, bcast_from FROM cursors WHERE agent=?", (name,)).fetchone()
    if row:
        last, bcast = row
    else:
        # No cursor yet: the same start a first join would give. --peek leaves it uncreated.
        last, bcast = 0, con.execute("SELECT COALESCE(MAX(id),0) FROM messages").fetchone()[0]
    if a._after_id is not None:  # inbox --peek --after: the walk continues past the last page's last id
        last = max(last, a._after_id)
    # The oldest `limit` unread. The cursor moves only after the output was written (run() calls
    # a._after once write_out succeeded), and only past what was shown: the rest stay unread.
    rows, more = capped(
        con, f"SELECT {MESSAGE_COLUMNS} FROM messages WHERE id>? AND sender<>? AND (recipient=? OR (recipient='*' AND id>?)) ORDER BY id",
        (last, name, name, bcast), a.limit)
    nxt = make_cursor(a, rows[-1]["id"] if rows else last) if more and a.peek else None
    rows = [cut_body(r) for r in rows]
    page = ("--limit", page_size(a, INBOX_LIMIT))
    # Consuming, the rows shown are marked read, so the same command continues; peeking leaves them unread, so the cursor does.
    out(a, rows, fmt_msg, more, unread=True, cursor=nxt,
        next_cmd=next_command(a, "inbox", "--peek", "--after", nxt, *page) if nxt else next_command(a, "inbox", *page))
    if not a.peek and (rows or not row):
        upto = rows[-1]["id"] if rows else None
        a._after = lambda c: mark_read(c, name, bcast, upto)
    if not rows and not more and not a.json:
        show("inbox empty")


def mark_read(con, name, bcast, upto):
    """inbox's second step, in its own short transaction once the output is written: the cursor a
    first inbox creates (broadcasts from the newest id the read saw), then last_read_id moved up to
    the last id shown, never down (MAX), so an overlapping inbox under the same name that showed
    less cannot move it back."""
    with immediate(con):
        con.execute("INSERT OR IGNORE INTO cursors(agent,last_read_id,bcast_from) VALUES(?,0,?)", (name, bcast))
        if upto is not None:
            con.execute("UPDATE cursors SET last_read_id=MAX(last_read_id, ?) WHERE agent=?", (upto, name))


def q_read_page(con, since, topic, limit, before=None):
    q, p = f"SELECT {MESSAGE_COLUMNS} FROM messages WHERE id>?", [since or 0]
    if before is not None:
        q += " AND id<?"
        p.append(before)
    if topic:
        q += " AND topic=?"
        p.append(topic)
    if since is not None:
        return capped(con, q + " ORDER BY id ASC", p, limit)
    rows, more = capped(con, q + " ORDER BY id DESC", p, limit)
    return list(reversed(rows)), more


def cmd_read(con, a):
    if a.id is not None:
        if a.since is not None or a.before is not None or a.topic:
            die("--id shows one message; it cannot be combined with --since, --before or --topic", "bad_input")
        r = con.execute(f"SELECT {MESSAGE_COLUMNS} FROM messages WHERE id=?", (a.id,)).fetchone()
        if not r:
            die(f"no message #{a.id}. See recent ids with: agentbus read", "no_message", next="agentbus read", id=a.id)
        if a.json:
            print_json(dict(r))
        else:
            out(a, [r], fmt_msg)
        return
    rows, more = q_read_page(con, a.since, a.topic, a.limit, a._before_id)
    # Walking back (no --since): the cursor is the oldest id shown. With --since, has_more means more
    # after it and the caller continues with --since LAST_ID, so there is no cursor.
    nxt = make_cursor(a, rows[0]["id"] if rows else MAX_ID if a._before_id is None else a._before_id) if more and a.since is None else None
    rows = [cut_body(r) for r in rows]
    topic = ["--topic", a.topic] if a.topic else []
    page = ("--limit", page_size(a))
    if a.since is None:
        cont = next_command(a, "read", *topic, "--before", nxt, *page) if nxt else None
    else:
        cont = next_command(a, "read", "--since", rows[-1]["id"], *topic, *page) if rows else None
    out(a, rows, fmt_msg, more, empty="no messages", earlier=a.since is None, cursor=nxt, next_cmd=cont)


def glimpse(text, n=60):
    """A value on one line for a short message: whitespace collapsed, cut to n characters."""
    one = " ".join(str(text).split())
    return one if len(one) <= n else one[:n - 3] + "..."


def q_ctx(con, limit=LISTING_LIMIT):
    # The goal is a fact under a reserved key; goal and status show it on their own.
    return capped(con, "SELECT * FROM context WHERE key<>? ORDER BY key", (GOAL_KEY,), limit)


def fmt_ctx(r):
    return INDENT + col0(f"{r['key']} = {r['value']}   ({r['updated_by']}, {human_time(r['updated_at'])})")


def cmd_ctx(con, a):
    if a.action == "set":
        name = me(a)
        value = a._body
        t = now()
        with immediate(con):
            require_joined(con, name)
            cur = con.execute("SELECT value, updated_by, updated_at FROM context WHERE key=?", (a.key,)).fetchone()
            unchanged = bool(cur) and cur["value"] == value  # the same value again writes nothing
            if unchanged:
                name, t = cur["updated_by"], cur["updated_at"]
            else:
                con.execute(
                    "INSERT INTO context(key,value,updated_by,updated_at) VALUES(?,?,?,?) "
                    "ON CONFLICT(key) DO UPDATE SET value=excluded.value, updated_by=excluded.updated_by, updated_at=excluded.updated_at",
                    (a.key, value, name, t))
                con.execute("INSERT INTO context_history(key,value,updated_by,updated_at) VALUES(?,?,?,?)", (a.key, value, name, t))
        result = {"key": a.key, "value": value, "updated_by": name, "updated_at": t, "unchanged": unchanged}
        if unchanged:
            emit(a, result, "set {} (unchanged)", a.key)
        elif cur:
            emit(a, result, "set {}: {} -> {}", a.key, glimpse(cur["value"]), glimpse(value))
        else:
            emit(a, result, "set {}", a.key)
    elif a.action == "get":
        if a.key is not None:
            r = con.execute("SELECT * FROM context WHERE key=?", (a.key,)).fetchone()
            if not r:
                die(f"no fact named {a.key}. List facts with: agentbus ctx get", "no_context_key", next="agentbus ctx get", key=a.key)
            if a.json:
                print_json(dict(r))
            else:
                show("{}", r["value"], row=True)
        else:
            rows, more = q_ctx(con, a.limit)
            out(a, rows, fmt_ctx, more, empty="no facts", next_cmd=next_command(a, "ctx", "get", "--limit", len(rows) + more))
    elif a.action == "history":
        # The newest `limit` values, oldest first; --before continues back from a previous page.
        before = MAX_ID if a._before_id is None else a._before_id
        rows, more = capped(con, "SELECT * FROM context_history WHERE key=? AND id<? ORDER BY id DESC", (a.key, before), a.limit)
        rows = list(reversed(rows))
        nxt = make_cursor(a, rows[0]["id"] if rows else before) if more else None
        out(a, rows, lambda r: INDENT + col0(f"{human_time(r['updated_at'])} {r['updated_by']}: {r['value']}"), more, cursor=nxt,
            next_cmd=next_command(a, "ctx", "history", a.key, "--before", nxt, "--limit", page_size(a)) if nxt else None)


# The shared goal: one fact every agent sees first, kept under the context key "goal" so it has the
# same history as any fact (ctx history goal). join and status show it; watch pins it at the top.
GOAL_KEY = "goal"


def current_goal(con):
    r = con.execute("SELECT value, updated_by, updated_at FROM context WHERE key=?", (GOAL_KEY,)).fetchone()
    return {"goal": r["value"], "set_by": r["updated_by"], "set_at": r["updated_at"]} if r else None


def cmd_goal(con, a):
    if a._body is not None:
        name, t = me(a), now()
        with immediate(con):
            require_joined(con, name)
            cur = current_goal(con)
            unchanged = bool(cur) and cur["goal"] == a._body  # the same goal again writes nothing
            if unchanged:
                name, t = cur["set_by"], cur["set_at"]
            else:
                con.execute(
                    "INSERT INTO context(key,value,updated_by,updated_at) VALUES(?,?,?,?) "
                    "ON CONFLICT(key) DO UPDATE SET value=excluded.value, updated_by=excluded.updated_by, updated_at=excluded.updated_at",
                    (GOAL_KEY, a._body, name, t))
                con.execute("INSERT INTO context_history(key,value,updated_by,updated_at) VALUES(?,?,?,?)", (GOAL_KEY, a._body, name, t))
                log(con, name, "goal", a._body)
        emit(a, {"goal": a._body, "set_by": name, "set_at": t, "unchanged": unchanged}, "goal: {}", a._body)
        return
    g = current_goal(con)
    if a.json:
        print_json(g or {"goal": None, "set_by": None, "set_at": None})
    elif g:
        show("goal: {}", g["goal"])
        show("set by {} at {}", g["set_by"], human_time(g["set_at"]), row=True)
    else:
        show("no goal yet. Set one with: agentbus --as NAME goal \"what we are shipping\"")


def cmd_claim(con, a):
    name = me(a)
    if a.ttl_min < 1 or a.ttl_min > MAX_TTL_MIN:
        die(f"--ttl-min must be at least 1 and at most {MAX_TTL_MIN} (a week). For example: agentbus --as NAME claim PATH --ttl-min 120", "bad_input",
            next="agentbus --as NAME claim PATH --ttl-min 120")
    res = norm_resource(a.resource)
    exp = datetime.fromtimestamp(time.time() + a.ttl_min * 60, timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")
    released, n_released = [], 0
    with immediate(con):
        require_joined(con, name)
        t = now()
        live = "typeof(resource)='text' AND agent<>? AND expires_at>?"
        on_roster = "EXISTS (SELECT 1 FROM agents WHERE agents.name=claims.agent)"
        filters = overlap_filters(res)
        for where, params in filters:
            r = con.execute(f"SELECT resource={_is_text('?')} AS same, {cut('resource')} AS resource, {cut('agent')} AS agent, "
                            f"{cut('expires_at')} AS expires_at, {cut('purpose')} AS purpose FROM claims "
                            f"WHERE ({where}) AND {live} AND {on_roster} LIMIT 1", [res] + params + [name, t]).fetchone()
            if r:
                why = f'purpose: "{r["purpose"]}"' if r["purpose"] else "no purpose given"
                ask = f"agentbus --as {shlex.quote(name)} post QUESTION --to {shlex.quote(r['agent'])} --kind question"
                next_step = f" Do not edit it yet. Ask {r['agent']}: {ask}, or choose another resource."
                if not r["same"]:
                    die(f"{res} overlaps {r['resource']}, claimed by {r['agent']} until {human_time(r['expires_at'])} ({why})." + next_step,
                        "claim_conflict", next=ask, resource=res, holder=r['agent'], expires_at=r['expires_at'], purpose=r['purpose'])
                die(f"{res} is claimed by {r['agent']} until {human_time(r['expires_at'])} ({why})." + next_step,
                    "claim_conflict", next=ask, resource=res, holder=r['agent'], expires_at=r['expires_at'], purpose=r['purpose'])
        odd = undecoded_overlaps(con, res, name, t)
        for raw, r in odd:
            if con.execute("SELECT 1 FROM agents WHERE name=(SELECT agent FROM claims WHERE resource=CAST(? AS TEXT))",
                           (raw,)).fetchone():
                ask = f"agentbus --as {shlex.quote(name)} post QUESTION --to {shlex.quote(r['agent'])} --kind question"
                die(f"{res} overlaps {r['resource']}, claimed by {r['agent']} until {human_time(r['expires_at'])} "
                    f"({'purpose: ' + chr(34) + r['purpose'] + chr(34) if r['purpose'] else 'no purpose given'}). Do not edit it yet. "
                    f"Ask {r['agent']}: {ask}, or choose another resource.",
                    "claim_conflict", next=ask, resource=res, holder=r['agent'], expires_at=r['expires_at'], purpose=r['purpose'])
        for raw, r in odd:
            if len(released) < AUTO_RELEASE_SHOWN:
                released.append({"resource": r["resource"], "agent": r["agent"]})
            n_released += con.execute("DELETE FROM claims WHERE resource=CAST(? AS TEXT)", (raw,)).rowcount
        # Every overlapping claim left is held by a name not on the roster (it left or was cleared):
        # release them and take it. Each DELETE is one statement under the query budget; only the
        # first AUTO_RELEASE_SHOWN are listed and logged one by one, the rest as a count.
        for where, params in filters:
            stale = f"({where}) AND {live} AND NOT {on_roster}"
            room = AUTO_RELEASE_SHOWN - len(released)
            if room > 0:
                for r in con.execute(f"SELECT {cut('resource')} AS resource, {cut('agent')} AS agent FROM claims "
                                     f"WHERE {stale} ORDER BY resource LIMIT ?", params + [name, t, room]):
                    released.append({"resource": r["resource"], "agent": r["agent"]})
            n_released += con.execute(f"DELETE FROM claims WHERE {stale}", params + [name, t]).rowcount
        for r in released:
            log(con, name, "claim", f"{r['resource']} auto-released from {r['agent']} (not on roster)")
        if n_released > len(released):
            log(con, name, "claim", f"and {n_released - len(released)} more overlapping {res} auto-released (not on roster)")
        forms = same_path_forms(res)
        own = con.execute(
            f"SELECT purpose, claimed_at, expires_at FROM claims WHERE agent=? AND resource IN ({','.join('?' * len(forms))}) "
            "ORDER BY claimed_at LIMIT 1", [name] + forms).fetchone()
        purpose = own["purpose"] if own and a.purpose is None else a.purpose
        claimed_at = own["claimed_at"] if own else t
        # Renewed: this agent still held it (an expired claim is taken again, not renewed). The purpose may change with it.
        renewed = bool(own) and isinstance(own["expires_at"], str) and own["expires_at"] > t
        purpose_changed = renewed and a.purpose is not None and own["purpose"] != a.purpose
        own_purpose = own["purpose"] if own else None
        con.execute(f"DELETE FROM claims WHERE agent=? AND resource IN ({','.join('?' * len(forms))})", [name] + forms)
        con.execute(
            "INSERT INTO claims(resource,agent,purpose,claimed_at,expires_at) VALUES(?,?,?,?,?) "
            "ON CONFLICT(resource) DO UPDATE SET agent=excluded.agent, purpose=excluded.purpose, "
            "claimed_at=excluded.claimed_at, expires_at=excluded.expires_at",
            (res, name, purpose, claimed_at, exp))
        if not own or own["purpose"] != purpose:  # a renewal that changes nothing is not news
            log(con, name, "claim", f"{res} until {exp}" + (f": {purpose}" if purpose else ""))
    result = {"resource": res, "agent": name, "purpose": purpose, "claimed_at": claimed_at,
              "expires_at": exp, "auto_released": released, "auto_released_count": n_released, "renewed": renewed}
    if purpose_changed:
        result["previous_purpose"] = own_purpose
    if a.json or not purpose_changed:
        if renewed:
            emit(a, result, "renewed {} {}", res, until_phrase(a.ttl_min * 60, exp))
        else:
            emit(a, result, "claimed {} {}", res, until_phrase(a.ttl_min * 60, exp))
    else:
        was = f'was "{own_purpose}", now "{purpose}"' if own_purpose else f'now "{purpose}"'
        show("renewed {} {}; purpose {}", res, until_phrase(a.ttl_min * 60, exp), was)


def cmd_release(con, a):
    name = me(a)
    if a.all:
        with immediate(con):
            paths, total = release_all(con, name)
            if total:  # releasing nothing writes nothing
                log(con, name, "release", f"all {plural(total, 'claim')}: {claims_text(paths, total)}")
        emit(a, {"released": paths, "released_count": total}, "released {}", plural(total, "claim"))
        show_released(a, paths, total)
        return
    res = norm_resource(a.resource)
    forms = sorted(set(same_path_forms(res) + [a.resource]))
    with immediate(con):
        paths = [r[0] for r in con.execute(
            f"SELECT resource FROM claims WHERE agent=? AND resource IN ({','.join('?' * len(forms))})", [name] + forms)]
        if not paths and a.if_held:  # cleanup: not holding it is the state asked for
            emit(a, {"released": [], "released_count": 0}, "released {}", plural(0, "claim"))
            return
        if not paths:
            die(f"you do not hold {a.resource}. See your claims with: agentbus claims", "not_held", next="agentbus claims", resource=a.resource)
        con.execute(f"DELETE FROM claims WHERE agent=? AND resource IN ({','.join('?' * len(forms))})", [name] + forms)
        log(con, name, "release", ", ".join(map(str, paths)))
    emit(a, {"released": paths, "released_count": len(paths)}, "released {}", ", ".join(map(str, paths)))


def q_claims(con, stale=False, limit=LISTING_LIMIT):
    if stale:
        # Unexpired claims held by agents not on the roster
        q = """SELECT c.*, CASE WHEN c.expires_at < ? THEN 'expired' ELSE 'held' END AS state
               FROM claims c LEFT JOIN agents ag ON c.agent = ag.name
               WHERE ag.name IS NULL AND c.expires_at > ?
               ORDER BY c.resource"""
        return capped(con, q, (now(), now()), limit)
    q = """SELECT *, CASE WHEN expires_at < ? THEN 'expired' ELSE 'held' END AS state
           FROM claims ORDER BY resource"""
    return capped(con, q, (now(),), limit)


def fmt_claim(r):
    t_now = datetime.now(timezone.utc)
    t = _when(r['expires_at'])
    if r['state'] == 'expired':
        remaining = "expired"
    elif t is None:
        remaining = str(r['expires_at'])  # not a time this tool wrote: shown as it is (already cleaned)
    else:  # rounded up to the minute, so a claim made a second ago still says 2h
        remaining = until_phrase(max(0, int(-((t_now - t).total_seconds() // 60))) * 60, r['expires_at'], t_now)
    return [r['resource'], r['agent'], remaining, r['purpose']]


def cmd_claims(con, a):
    rows, more = q_claims(con, getattr(a, "stale", False), a.limit)
    stale = ["--stale"] if getattr(a, "stale", False) else []
    out(a, rows, fmt_claim, more, empty="no claims", next_cmd=next_command(a, "claims", *stale, "--limit", len(rows) + more))


def log_detail(action, detail):
    """A log entry's detail as a person reads it. join stores its fields as JSON: shown as tool=claude branch=main with the
    empty ones left out; a claim entry from before the purpose was optional ends in a bare ': '; `1 claims` reads `1 claim`.
    The stored text is unchanged."""
    text = "" if detail is None else str(detail)
    if action == "join":
        try:
            fields = json.loads(text)
        except ValueError:
            fields = None
        if isinstance(fields, dict):
            return " ".join(f"{k}={v}" for k, v in fields.items() if v not in (None, "")) or "(no details)"
    text = text.rstrip()
    if text.endswith(":"):
        text = text[:-1].rstrip()
    return re.sub(r"(?<![\d.])1 claims\b", "1 claim", text)


def cmd_log(con, a):
    if a.action == "add":
        name = me(a)
        detail = a._body
        with immediate(con):
            require_joined(con, name)
            row_id = log(con, name, a.what, detail)
        emit(a, {"id": row_id, "logged": True, "agent": name, "action": a.what, "detail": detail}, "logged")
    else:
        before = MAX_ID if a._before_id is None else a._before_id
        rows, more = capped(con, "SELECT * FROM log WHERE id<? ORDER BY id DESC", (before,), a.limit)
        rows = list(reversed(rows))
        nxt = make_cursor(a, rows[0]["id"] if rows else before) if more else None
        out(a, rows, lambda r: INDENT + col0(f"{human_time(r['ts']):<12} {r['agent']:<22} {r['action']:<10} {log_detail(r['action'], r['detail'])}".rstrip()),
            more, empty="log is empty", earlier=True, cursor=nxt,
            next_cmd=next_command(a, "log", "show", "--before", nxt, "--limit", page_size(a)) if nxt else None)


FACT_LINE = 80  # status shows a fact's first line, cut at this many characters; ctx get KEY has the whole value


def one_line(value, width=FACT_LINE):
    """A fact value for a text summary: its first line, cut at `width` characters, with ... when anything was left out."""
    if not isinstance(value, str):
        return value
    first = value.split("\n", 1)[0]
    return first[:width].rstrip() + "..." if first != value or len(first) > width else value


def cmd_status(con, a):
    (agents, m1), (ctx, m2), (claims, m3) = q_who(con, a.limit), q_ctx(con, a.limit), q_claims(con, limit=a.limit)
    msgs, m4 = q_read_page(con, None, None, a.limit)
    msgs = [cut_body(r) for r in msgs]
    g = current_goal(con)
    if a.json:
        print_json({"bus": a._db, "goal": g, "agents": [dict(r) for r in agents], "context": [dict(r) for r in ctx],
                    "claims": [dict(r) for r in claims], "messages": msgs,
                    "omitted": {"agents": m1, "context": m2, "claims": m3, "messages": m4}})
        return
    show("== bus {}", tilde(a._db))
    if g:
        show("== goal: {}", g["goal"])
    else:
        show("== no goal yet (agentbus --as NAME goal \"...\")")
    later(print)
    show("== agents")
    out(a, agents, fmt_who, m1, empty="no agents. Join with: agentbus --as NAME join",
        next_cmd=next_command(a, "who", "--limit", len(agents) + m1))
    ctx = [dict(r, value=one_line(r["value"])) for r in ctx]
    older = next_command(a, "read", "--before", make_cursor_text({"c": "read", "f": _filter_hash({"topic": None}), "id": msgs[0]["id"]}),
                         "--limit", page_size(a, INBOX_LIMIT)) if m4 and msgs else None
    for title, rows, fmt, more, empty, nxt in (
            ("facts", ctx, fmt_ctx, m2, "no facts", next_command(a, "ctx", "get", "--limit", len(ctx) + m2)),
            ("claims", claims, fmt_claim, m3, "no claims", next_command(a, "claims", "--limit", len(claims) + m3)),
            ("recent messages", msgs, fmt_msg, m4, "no messages", older)):
        later(print)  # a blank line between sections
        show("== {}", title)
        out(a, rows, fmt, more, empty=empty, earlier=(title == "recent messages"), next_cmd=nxt)


def _refs(schema, found):
    """Every object name a result schema points to with $ref."""
    if isinstance(schema, dict):
        if "$ref" in schema:
            found.add(schema["$ref"].rsplit("/", 1)[-1])
        for v in schema.values():
            _refs(v, found)
    elif isinstance(schema, list):
        for v in schema:
            _refs(v, found)
    return found


def schema_index(commands, parser):
    """schema --index: for each command its argument names and the error codes of its own (the bus errors
    every command that opens a bus can raise are listed once, as common_errors)."""
    return {"contract": CONTRACT["contract"], "agentbus": __version__,
            "commands": {k: {"args": [x["name"] for x in v["args"]], "errors": [e for e in v["errors"] if e not in _BUS_ERRORS]}
                         for k, v in commands.items()},
            "global_args": [x["name"] for x in global_args(parser)], "common_errors": list(_BUS_ERRORS)}


def global_args(parser):
    return [_arg_entry(x, {}) for x in parser._actions if x.dest in GLOBAL_DESTS]


def cmd_schema(a):
    """The machine contract: every command's arguments, result shape, errors and retry rule, plus the
    shared objects, error codes, exit codes and environment (CONTRACT, with arguments read from the
    parser). With COMMAND only that command's entry and the objects and errors it uses; with --index a
    short list of every command's arguments and own errors. Needs no bus."""
    parser = build_parser()
    commands = contract_commands(parser)
    want = " ".join(a.command)
    if a.index and want:
        die("--index lists every command; it cannot be combined with COMMAND", "bad_input")
    if want:
        commands = {k: v for k, v in commands.items() if k == want or k.startswith(want + " ")}
        if not commands:
            die(f"unknown command '{want}'. List them with: agentbus schema --index", "bad_input", next="agentbus schema --index")
    if a.index:
        index = schema_index(commands, parser)
        if a.json:
            print_json(index)
            return
        show("contract {}: command, arguments, errors of its own", CONTRACT["contract"])
        for name, entry in index["commands"].items():
            show("{}", "  ".join(filter(None, [name, " ".join(entry["args"]),
                                                     "errors: " + " ".join(entry["errors"]) if entry["errors"] else ""])), row=True)
        show("every command that opens a bus can also fail with: {}", " ".join(index["common_errors"]))
        show("details: agentbus schema COMMAND --json")
        return
    if a.json:
        doc = {"contract": CONTRACT["contract"], "agentbus": __version__, "commands": commands}
        objects, errors, warnings = CONTRACT["objects"], CONTRACT["errors"], CONTRACT["warnings"]
        full = a.full or not want
        if want:  # only what this command uses: its result objects, the error codes of its own and the warnings it can give
            names = set()
            for v in commands.values():
                _refs(v["result"], names)
            codes = set(e for v in commands.values() for e in v["errors"])
            own = {e for e in codes if e not in _BUS_ERRORS}
            objects = {k: v for k, v in objects.items() if k in names}
            errors = {k: v for k, v in errors.items() if k in (codes if full else own)}
            warnings = {k: v for k, v in warnings.items() if set(v["commands"]) & {c.split()[0] for c in commands}}
            if not full:
                doc["common_errors"] = sorted(codes - own, key=list(CONTRACT["errors"]).index)
        if full:
            doc["global_args"] = global_args(parser)
        doc.update(objects=objects, error_fields=CONTRACT["error_fields"], errors=errors, warnings=warnings)
        if full:
            doc.update(exit_codes=CONTRACT["exit_codes"], env=CONTRACT["env"])
        if want and not full:
            doc["more"] = f"agentbus --json schema {want} --full: the global arguments, environment, exit codes and the common errors' definitions"
        print_json(doc)
        return
    rows = [(k, result_text(CONTRACT["commands"][k]["result"], brief=True), CONTRACT["commands"][k]["retry"]["short"]) for k in commands]
    show("contract {}: command, JSON result, retry rule", CONTRACT["contract"])
    for name, res, retry in rows:
        show("{}  {}  retry: {}", name, res, retry, row=True)
    show("details: agentbus schema COMMAND --json")


def integer(text):
    """An argparse type: an integer SQLite can store (64-bit signed), never one that would make a
    query fail with OverflowError. Checked by length first: Python 3.11+ refuses to parse very long
    digit strings at all."""
    m = re.fullmatch(r"\s*([+-]?)0*(\d+)\s*", text)
    if not m:
        raise argparse.ArgumentTypeError(f"not an integer: {text!r}")
    v = int(m.group(1) + m.group(2)) if len(m.group(2)) <= 19 else None
    if v is None or not -(2 ** 63) <= v <= 2 ** 63 - 1:
        raise argparse.ArgumentTypeError("must be between -2**63 and 2**63-1")
    return v


def bus_level(text):
    v = integer(text)
    if v < 0:
        raise argparse.ArgumentTypeError("must be at least 0")
    return v


def interval(text):
    """An argparse type: seconds between watch refreshes, 0.2 to 60."""
    try:
        v = float(text)
    except ValueError:
        raise argparse.ArgumentTypeError(f"not a number: {text!r}")
    if not 0.2 <= v <= 60:
        raise argparse.ArgumentTypeError("must be between 0.2 and 60 seconds")
    return v


