                        "meaning": "The name was active recently and may be another live session.",
                        "action": "Pick another name, or join --takeover if it is you."},
        "request_id_reused": {"exit": 1, "retryable": False, "fields": ["request_id", "agent"],
                              "meaning": "That request id was used with a different message.",
                              "action": "Use a new token for a different message."},
        "bad_input": {"exit": 2, "retryable": False, "fields": [],
                      "meaning": "The arguments are not valid (a usage error).", "action": "Fix the arguments."},
        "no_bus": {"exit": 3, "retryable": False, "fields": [],
