                       "meaning": "There is no message with that id.", "action": "Check the id with read."},
        "no_context_key": {"exit": 1, "retryable": False, "fields": ["key"],
                           "meaning": "There is no fact with that key.", "action": "List keys with ctx get."},
        "not_on_roster": {"exit": 1, "retryable": False, "fields": ["agent"],
                          "meaning": "That name has not joined.", "action": "Join first."},
        "name_active": {"exit": 1, "retryable": False, "fields": ["agent", "last_seen_min"],
