    limit_arg(sub("who", help="List agents"), what="agents")


def register_post(sub):
    po = sub("post", help="Send a message (body '-' reads stdin)")
    po.add_argument("body", nargs="*", help="The message. Several words are joined; - reads it from stdin.")
    po.add_argument("--to", default="*", metavar="NAME", action=OneName,
                    help="Deliver to this one agent name; omitted means broadcast. A name not on the roster still gets the message, with a warning.")
    po.add_argument("--kind", default="note",
                    help="Message kind: note, question, answer, handoff, decision, alert, done. Default: note.")
    po.add_argument("--topic", help="Optional topic label, filterable with read --topic.")
    po.add_argument("--reply-to", type=integer, metavar="ID",
                    help="Link to an earlier message; does not choose the recipient.")

    po.add_argument("--request-id", metavar="TOKEN", help="Retry safely with the same sender and token; a changed payload is refused.")


